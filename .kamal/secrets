# Kamal resolves secrets here at deploy time by fetching them from Bitwarden via the
# `bw` CLI. Nothing secret is stored in this file or in git. Before deploying, export
# BW_ACCOUNT (your Bitwarden login email) and have `bw` logged in; Kamal unlocks the
# vault (prompting for your master password) as needed. Setup + the vault item layout
# are documented in docs/deployment.md.
#
# Secrets live as hidden custom fields on a single Bitwarden item named "prisma-engine-prod".
# RAILS_MASTER_KEY's value is the contents of config/credentials/production.key
# (production uses env-scoped credentials, not config/master.key).

SECRETS=$(kamal secrets fetch --adapter bitwarden --account "$BW_ACCOUNT" --from prisma-engine-prod \
  KAMAL_REGISTRY_PASSWORD \
  RAILS_MASTER_KEY \
  PRISMA_ENGINE_DATABASE_PASSWORD \
  R2_ACCESS_KEY_ID \
  R2_SECRET_ACCESS_KEY)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD "$SECRETS")
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY "$SECRETS")
PRISMA_ENGINE_DATABASE_PASSWORD=$(kamal secrets extract PRISMA_ENGINE_DATABASE_PASSWORD "$SECRETS")
DATABASE_PASSWORD=$PRISMA_ENGINE_DATABASE_PASSWORD
R2_ACCESS_KEY_ID=$(kamal secrets extract R2_ACCESS_KEY_ID "$SECRETS")
R2_SECRET_ACCESS_KEY=$(kamal secrets extract R2_SECRET_ACCESS_KEY "$SECRETS")

