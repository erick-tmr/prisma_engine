# Secrets are fetched from Bitwarden at deploy time via the bw CLI. No secret values are
# stored in this file or in git. Export BW_ACCOUNT (your Bitwarden email) and keep bw
# logged in before deploying. See docs/deployment.md for the vault item layout.
# RAILS_MASTER_KEY is the contents of config/credentials/production.key.

SECRETS=$(kamal secrets fetch --adapter bitwarden --account $BW_ACCOUNT --from prisma-engine-prod KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY PRISMA_ENGINE_DATABASE_PASSWORD CF_ORIGIN_CERT_B64 CF_ORIGIN_KEY_B64)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $SECRETS)
PRISMA_ENGINE_DATABASE_PASSWORD=$(kamal secrets extract PRISMA_ENGINE_DATABASE_PASSWORD $SECRETS)
DATABASE_PASSWORD=$PRISMA_ENGINE_DATABASE_PASSWORD

# Cloudflare Origin CA cert + key served by kamal-proxy (config/deploy.yml proxy.ssl).
# Stored base64 in Bitwarden (single-line, so Dotenv parsing is safe). The extract and the
# base64 decode must be separate substitutions: Kamal inlines any $(kamal secrets ...) call
# and shellsplits it, so a `| base64 -d` in the same command would not be piped.
CF_CERT_B64=$(kamal secrets extract CF_ORIGIN_CERT_B64 $SECRETS)
CF_KEY_B64=$(kamal secrets extract CF_ORIGIN_KEY_B64 $SECRETS)
CLOUDFLARE_ORIGIN_CERT=$(printf '%s' "$CF_CERT_B64" | base64 -d)
CLOUDFLARE_ORIGIN_KEY=$(printf '%s' "$CF_KEY_B64" | base64 -d)

# Brevo SMTP and the Correios tokens are not fetched here: they live in
# config/credentials/production.yml.enc (decrypted by RAILS_MASTER_KEY).
