# Secrets are fetched from Bitwarden at deploy time via the bw CLI. No secret values are
# stored in this file or in git. Export BW_ACCOUNT (your Bitwarden email) and keep bw
# logged in before deploying. See docs/deployment.md for the vault item layout.
# RAILS_MASTER_KEY is the contents of config/credentials/production.key.

SECRETS=$(kamal secrets fetch --adapter bitwarden --account $BW_ACCOUNT --from prisma-engine-prod KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY PRISMA_ENGINE_DATABASE_PASSWORD R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $SECRETS)
PRISMA_ENGINE_DATABASE_PASSWORD=$(kamal secrets extract PRISMA_ENGINE_DATABASE_PASSWORD $SECRETS)
DATABASE_PASSWORD=$PRISMA_ENGINE_DATABASE_PASSWORD
R2_ACCESS_KEY_ID=$(kamal secrets extract R2_ACCESS_KEY_ID $SECRETS)
R2_SECRET_ACCESS_KEY=$(kamal secrets extract R2_SECRET_ACCESS_KEY $SECRETS)

# Add Brevo and Correios fields to the vault item when those integrations go live, then
# add them to the fetch list above and to env.secret in config/deploy.yml.
