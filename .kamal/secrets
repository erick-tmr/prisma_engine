# Kamal expands these $VARS from the deployer's shell at deploy time. Export each
# from your own vault before running `kamal deploy`. Keep real values out of this file.
#
# RAILS_MASTER_KEY must be the contents of config/credentials/production.key
# (NOT config/master.key) — production uses env-scoped credentials.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
PRISMA_ENGINE_DATABASE_PASSWORD=$PRISMA_ENGINE_DATABASE_PASSWORD
DATABASE_PASSWORD=$PRISMA_ENGINE_DATABASE_PASSWORD
BREVO_SMTP_LOGIN=$BREVO_SMTP_LOGIN
BREVO_SMTP_KEY=$BREVO_SMTP_KEY
CORREIOS_API_TOKEN=$CORREIOS_API_TOKEN
CORREIOS_CARTAO_API_TOKEN=$CORREIOS_CARTAO_API_TOKEN
R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
