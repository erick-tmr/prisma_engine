# Copy this file to .env and adjust as needed. .env is gitignored.
# dotenv loads it at Rails boot in development + test. Production should
# inject the same variables via the host/PaaS env, not via .env.
#
# Precedence: real shell env > .env (dotenv won't override existing values).

# === Database (read by config/database.yml) ===
# Match what compose.yaml exposes locally; override per-machine if you point
# at a different Postgres.
DATABASE_HOST=localhost
DATABASE_USER=prisma_engine
DATABASE_PASSWORD=prisma_engine
# Override the Postgres port (default 5432). deploy/seed-prod-catalog.sh sets this to
# the local end of its SSH tunnel so it can reach the prod DB without colliding with a
# local Postgres on 5432.
# DATABASE_PORT=5432

# === Dev server / bin/share-dev ===
# Pin SHARE_AUTH_PASSWORD if you want a stable client-preview URL the client
# can bookmark. Otherwise bin/share-dev generates a 24-char random one each run.
# Password must be at least 16 chars.
# SHARE_AUTH_USER=demo
# SHARE_AUTH_PASSWORD=change-me-min-16-chars

# Auto-shutdown timer for bin/share-dev. Optional; unset = run until Ctrl-C.
# Format = `sleep` duration: `1800` (seconds), `30m`, `8h`, `12h`, `1d`.
# Don't combine units (no `1h30m`).
# SHARE_TIMEOUT=8h

# SHARE_MODE is exported by bin/share-dev itself, so don't pin it here.

# === Rails server ===
# Puma threads per worker + AR connection pool size (config/database.yml).
# RAILS_MAX_THREADS=5

# Port that Rails / Puma listens on (config/puma.rb, bin/share-dev, Procfile.dev).
# PORT=3000

# Production log verbosity (config/environments/production.rb): debug | info |
# warn | error | fatal | unknown.
# RAILS_LOG_LEVEL=info

# === Background jobs (solid_queue) ===
# Number of solid_queue worker processes (config/queue.yml).
# JOB_CONCURRENCY=1

# Run solid_queue inline as a Puma plugin instead of as a separate process.
# Useful for single-dyno PaaS setups; leave unset to run it via Procfile.
# SOLID_QUEUE_IN_PUMA=1

# === Puma (production tuning, config/puma.rb) ===
# Forked workers per dyno/host. Default 1 in dev; bump in production based on
# host CPU/RAM (commonly 2-4 per CPU core).
# WEB_CONCURRENCY=2

# PID file path. Usually managed by the process supervisor; set if needed.
# PIDFILE=tmp/pids/server.pid

# === Production secrets ===
# Set in your deployment environment, NOT in a committed file. Read by the
# `production:` block in config/database.yml. Also used by
# deploy/seed-prod-catalog.sh (the one-off prod image seed) to reach the prod DB
# through its SSH tunnel.
# PRISMA_ENGINE_DATABASE_PASSWORD=

# === Deploy (Kamal): exported in the deployer shell before `kamal deploy`, never committed ===
# See docs/deployment.md. Kamal reads these via .kamal/secrets.
#
# Container-registry password: a GitHub Personal Access Token with write:packages,
# to push/pull the image at ghcr.io/erick-tmr/prisma_engine.
# KAMAL_REGISTRY_PASSWORD=
#
# In production, RAILS_MASTER_KEY must be the contents of config/credentials/production.key
# (NOT config/master.key; production uses env-scoped credentials). Export it with:
#   export RAILS_MASTER_KEY="$(cat config/credentials/production.key)"
# RAILS_MASTER_KEY=

# === Production log analysis (deploy/fetch-production-logs.sh + deploy/log-analysis) ===
# Where to pull the app's durable Rails logs from for the local Loki + Grafana
# stack. See docs/log-analysis.md. Mirrors config/deploy.yml (Kamal connects as
# root); SSH auth uses your existing key. The host IP is not a secret.
PRODUCTION_LOG_HOST=187.127.38.87
PRODUCTION_LOG_USER=root
# PRODUCTION_LOG_SSH_PORT=22
# Local dir the fetcher writes and the stack reads. Defaults to system /tmp so the
# OS reclaims the space and nothing lands inside the repo.
# PRODUCTION_LOG_DIR=/tmp/prisma-production-logs
# Named volume the app writes log/production.log to (config/deploy.yml). Override
# only if you rename it there.
# PRODUCTION_LOG_VOLUME=prisma_engine_logs

# === VPS health check (deploy/vps-healthcheck.sh, bin/prisma health) ===
# Reuses the PRODUCTION_LOG_* keys above to reach the box. See docs/vps-healthcheck.md.
# Optional read-only healthchecks.io API key: with it, the downdetector section asserts
# the monitor itself is up and pinged today, instead of only that the VPS can reach it.
# HEALTHCHECKS_API_KEY=

# === Email brand images -> prod R2 (deploy/upload-email-images.sh) ===
# Run locally to push the static email images (dragon art + logo) to the prod R2
# bucket (prisma-games-prod) under the emails/ prefix, over the S3 API (no SSH).
# Create a Cloudflare R2 API token scoped to that bucket with Object Read & Write.
# PROD_R2_ACCESS_KEY_ID=
# PROD_R2_SECRET_ACCESS_KEY=
# S3 endpoint of the Cloudflare account that holds prisma-games-prod. Passed
# explicitly so the script does not depend on the Rails env it boots under.
# PROD_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# === Maintenance mode (config/initializers/maintenance.rb) ===
# Closes the storefront behind public/maintenance.html: every request answers 503
# with Retry-After, except /up (so kamal-proxy keeps the container in rotation) and
# POST /pagamentos/webhook/:token (so a payment landing mid-window still confirms).
# Background jobs keep running: nothing they do writes to Active Storage, and
# payment verification and tracking are better off not pausing. Read at boot, so
# switching it in production is `kamal env push` plus a restart, not a live toggle.
# MAINTENANCE_MODE=1
#
# Comma-separated client IPs that bypass the page, so the site can be verified
# while customers still see it. Matched against CF-Connecting-IP, then the socket
# address. Leave unset to close the site for everyone.
# MAINTENANCE_ALLOW_IPS=203.0.113.7,203.0.113.8

# === Cloudflare inventory (deploy/cf-inventory.sh) ===
# Read-only Cloudflare API token used to re-capture docs/cloudflare/inventory.md.
# Every call the script makes is a GET. Mint it with a short TTL and delete it after
# the run; the required permission rows are listed in the script's header.
# CF_API_TOKEN=
