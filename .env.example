# Copy this file to .env and adjust as needed. .env is gitignored.
# dotenv loads it at Rails boot (development + test) — see Gemfile.

# === Database ===
# Match what compose.yaml exposes; override if you point at another Postgres.
DATABASE_HOST=localhost
DATABASE_USER=prisma_engine
DATABASE_PASSWORD=prisma_engine

# === Dev server / share mode (bin/share-dev) ===
# Pin these if you want a stable URL+password your client can keep.
# If unset, bin/share-dev generates SHARE_AUTH_PASSWORD as 24 random chars.
# SHARE_AUTH_USER=demo
# SHARE_AUTH_PASSWORD=change-me-min-16-chars

# Auto-shutdown timer (Bash duration: 30m, 8h, 1d).
# SHARE_TIMEOUT=8h

# Rails server port; bin/share-dev and Procfile.dev both honor it.
# PORT=3000

# === Rails ===
# Concurrency (default 5). Bump if you serve many concurrent dev requests.
# RAILS_MAX_THREADS=5
