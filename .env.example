# Copy this file to .env and adjust as needed. .env is gitignored.
# dotenv loads it at Rails boot in development + test. Production should
# inject the same variables via the host/PaaS env, not via .env.
#
# Precedence: real shell env > .env (dotenv won't override existing values).

# === Database (read by config/database.yml) ===
# Match what compose.yaml exposes locally; override per-machine if you point
# at a different Postgres.
DATABASE_HOST=localhost
DATABASE_USER=prisma_engine
DATABASE_PASSWORD=prisma_engine

# === Correios tracking API (app/services/correios/rastro.rb) ===
# We poll the Correios rastro (tracking) API; our contract has no webhooks. The
# API host is a shared constant in code (Correios::API_BASE_URL) — only the token
# is configured here.
#
# Bearer token for the rastro API (the `cws-...` string). Obtain it from the
# Correios API portal and rotate as needed; SyncShipmentJob sends it as
# `Authorization: Bearer <token>`. Keep the real value out of this committed file.
# CORREIOS_API_TOKEN=
#
# Separate Bearer token for the pré-postagem (cartão de postagem) API, used by
# Correios::CreatePrePostagem to create shipping labels. Distinct from the rastro
# token above. Keep the real value out of this committed file.
# CORREIOS_CARTAO_API_TOKEN=

# === InfinitePay checkout (app/services/infinite_pay/) ===
# Our store handle on InfinitePay — the only config the hosted-checkout link
# API needs (POST https://api.checkout.infinitepay.io/links is unauthenticated,
# keyed by this handle). The API host is a constant in code (InfinitePay::Api::BASE_URL).
# The InfinitePay redirect_url + webhook_url we send are derived from the request
# host, so run bin/share-dev to expose them publicly when testing the redirect/webhook.
INFINITEPAY_HANDLE=prisma_games

# === Cloudflare R2 object storage (config/storage.yml `r2:` service) ===
# Active Storage runs on R2 in development AND production; only the test suite stays
# on local Disk. Use one R2 account with a separate bucket per environment: set your
# dev bucket here, production injects its own values. Fill these in after creating
# the bucket and an R2 API token in the Cloudflare dashboard. Keep real values out of
# this committed file (.env is gitignored).
#
# S3 API endpoint for the account (NOT the public host), from the R2 dashboard:
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=prisma-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
#
# Public host the bucket is served from. It builds image URLs and is added to the CSP
# img_src (config/initializers/content_security_policy.rb). Scheme + host, no trailing
# slash. Dev can use the bucket's r2.dev URL; production uses a custom domain.
R2_PUBLIC_HOST=

# === Dev server / bin/share-dev ===
# Pin SHARE_AUTH_PASSWORD if you want a stable client-preview URL the client
# can bookmark. Otherwise bin/share-dev generates a 24-char random one each run.
# Password must be at least 16 chars.
# SHARE_AUTH_USER=demo
# SHARE_AUTH_PASSWORD=change-me-min-16-chars

# Auto-shutdown timer for bin/share-dev. Optional — unset = run until Ctrl-C.
# Format = `sleep` duration: `1800` (seconds), `30m`, `8h`, `12h`, `1d`.
# Don't combine units (no `1h30m`).
# SHARE_TIMEOUT=8h

# SHARE_MODE is exported by bin/share-dev itself — don't pin it here.

# === Rails server ===
# Puma threads per worker + AR connection pool size (config/database.yml).
# RAILS_MAX_THREADS=5

# Port that Rails / Puma listens on (config/puma.rb, bin/share-dev, Procfile.dev).
# PORT=3000

# Production log verbosity (config/environments/production.rb): debug | info |
# warn | error | fatal | unknown.
# RAILS_LOG_LEVEL=info

# === Background jobs (solid_queue) ===
# Number of solid_queue worker processes (config/queue.yml).
# JOB_CONCURRENCY=1

# Run solid_queue inline as a Puma plugin instead of as a separate process.
# Useful for single-dyno PaaS setups; leave unset to run it via Procfile.
# SOLID_QUEUE_IN_PUMA=1

# === Puma (production tuning, config/puma.rb) ===
# Forked workers per dyno/host. Default 1 in dev; bump in production based on
# host CPU/RAM (commonly 2-4 per CPU core).
# WEB_CONCURRENCY=2

# PID file path. Usually managed by the process supervisor; set if needed.
# PIDFILE=tmp/pids/server.pid

# === Production secrets ===
# Set in your deployment environment, NOT in a committed file. Read by the
# `production:` block in config/database.yml.
# PRISMA_ENGINE_DATABASE_PASSWORD=

# === Deploy (Kamal) — exported in the deployer shell before `kamal deploy`, never committed ===
# See docs/deployment.md. Kamal reads these via .kamal/secrets.
#
# Container-registry password: a GitHub Personal Access Token with write:packages,
# to push/pull the image at ghcr.io/erick-tmr/prisma_engine.
# KAMAL_REGISTRY_PASSWORD=
#
# In production, RAILS_MASTER_KEY must be the contents of config/credentials/production.key
# (NOT config/master.key — production uses env-scoped credentials). Export it with:
#   export RAILS_MASTER_KEY="$(cat config/credentials/production.key)"
# RAILS_MASTER_KEY=
