#!/usr/bin/env bash
#
# Prisma Games project CLI. One entry point for the operational chores that
# are too situational to live in a rake task.
#
# Usage:     bin/prisma <action> [options]
# Help:      bin/prisma help
# Runbook:   docs/deployment.md
#
# Adding an action: define `cmd_<name>` below and list it in usage().
#
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

REMOTE="origin"
BRANCH="main"

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
die()  { printf '\n\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
  cat <<'TXT'
Usage: bin/prisma <action> [options]

Actions:
  deploy [--yes]   Ship production from a pristine copy of origin/main: fetch,
                   move to main, hard-reset onto the remote, then kamal deploy.
                   Stops on a dirty working tree, or when main holds commits
                   origin/main does not, rather than resetting over them.
                   --yes skips the confirmation, for cron.
  health [opts]    Read-only sanity sweep of the production VPS: host resources,
                   firewall, containers, TLS, Postgres, Solid Queue, the nightly
                   R2 backup, the heartbeat monitor, the durable logs and a few
                   application invariants. Exits 1 on warnings, 2 on failures.
                   --hours N scans a wider log window, --verify-restore also
                   proves the newest dump is a readable archive.
  help             Show this message.

Runbooks: docs/deployment.md, docs/vps-healthcheck.md
TXT
}

cmd_help() {
  usage
}

cmd_deploy() {
  local assume_yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) assume_yes=1 ;;
      *)        die "deploy: unknown option: $arg (try bin/prisma help)" ;;
    esac
  done

  step "working tree"
  local dirty
  dirty="$(git status --porcelain --untracked-files=no)"
  if [ -n "$dirty" ]; then
    printf '%s\n' "$dirty"
    die "the changes above would be destroyed by the reset; commit, stash or discard them first"
  fi
  ok "clean"

  step "fetching $REMOTE"
  git fetch "$REMOTE" --prune --quiet
  ok "fetched"

  if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
    local unpushed
    unpushed="$(git log --oneline "$REMOTE/$BRANCH..$BRANCH")"
    if [ -n "$unpushed" ]; then
      printf '%s\n' "$unpushed"
      die "$BRANCH has commits that are not on $REMOTE/$BRANCH; the reset would drop them"
    fi
  fi

  step "moving to $BRANCH"
  git checkout --quiet "$BRANCH" 2>/dev/null || git checkout --quiet -b "$BRANCH" "$REMOTE/$BRANCH"
  git reset --hard --quiet "$REMOTE/$BRANCH"
  ok "$BRANCH is at $REMOTE/$BRANCH"

  step "deploying"
  git --no-pager log -1 --format='  %C(auto)%h%Creset  %s%n  %an · %ar'

  if [ "$assume_yes" -ne 1 ]; then
    local reply
    printf '\nDeploy this to production? [y/N] '
    read -r reply || die "nothing on stdin to answer with; pass --yes to deploy non-interactively"
    case "$reply" in
      [yY]|[yY][eE][sS]) ;;
      *) die "aborted, nothing deployed" ;;
    esac
  fi

  step "kamal deploy"
  bin/kamal deploy

  printf '\n\033[1;32m✓ Deployed %s to production.\033[0m\n' "$(git rev-parse --short HEAD)"
}

cmd_health() {
  exec deploy/vps-healthcheck.sh "$@"
}

ACTION="${1:-help}"
[ $# -gt 0 ] && shift

case "$ACTION" in
  -h|--help) ACTION="help" ;;
esac

if ! declare -F "cmd_$ACTION" >/dev/null; then
  printf '\033[1;31m✗ unknown action: %s\033[0m\n\n' "$ACTION" >&2
  usage >&2
  exit 64
fi

"cmd_$ACTION" "$@"
