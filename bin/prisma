#!/usr/bin/env bash
#
# Prisma Games project CLI. One entry point for the operational chores that
# are too situational to live in a rake task.
#
# Usage:     bin/prisma <action> [options]
# Help:      bin/prisma help
# Runbook:   docs/deployment.md
#
# Adding an action: define `cmd_<name>` below and list it in usage().
#
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

REMOTE="origin"
BRANCH="main"

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
die()  { printf '\n\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

ensure_bw_session() {
  step "bitwarden"
  if [ -n "${BW_SESSION:-}" ]; then
    ok "BW_SESSION already set"
    return
  fi

  command -v bw >/dev/null 2>&1 ||
    die "the bw CLI is not installed, so kamal cannot fetch the deploy secrets"

  [ -t 0 ] ||
    die "BW_SESSION is unset and there is no terminal to unlock on; export BW_SESSION=\$(bw unlock --raw) before a non-interactive deploy"

  BW_SESSION="$(bw unlock --raw)" || die "could not unlock Bitwarden"
  export BW_SESSION
  ok "unlocked"
}

usage() {
  cat <<'TXT'
Usage: bin/prisma <action> [options]

Actions:
  deploy [--yes]   Ship production from a pristine copy of origin/main: fetch,
                   move to main, hard-reset onto the remote, then kamal deploy.
                   Stops on a dirty working tree, or when main holds commits
                   origin/main does not, rather than resetting over them.
                   --yes skips the confirmation, for cron.
  health [opts]    Read-only sanity sweep of the production VPS: host resources,
                   firewall, containers, TLS, Postgres, Solid Queue, the nightly
                   R2 backup, the heartbeat monitor, the durable logs and a few
                   application invariants. Exits 1 on warnings, 2 on failures.
                   --hours N scans a wider log window, --verify-restore also
                   proves the newest dump is a readable archive.
  upload-asset <file> --env development|production [--yes]
                   Upload a file to that environment's R2 bucket exactly as
                   Active Storage would (same key format, checksum and cache
                   headers), without touching its database. Prints the public
                   URL and an ActiveStorage::Blob.create! line to paste into
                   that environment's console (bin/kamal console for
                   production, bin/rails console for development), where you
                   attach the blob to a record. --env is required. Needs
                   config/credentials/production.key or config/master.key.
  help             Show this message.

Runbooks: docs/deployment.md, docs/vps-healthcheck.md
TXT
}

cmd_help() {
  usage
}

cmd_deploy() {
  local assume_yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) assume_yes=1 ;;
      *)        die "deploy: unknown option: $arg (try bin/prisma help)" ;;
    esac
  done

  step "working tree"
  local dirty
  dirty="$(git status --porcelain --untracked-files=no)"
  if [ -n "$dirty" ]; then
    printf '%s\n' "$dirty"
    die "the changes above would be destroyed by the reset; commit, stash or discard them first"
  fi
  ok "clean"

  step "fetching $REMOTE"
  git fetch "$REMOTE" --prune --quiet
  ok "fetched"

  if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
    local unpushed
    unpushed="$(git log --oneline "$REMOTE/$BRANCH..$BRANCH")"
    if [ -n "$unpushed" ]; then
      printf '%s\n' "$unpushed"
      die "$BRANCH has commits that are not on $REMOTE/$BRANCH; the reset would drop them"
    fi
  fi

  step "moving to $BRANCH"
  git checkout --quiet "$BRANCH" 2>/dev/null || git checkout --quiet -b "$BRANCH" "$REMOTE/$BRANCH"
  git reset --hard --quiet "$REMOTE/$BRANCH"
  ok "$BRANCH is at $REMOTE/$BRANCH"

  step "deploying"
  git --no-pager log -1 --format='  %C(auto)%h%Creset  %s%n  %an · %ar'

  if [ "$assume_yes" -ne 1 ]; then
    local reply
    printf '\nDeploy this to production? [y/N] '
    read -r reply || die "nothing on stdin to answer with; pass --yes to deploy non-interactively"
    case "$reply" in
      [yY]|[yY][eE][sS]) ;;
      *) die "aborted, nothing deployed" ;;
    esac
  fi

  ensure_bw_session

  step "kamal deploy"
  bin/kamal deploy

  printf '\n\033[1;32m✓ Deployed %s to production.\033[0m\n' "$(git rev-parse --short HEAD)"
}

cmd_upload_asset() {
  local assume_yes=0 file="" env=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) assume_yes=1 ;;
      --env)    [ $# -ge 2 ] || die "upload-asset: --env needs development or production"; env="$2"; shift ;;
      --env=*)  env="${1#--env=}" ;;
      -*)       die "upload-asset: unknown option: $1 (try bin/prisma help)" ;;
      *)        [ -z "$file" ] || die "upload-asset: one file at a time"; file="$1" ;;
    esac
    shift
  done

  local key_file console
  case "$env" in
    production)  key_file="config/credentials/production.key"; console="bin/kamal console" ;;
    development) key_file="config/master.key";                  console="bin/rails console" ;;
    "")          die "usage: bin/prisma upload-asset <file> --env development|production [--yes]" ;;
    *)           die "upload-asset: --env must be development or production, not '$env'" ;;
  esac
  [ -n "$file" ] || die "usage: bin/prisma upload-asset <file> --env development|production [--yes]"
  [ -f "$file" ] || die "upload-asset: no such file: $file"
  [ -f "$key_file" ] || die "$key_file is missing, so the $env R2 keys cannot decrypt"
  file="$(cd -- "$(dirname -- "$file")" && pwd)/$(basename -- "$file")"

  step "upload"
  printf '  %s (%s bytes) -> %s R2 bucket\n' "$file" "$(wc -c <"$file" | tr -d ' ')" "$env"
  if [ "$assume_yes" -ne 1 ]; then
    local reply
    printf '\nUpload it to %s? [y/N] ' "$env"
    read -r reply || die "nothing on stdin to answer with; pass --yes to upload non-interactively"
    case "$reply" in
      [yY]|[yY][eE][sS]) ;;
      *) die "aborted, nothing uploaded" ;;
    esac
  fi

  local output url
  output="$(RAILS_ENV="$env" DATABASE_HOST=127.0.0.1 DATABASE_PORT=9 \
    SECRET_KEY_BASE="${SECRET_KEY_BASE:-$(openssl rand -hex 32)}" \
    bin/rails runner '
      result = Storage::AssetUpload.call(ARGV.fetch(0))
      puts "upload-asset-url: #{result.url}"
      puts "upload-asset-blob: #{result.console_snippet}"
    ' "$file")" || die "upload failed"
  local snippet
  url="$(printf '%s\n' "$output" | sed -n 's/^upload-asset-url: //p')"
  snippet="$(printf '%s\n' "$output" | sed -n 's/^upload-asset-blob: //p')"
  [ -n "$url" ] && [ -n "$snippet" ] || die "upload ran but reported nothing usable:"$'\n'"$output"
  ok "uploaded: $url"

  step "verify"
  local status
  status="$(curl -s -o /dev/null -w '%{http_code}' -I "$url")"
  [ "$status" = "200" ] || die "the CDN answered $status for $url"
  ok "served from $url"

  step "attach it in $console ($env)"
  printf '%s\n' "$snippet"
  printf '\nthen point a record at it, for example:\n'
  printf '  HeroBanner.create!(image: blob, alt: "...", black_friday: true, position: 0)\n'
}

cmd_health() {
  exec deploy/vps-healthcheck.sh "$@"
}

ACTION="${1:-help}"
[ $# -gt 0 ] && shift

case "$ACTION" in
  -h|--help) ACTION="help" ;;
esac
ACTION="${ACTION//-/_}"

if ! declare -F "cmd_$ACTION" >/dev/null; then
  printf '\033[1;31m✗ unknown action: %s\033[0m\n\n' "$ACTION" >&2
  usage >&2
  exit 64
fi

"cmd_$ACTION" "$@"
