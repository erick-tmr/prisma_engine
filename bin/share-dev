#!/usr/bin/env bash
#
# Boot the Rails dev server in SHARE_MODE (HTTP basic auth, no source-leaking
# error pages, no web-console) behind a Cloudflare Tunnel that exposes it at a
# random https://*.trycloudflare.com URL. Safe enough to leave running while
# you sleep.
#
# Usage:           bin/share-dev
# Auto-stops:      only if SHARE_TIMEOUT is set (e.g. SHARE_TIMEOUT=8h);
#                  unset = run until Ctrl-C
# Manual stop:     Ctrl-C (kills Rails + tunnel)
# Custom creds:    SHARE_AUTH_USER=demo SHARE_AUTH_PASSWORD='...' bin/share-dev
#
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Source .env so SHARE_AUTH_USER / SHARE_AUTH_PASSWORD / PORT / SHARE_TIMEOUT
# pinned there take precedence over the random-password fallback below.
# (dotenv gem loads it for Rails too, but Rails boots after this script.)
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

CLOUDFLARED_BIN="${CLOUDFLARED_BIN:-./tmp/bin/cloudflared}"
PORT="${PORT:-3000}"
# SHARE_TIMEOUT is optional. Unset/empty = run until Ctrl-C.
SHARE_TIMEOUT="${SHARE_TIMEOUT:-}"

# 1. Ensure cloudflared is available. Prefer a system install; fall back to a
#    cached static binary under tmp/bin so the script is hermetic.
if command -v cloudflared >/dev/null 2>&1; then
  CLOUDFLARED_BIN="$(command -v cloudflared)"
elif [ ! -x "$CLOUDFLARED_BIN" ]; then
  echo "==> cloudflared not found, downloading static binary into tmp/bin/"
  mkdir -p tmp/bin
  ARCH="$(uname -m)"
  case "$ARCH" in
    x86_64)  CF_ASSET="cloudflared-linux-amd64" ;;
    aarch64) CF_ASSET="cloudflared-linux-arm64" ;;
    armv7l)  CF_ASSET="cloudflared-linux-arm" ;;
    *) echo "Unsupported architecture: $ARCH"; exit 1 ;;
  esac
  curl -fL --retry 3 \
    "https://github.com/cloudflare/cloudflared/releases/latest/download/${CF_ASSET}" \
    -o "$CLOUDFLARED_BIN"
  chmod +x "$CLOUDFLARED_BIN"
fi

# 2. Generate or reuse credentials. Default user is "demo"; password is a
#    24-char random string unless overridden via env (~143 bits of entropy).
export SHARE_MODE=1
export SHARE_AUTH_USER="${SHARE_AUTH_USER:-demo}"
if [ -z "${SHARE_AUTH_PASSWORD:-}" ]; then
  SHARE_AUTH_PASSWORD="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24)"
fi
export SHARE_AUTH_PASSWORD

LAN_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"

# 3. Start Rails (background) in SHARE_MODE, bound to all interfaces. The
#    initializer wires basic auth + dev-route blocking; the env config drops
#    web-console and verbose error pages.
echo "==> Starting Rails (SHARE_MODE=1) on 0.0.0.0:${PORT}"
bin/rails server -b 0.0.0.0 -p "$PORT" &
RAILS_PID=$!

cleanup() {
  # Disarm the trap so additional Ctrl-Cs during cleanup don't re-enter this
  # function and produce the dreaded multi-stop message loop.
  trap '' EXIT INT TERM

  echo
  echo "==> Stopping tunnel (pid ${TUNNEL_PID:-?}) and timer (pid ${TIMEOUT_PID:-?})"
  kill "${TUNNEL_PID:-0}"  2>/dev/null || true
  kill "${TIMEOUT_PID:-0}" 2>/dev/null || true

  # Puma traps SIGTERM as a graceful shutdown and waits for keep-alive
  # connections (cloudflared holds one open). Send TERM, give it 5s, then KILL.
  if kill -0 "$RAILS_PID" 2>/dev/null; then
    echo "==> Stopping Rails (pid $RAILS_PID): graceful, then forced after 5s"
    kill -TERM "$RAILS_PID" 2>/dev/null || true
    for _ in $(seq 1 10); do
      kill -0 "$RAILS_PID" 2>/dev/null || break
      sleep 0.5
    done
    if kill -0 "$RAILS_PID" 2>/dev/null; then
      echo "==> Rails didn't exit gracefully, sending SIGKILL"
      kill -KILL "$RAILS_PID" 2>/dev/null || true
    fi
  fi

  wait 2>/dev/null || true
  exit 0
}
trap cleanup EXIT INT TERM

# 4. Wait for Rails to answer (probe on /up, which auth-blocks but still 401s
#    fast, proving the app is up).
for _ in $(seq 1 30); do
  code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/up" || true)"
  if [ "$code" = "401" ] || [ "$code" = "200" ]; then break; fi
  sleep 1
done

# 5. Start the tunnel and tee its output so we can echo the public URL.
TUNNEL_LOG="tmp/cloudflared.log"
: > "$TUNNEL_LOG"
echo "==> Opening Cloudflare Tunnel"
"$CLOUDFLARED_BIN" tunnel --no-autoupdate --url "http://localhost:${PORT}" \
  >>"$TUNNEL_LOG" 2>&1 &
TUNNEL_PID=$!

PUBLIC_URL=""
for _ in $(seq 1 60); do
  PUBLIC_URL="$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" | head -1 || true)"
  [ -n "$PUBLIC_URL" ] && break
  sleep 1
done

# 6. Auto-stop after SHARE_TIMEOUT, only if it was set. Empty = run forever.
if [ -n "$SHARE_TIMEOUT" ]; then
  ( sleep "$SHARE_TIMEOUT" ; echo; echo "==> SHARE_TIMEOUT (${SHARE_TIMEOUT}) reached, shutting down"; kill "$RAILS_PID" "$TUNNEL_PID" 2>/dev/null || true ) &
  TIMEOUT_PID=$!
  TIMEOUT_NOTE="Auto-stops in ${SHARE_TIMEOUT}.  Ctrl-C to stop sooner."
else
  TIMEOUT_NOTE="No auto-stop (SHARE_TIMEOUT unset).  Ctrl-C to stop."
fi

cat <<BANNER

==================================================================
  Prisma Games preview is live.

  Local:    http://localhost:${PORT}
  LAN:      http://${LAN_IP:-<your-lan-ip>}:${PORT}   (phone on same Wi-Fi)
  Public:   ${PUBLIC_URL:-<not ready, see tmp/cloudflared.log>}

  Login:    user     ${SHARE_AUTH_USER}
            password ${SHARE_AUTH_PASSWORD}

  ${TIMEOUT_NOTE}
  Tunnel log: tmp/cloudflared.log
==================================================================
BANNER

wait "$RAILS_PID"
