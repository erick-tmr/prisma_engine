#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../.." && pwd)"
bw_item="${BW_ITEM:-prisma-engine-prod}"

for dep in bw jq; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "infra-env: missing dependency '$dep'" >&2
    return 1 2>/dev/null || exit 1
  fi
done

if [ -z "${BW_SESSION:-}" ]; then
  BW_SESSION="$(bw unlock --raw)"
  export BW_SESSION
fi
bw sync >/dev/null 2>&1 || true

item_json="$(bw get item "$bw_item")"
bw_field() {
  printf '%s' "$item_json" | jq -r --arg n "$1" '[.fields[]? | select(.name==$n) | .value][0] // ""'
}

PRISMA_ENGINE_DATABASE_PASSWORD="$(bw_field PRISMA_ENGINE_DATABASE_PASSWORD)"
HC_PING_URL="$(bw_field HC_PING_URL)"
R2_BACKUP_ACCESS_KEY_ID="$(bw_field R2_BACKUP_ACCESS_KEY_ID)"
R2_BACKUP_SECRET_ACCESS_KEY="$(bw_field R2_BACKUP_SECRET_ACCESS_KEY)"
R2_ENDPOINT="$(awk -F'endpoint:[[:space:]]*' '/^[[:space:]]*endpoint:/{print $2; exit}' "$repo_root/config/storage.yml")"
export PRISMA_ENGINE_DATABASE_PASSWORD HC_PING_URL \
  R2_BACKUP_ACCESS_KEY_ID R2_BACKUP_SECRET_ACCESS_KEY R2_ENDPOINT

export BACKUP_BUCKET="${BACKUP_BUCKET:-prisma-engine-backups}"

echo "infra-env: exported PRISMA_ENGINE_DATABASE_PASSWORD, HC_PING_URL, R2_BACKUP_*, R2_ENDPOINT, BACKUP_BUCKET (bw item: ${bw_item})" >&2
