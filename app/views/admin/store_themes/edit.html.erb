<% content_for :title, t("admin.theme.title") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "vendor/bootstrap-icons" %>
  <%= stylesheet_link_tag "base/tokens", "base/animations", "pages/backoffice-shell",
                          "pages/backoffice-dashboard", "pages/backoffice-order", "pages/backoffice-catalog",
                          "pages/backoffice-theme" %>
<% end %>

<div class="app-rainbow" aria-hidden="true"></div>

<div class="app" data-list="store-theme">
  <%= render "admin/sidebar", active: "theme" %>

  <div class="main">
    <header class="topbar">
      <button class="icon-btn" id="menu-toggle" type="button" aria-label="<%= t("admin.dashboard.menu") %>"><i class="bi bi-list"></i></button>
      <div class="topbar-head">
        <h1><%= t("admin.theme.topbar_title") %></h1>
        <span class="crumb"><%= t("admin.theme.crumb") %></span>
      </div>
      <div class="topbar-right"></div>
    </header>

    <main class="content">
      <% flash.each do |type, message| %>
        <div class="od-flash od-flash--<%= type == "alert" ? "alert" : "ok" %>" role="alert">
          <span class="od-flash__msg"><%= message %></span>
          <button type="button" class="od-flash__close" data-flash-close aria-label="<%= t("admin.theme.dismiss") %>"><i class="bi bi-x-lg"></i></button>
        </div>
      <% end %>

      <div class="panel">
        <div class="panel-top">
          <div class="panel-top-main">
            <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.theme.heading") %></h2>
            <div class="sub"><%= t("admin.theme.sub") %></div>
          </div>
          <div class="panel-top-right">
            <span class="gotm-edition" data-theme-status>
              <%= t("admin.theme.status.#{@setting.black_friday_status}",
                    starts_at: @setting.black_friday_starts_at && l(@setting.black_friday_starts_at, format: :long),
                    ends_at: @setting.black_friday_ends_at && l(@setting.black_friday_ends_at, format: :long)) %>
            </span>
          </div>
        </div>

        <%= form_with model: @setting, url: admin_store_theme_path, method: :patch, class: "panel-body",
                      data: { schedule: true, schedule_empty: t("admin.theme.readout_empty"),
                              schedule_open_end: t("admin.theme.readout_open_end") } do |f| %>
          <%= f.hidden_field :black_friday_starts_at, value: theme_picker_value(@setting.black_friday_starts_at), data: { schedule_value: "start" } %>
          <%= f.hidden_field :black_friday_ends_at, value: theme_picker_value(@setting.black_friday_ends_at), data: { schedule_value: "end" } %>

          <div class="field">
            <label><%= t("admin.theme.period") %> <span class="lbl-note"><%= t("admin.theme.period_note") %></span></label>
            <div class="theme-cal dp-cals" data-schedule-cals></div>
          </div>

          <div class="theme-times">
            <div class="field">
              <label for="theme-start-time"><%= t("admin.theme.start_time") %></label>
              <input class="inp theme-time" id="theme-start-time" type="text" inputmode="numeric" maxlength="5"
                     pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="00:00" data-schedule-time="start">
            </div>
            <div class="field">
              <label for="theme-end-time"><%= t("admin.theme.end_time") %></label>
              <input class="inp theme-time" id="theme-end-time" type="text" inputmode="numeric" maxlength="5"
                     pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="00:00" data-schedule-time="end">
            </div>
          </div>
          <span class="theme-hint"><%= t("admin.theme.timezone_hint") %></span>

          <div class="theme-foot gap-top">
            <span class="dp-readout" data-schedule-readout></span>
            <span class="sp"></span>
            <button type="button" class="btn-clear" data-schedule-clear><i class="bi bi-x-lg"></i> <%= t("admin.theme.clear") %></button>
            <button type="submit" class="btn-dark"><i class="bi bi-calendar-event"></i> <%= t("admin.theme.save") %></button>
          </div>
        <% end %>

        <% if @setting.black_friday_starts_at %>
          <div class="panel-body">
            <%= button_to admin_store_theme_path, method: :delete, class: "btn-ghost",
                          form: { data: { confirm: t("admin.theme.turn_off_confirm") } } do %>
              <i class="bi bi-x-circle"></i> <%= t("admin.theme.turn_off") %>
            <% end %>
          </div>
        <% end %>
      </div>
    </main>
  </div>
</div>

<% content_for :scripts do %>
  <%= javascript_import_module_tag "backoffice/store_theme" %>
<% end %>
