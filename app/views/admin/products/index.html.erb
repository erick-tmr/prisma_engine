<% content_for :title, t("admin.catalog.title") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "vendor/bootstrap-icons" %>
  <%= stylesheet_link_tag "base/tokens", "base/animations", "pages/backoffice-shell", "pages/backoffice-dashboard", "pages/backoffice-catalog" %>
<% end %>

<div class="app-rainbow" aria-hidden="true"></div>

<div class="app" data-list="catalog">
  <%= render "admin/sidebar", active: "catalog" %>

  <div class="main">
    <header class="topbar">
      <button class="icon-btn" id="menu-toggle" type="button" aria-label="<%= t("admin.dashboard.menu") %>"><i class="bi bi-list"></i></button>
      <div class="topbar-head">
        <h1><%= t("admin.catalog.topbar_title") %></h1>
        <span class="crumb"><%= t("admin.catalog.crumb") %></span>
      </div>
      <div class="topbar-right"></div>
    </header>

    <main class="content">
      <div class="panel">
        <div class="panel-top">
          <div class="panel-top-main">
            <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.catalog.heading") %></h2>
            <div class="sub"><%= t("admin.catalog.sub") %></div>
          </div>
          <div class="panel-top-right">
            <%= render "results_count" %>
            <%= link_to new_admin_product_path, class: "btn-dark" do %>
              <i class="bi bi-plus-lg"></i> <%= t("admin.catalog.new_product") %>
            <% end %>
          </div>
        </div>

        <div class="filters" data-filters>
          <div class="fgroup fgrow">
            <label for="c-q"><%= t("admin.catalog.filters.query") %></label>
            <div class="f-input">
              <i class="bi bi-search"></i>
              <input id="c-q" type="text" name="q" data-filter="q" value="<%= @search.query %>"
                     placeholder="<%= t("admin.catalog.filters.query_placeholder") %>">
            </div>
          </div>
          <div class="fgroup">
            <label for="c-cat"><%= t("admin.catalog.filters.category") %></label>
            <select class="inp f-cat" id="c-cat" name="cat" data-filter="cat">
              <option value=""><%= t("admin.catalog.filters.category_all") %></option>
              <% @presenter.categories.each do |name, slug| %>
                <option value="<%= slug %>" <%= "selected" if @search.category == slug %>><%= name %></option>
              <% end %>
            </select>
          </div>
          <div class="fgroup">
            <label for="c-status"><%= t("admin.catalog.filters.status") %></label>
            <select class="inp f-status" id="c-status" name="status" data-filter="status">
              <option value=""><%= t("admin.catalog.filters.status_all") %></option>
              <% %w[published draft gotm].each do |value| %>
                <option value="<%= value %>" <%= "selected" if @search.status == value %>><%= t("admin.catalog.filters.status_#{value}") %></option>
              <% end %>
            </select>
          </div>
        </div>

        <%= render "results_table" %>
      </div>
    </main>
  </div>
</div>

<div class="toasts" id="toasts" aria-live="polite">
  <% flash.each do |type, message| %>
    <div class="toast toast-<%= type == "alert" ? "warn" : "ok" %>" data-toast>
      <i class="bi <%= type == "alert" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill" %>"></i>
      <div class="tx"><%= message %></div>
    </div>
  <% end %>
</div>

<% content_for :scripts do %>
  <%= javascript_import_module_tag "backoffice/catalog" %>
<% end %>
