<%# locals: (order:) %>
<tr data-order="<%= order.number %>" data-status="<%= order.status %>">
  <% if order.merged? %>
    <td class="checkcol"></td>
  <% else %>
    <td class="checkcol">
      <span class="rowcheck" data-check="<%= order.number %>" role="checkbox" aria-checked="false" tabindex="0"></span>
    </td>
  <% end %>
  <td>
    <a class="cell-mono cell-link" href="<%= admin_order_path(order) %>"><%= order.number %></a>
  </td>
  <td>
    <div class="who">
      <div class="who-av who-av--<%= avatar_tint(order.user.full_name) %>"><%= account_avatar_initials(order.user.full_name) %></div>
      <div class="who-meta">
        <div class="nm"><%= order.user.full_name %></div>
        <div class="em"><%= order.shipment&.city ? "#{order.shipment.city}/#{order.shipment.state}" : "–" %></div>
      </div>
    </div>
  </td>
  <td class="cell-num">
    <%= l(order.created_at.to_date, format: :list) %>
    <div class="cell-sub"><%= t("admin.lists.items", count: order.order_items.sum(&:quantity)) %></div>
  </td>
  <td><span class="pill st-<%= order.status %>"><%= t("account.orders.states.#{order.status}.label") %></span></td>
  <td class="num"><span class="amount"><%= format_brl(order.total_cents) %></span></td>
  <td class="num"><i class="bi bi-chevron-right row-chev"></i></td>
</tr>
