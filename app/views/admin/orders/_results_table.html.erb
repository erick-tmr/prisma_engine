<div data-part="table">
  <div class="tbl-wrap">
    <table class="tbl" id="orders-table"<%= " hidden".html_safe if @page.empty? %>>
      <thead>
        <tr>
          <th class="checkcol">
            <span class="rowcheck" id="o-checkall" role="checkbox" aria-label="<%= t("admin.dashboard.orders.select_all") %>" tabindex="0"></span>
          </th>
          <th><%= t("admin.dashboard.orders.columns.order") %></th>
          <%= sort_header(@base_params, key: "client", label: t("admin.dashboard.orders.columns.client"),
                          sort: @search.sort, dir: @search.direction, default_dir: "asc") %>
          <%= sort_header(@base_params, key: "date", label: t("admin.dashboard.orders.columns.date"),
                          sort: @search.sort, dir: @search.direction) %>
          <%= sort_header(@base_params, key: "status", label: t("admin.dashboard.orders.columns.status"),
                          sort: @search.sort, dir: @search.direction) %>
          <%= sort_header(@base_params, key: "total", label: t("admin.dashboard.orders.columns.total"),
                          sort: @search.sort, dir: @search.direction, extra_class: "num") %>
          <th class="num"></th>
        </tr>
      </thead>
      <tbody id="orders-body">
        <%= render partial: "row", collection: @orders, as: :order %>
      </tbody>
    </table>

    <div class="empty<%= " show" if @page.empty? %>" id="orders-empty">
      <i class="bi bi-receipt-cutoff"></i>
      <p><%= t("admin.dashboard.orders.empty.title") %></p>
      <span><%= t("admin.dashboard.orders.empty.hint") %></span>
    </div>
  </div>

  <%= render "admin/shared/pager", page: @page, base_params: @base_params,
             one: t("admin.lists.order"), many: t("admin.lists.orders") %>
</div>
