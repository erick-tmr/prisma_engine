<% content_for :title, t("admin.orders.detail.page_title", number: @presenter.number) %>
<% content_for :head do %>
  <%= stylesheet_link_tag "vendor/bootstrap-icons" %>
  <%= stylesheet_link_tag "base/tokens", "base/animations", "pages/backoffice-shell", "pages/backoffice-order" %>
<% end %>

<div class="app-rainbow" aria-hidden="true"></div>

<div class="app" data-bo-order data-feedback-url="<%= admin_order_label_feedback_path(@presenter.number) %>">
  <%= render "admin/sidebar", active: "orders" %>

  <div class="main">
    <header class="topbar">
      <button class="icon-btn" type="button" data-menu-toggle aria-label="<%= t("admin.dashboard.menu") %>"><i class="bi bi-list"></i></button>
      <div class="topbar-head">
        <h1><%= t("admin.orders.detail.topbar_title") %></h1>
        <span class="crumb"><%= t("admin.orders.detail.crumb", number: @presenter.number) %></span>
      </div>
      <div class="topbar-right"></div>
    </header>

    <main class="content">
      <%= link_to admin_root_path, class: "od-back" do %>
        <i class="bi bi-arrow-left"></i> <%= t("admin.orders.detail.back") %>
      <% end %>

      <% flash.each do |type, message| %>
        <div class="od-flash od-flash--<%= type == "alert" ? "alert" : "ok" %>" role="alert">
          <span class="od-flash__msg"><%= message %></span>
          <button type="button" class="od-flash__close" data-flash-close aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
        </div>
      <% end %>

      <div class="od-head">
        <div class="od-head-main">
          <%= render "detail_head", presenter: @presenter %>
          <div class="od-head-sub">
            <span><%= t("admin.orders.detail.placed_on", date: l(@presenter.placed_at.to_date, format: :long)) %></span>
            <span class="dotsep"></span>
            <span><%= t("admin.orders.detail.item_count", count: @presenter.item_count) %></span>
          </div>
        </div>
      </div>

      <% if @presenter.merged? %>
        <div class="od-merged-note" role="status">
          <i class="bi bi-box-seam" aria-hidden="true"></i>
          <span><%= t("admin.orders.detail.merged_into_html", number: link_to("##{@presenter.merged_into.number}", admin_order_path(@presenter.merged_into))) %></span>
        </div>
      <% end %>

      <div class="od-grid">
        <div class="od-col-main">
          <% unless @presenter.merged? %>
          <div class="panel">
            <div class="panel-top">
              <div class="panel-top-main">
                <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.orders.detail.items") %></h2>
              </div>
            </div>
            <div class="od-items">
              <% @presenter.order_items.each do |item| %>
                <div class="od-item<%= " od-item-pedido" if item.custom_order? %>">
                  <% image = item.image %>
                  <div class="od-item-thumb">
                    <% if image.present? %>
                      <%= storefront_image_tag image, resize: 120, alt: item.name, loading: "lazy" %>
                    <% else %>
                      <i class="bi <%= item.custom_order? ? "bi-card-checklist" : "bi-controller" %>"></i>
                    <% end %>
                  </div>
                  <div class="od-item-info">
                    <div class="nm"><%= item.name %><% if item.custom_order? %> <span class="od-pedido-tag"><%= t("admin.orders.detail.custom_order_tag") %></span><% end %></div>
                    <% if item.chosen_options.any? %>
                      <div class="opts"><%= item.chosen_options.join(" · ") %></div>
                    <% end %>
                    <% if item.custom_order? %>
                      <div class="od-pedido">
                        <div class="od-pedido-head"><i class="bi bi-controller"></i> <%= t("admin.orders.detail.request_heading") %></div>
                        <div class="od-pedido-field">
                          <span class="k"><%= t("admin.orders.detail.requested_game") %></span>
                          <span class="v"><%= item.requested_game %></span>
                        </div>
                        <div class="od-pedido-field">
                          <span class="k"><%= t("admin.orders.detail.request_notes") %></span>
                          <span class="v<%= " is-empty" if item.request_notes.blank? %>"><%= item.request_notes.presence || t("admin.orders.detail.request_notes_blank") %></span>
                        </div>
                      </div>
                    <% end %>
                    <div class="qty"><%= item.quantity %> × <%= format_brl(item.unit_price_cents) %></div>
                  </div>
                  <div class="od-item-line"><%= format_brl(item.line_total_cents) %></div>
                </div>
              <% end %>
            </div>
            <div class="od-totals">
              <div class="row-t"><span><%= t("admin.orders.detail.subtotal") %></span><span><%= format_brl(@presenter.subtotal_cents) %></span></div>
              <div class="row-t"><span><%= t("admin.orders.detail.shipping", service: @presenter.shipping_service_label) %></span><span><%= format_brl(@presenter.shipping_cents) %></span></div>
              <div class="row-t row-total"><span><%= t("admin.orders.detail.total") %></span><span><%= format_brl(@presenter.total_cents) %></span></div>
            </div>
          </div>
          <% end %>

          <div class="panel">
            <% address = @presenter.merged? ? nil : @presenter.address %>
            <div class="od-meta-grid">
              <% if address %>
              <div class="od-meta">
                <div class="od-meta-head"><i class="bi bi-geo-alt"></i> <%= t("admin.orders.detail.address") %></div>
                <div class="od-meta-body">
                  <div class="strong"><%= address[:recipient] %></div>
                  <div><%= address[:street] %>, <%= address[:number] %><% if address[:complement].present? %>, <%= address[:complement] %><% end %></div>
                  <div><%= address[:neighborhood] %></div>
                  <div><%= address[:city] %> · <%= address[:state] %> · CEP <%= number_to_cep(address[:zip]) %></div>
                  <% if @presenter.receiver_obs.present? %>
                    <div class="od-note">
                      <i class="bi bi-chat-left-text"></i>
                      <span><span class="od-note-label"><%= t("admin.orders.detail.correios_note") %></span><%= @presenter.receiver_obs %></span>
                    </div>
                  <% end %>
                </div>
              </div>
              <% end %>
              <div class="od-meta">
                <div class="od-meta-head"><i class="bi bi-wallet2"></i> <%= t("admin.orders.detail.payment") %></div>
                <div class="od-meta-body">
                  <% payment = @presenter.payment %>
                  <div class="od-pay"><i class="bi <%= payment.icon %>"></i> <%= payment.method_label %></div>
                  <div class="od-pay-status <%= payment.status_class %>">
                    <i class="bi <%= payment.status_icon %>"></i>
                    <%= payment.status_label %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <% if @presenter.observation.present? %>
            <div class="panel">
              <div class="od-meta">
                <div class="od-meta-head"><i class="bi bi-chat-left-text"></i> <%= t("admin.orders.detail.observation") %></div>
                <div class="od-meta-body"><div class="od-obs-text"><%= @presenter.observation %></div></div>
              </div>
            </div>
          <% end %>

          <% if @presenter.shipping_visible? %>
            <div class="panel">
              <div class="panel-top">
                <div class="panel-top-main">
                  <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.orders.detail.tracking") %></h2>
                </div>
                <% if @presenter.tracking_code.present? %>
                  <div class="panel-top-right">
                    <span class="od-track-code" data-tracking-code><%= @presenter.tracking_code %></span>
                    <a class="od-track-link" href="<%= @presenter.tracking_url %>" target="_blank" rel="noopener">
                      <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                      <span><%= t("admin.orders.detail.tracking_external") %></span>
                    </a>
                  </div>
                <% end %>
              </div>
              <div class="od-track">
                <% @presenter.tracking_events.each_with_index do |event, index| %>
                  <div class="od-track-item<%= " is-current" if index.zero? %>">
                    <span class="od-track-dot"></span>
                    <div class="od-track-body">
                      <div>
                        <div class="desc"><%= event.summary %></div>
                        <% if event.detail %>
                          <div class="meta"><%= event.detail %></div>
                        <% end %>
                        <% if event.posting_unit %>
                          <div class="meta"><%= event.posting_unit %></div>
                        <% end %>
                        <% if event.destination %>
                          <div class="meta"><%= t("admin.orders.detail.destination") %>: <%= event.destination %></div>
                        <% end %>
                      </div>
                      <div class="time"><%= l(event.occurred_at, format: :short) %></div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="panel">
            <div class="panel-top">
              <div class="panel-top-main">
                <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.orders.detail.history") %></h2>
              </div>
            </div>
            <%= render "history", presenter: @presenter %>
          </div>
        </div>

        <aside class="od-col-side">
          <section class="status-card">
            <div class="status-card-top">
              <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.orders.detail.status_section") %></h2>
            </div>
            <%= render "status_card", presenter: @presenter %>
          </section>

          <section class="cust-card">
            <% customer = @presenter.customer %>
            <div class="cust-top">
              <div class="cust-av cust-av--<%= @presenter.avatar_tint_index %>"><%= account_avatar_initials(customer.full_name) %></div>
              <div class="cust-meta">
                <div class="nm"><%= customer.full_name %></div>
                <div class="sub"><%= t("admin.orders.detail.customer_since", date: l(customer.created_at.to_date, format: :long)) %></div>
              </div>
            </div>
            <div class="cust-rows">
              <div class="cust-row"><i class="bi bi-envelope"></i> <span class="v"><%= customer.email %></span></div>
              <div class="cust-row"><i class="bi bi-telephone"></i> <span class="v"><%= @presenter.customer_phone %></span></div>
              <div class="cust-row"><i class="bi bi-person-vcard"></i> <span class="v"><%= @presenter.customer_cpf %></span></div>
              <% if address %>
              <div class="cust-row"><i class="bi bi-geo"></i> <span class="v"><%= address[:city] %>/<%= address[:state] %></span></div>
              <% end %>
            </div>
          </section>
        </aside>
      </div>
    </main>
  </div>
</div>

<% content_for :scripts do %>
  <%= javascript_import_module_tag "backoffice/order" %>
<% end %>
