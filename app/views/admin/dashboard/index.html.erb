<% content_for :title, t("admin.dashboard.title") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "vendor/bootstrap-icons" %>
  <%= stylesheet_link_tag "base/tokens", "base/animations", "pages/backoffice-shell", "pages/backoffice-dashboard" %>
<% end %>

<div class="app-rainbow" aria-hidden="true"></div>

<div class="app" data-dashboard="<%= @dashboard.to_json %>" data-order-base="/admin/pedidos/" data-bulk-url="<%= admin_bulk_transitions_path %>" data-print-url="<%= admin_print_labels_path %>">
  <%= render "admin/sidebar", active: "orders" %>

  <div class="main">
    <header class="topbar">
      <button class="icon-btn" id="menu-toggle" type="button" aria-label="<%= t("admin.dashboard.menu") %>"><i class="bi bi-list"></i></button>
      <div class="topbar-head">
        <h1 id="page-title"><%= t("admin.dashboard.views.orders.title") %></h1>
        <span class="crumb" id="page-crumb"><%= t("admin.dashboard.views.orders.crumb") %></span>
      </div>
      <div class="topbar-right">
        <div class="gsearch">
          <i class="bi bi-search"></i>
          <input id="gsearch" type="text" placeholder="<%= t("admin.dashboard.search_placeholder") %>" aria-label="<%= t("admin.dashboard.search_aria") %>">
        </div>
        <button class="icon-btn" type="button" aria-label="<%= t("admin.dashboard.notifications") %>"><i class="bi bi-bell"></i><span class="dot"></span></button>
      </div>
    </header>

    <main class="content">
      <section class="view" data-view="orders">
        <div class="panel">
          <div class="panel-top">
            <div class="panel-top-main">
              <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.dashboard.orders.heading") %></h2>
              <div class="sub"><%= t("admin.dashboard.orders.sub") %></div>
            </div>
            <div class="panel-top-right">
              <span class="result-count" id="orders-count"></span>
              <a class="btn-ghost" id="gen-production" href="<%= admin_production_report_path %>" data-base="<%= admin_production_report_path %>"><i class="bi bi-printer"></i> <%= t("admin.dashboard.orders.production_report") %></a>
              <button class="btn-ghost" type="button"><i class="bi bi-download"></i> <%= t("admin.dashboard.orders.export") %></button>
            </div>
          </div>

          <div class="filters">
            <div class="fgroup fgrow">
              <label for="o-name"><%= t("admin.dashboard.orders.filters.query") %></label>
              <div class="f-input">
                <i class="bi bi-search"></i>
                <input id="o-name" type="text" placeholder="<%= t("admin.dashboard.orders.filters.query_placeholder") %>">
              </div>
            </div>

            <div class="fgroup fgroup--pop">
              <label><%= t("admin.dashboard.orders.filters.period") %></label>
              <div class="f-trigger" id="date-trigger" data-pop>
                <i class="bi bi-calendar3"></i>
                <span class="val placeholder"><%= t("admin.dashboard.orders.filters.period_any") %></span>
                <button id="date-clear" class="icon-clear" type="button" aria-label="<%= t("admin.dashboard.orders.filters.period_clear") %>" hidden><i class="bi bi-x-circle-fill"></i></button>
                <i class="bi bi-chevron-down chev"></i>
              </div>
              <div class="pop dp" id="date-pop"></div>
            </div>

            <div class="fgroup fgroup--pop">
              <label><%= t("admin.dashboard.orders.filters.status") %></label>
              <div class="f-trigger f-trigger--status" id="status-trigger" data-pop>
                <i class="bi bi-funnel"></i>
                <span class="val placeholder"><%= t("admin.dashboard.orders.filters.status_all") %></span>
                <span class="pillnum" hidden>0</span>
                <i class="bi bi-chevron-down chev"></i>
              </div>
              <div class="pop pop--status" id="status-pop"></div>
            </div>

            <div class="fgroup">
              <label>&nbsp;</label>
              <button class="btn-clear" id="o-clear" type="button"><i class="bi bi-arrow-counterclockwise"></i> <%= t("admin.dashboard.orders.filters.clear") %></button>
            </div>
          </div>

          <div class="bulkbar" id="bulkbar" hidden>
            <div class="bulk-left">
              <span class="bulk-count"><b id="bulk-n">0</b> <%= t("admin.dashboard.bulk.selected") %></span>
              <button class="bulk-clear" id="bulk-clear" type="button"><i class="bi bi-x-lg"></i> <%= t("admin.dashboard.bulk.clear") %></button>
            </div>
            <div class="bulk-actions" id="bulk-actions"></div>
            <button class="bulk-chip bulk-print" id="bulk-print" type="button" hidden>
              <i class="bi bi-printer"></i> <%= t("admin.dashboard.bulk.print_labels") %>
            </button>
          </div>

          <div class="tbl-wrap">
            <table class="tbl" id="orders-table">
              <thead>
                <tr>
                  <th class="checkcol"><span class="rowcheck" id="o-checkall" role="checkbox" aria-label="<%= t("admin.dashboard.orders.select_all") %>" tabindex="0"></span></th>
                  <th><%= t("admin.dashboard.orders.columns.order") %></th>
                  <th class="sortable" data-key="client"><%= t("admin.dashboard.orders.columns.client") %> <span class="sortarrow"></span></th>
                  <th class="sortable sorted" data-key="date"><%= t("admin.dashboard.orders.columns.date") %> <span class="sortarrow">▼</span></th>
                  <th class="sortable" data-key="status"><%= t("admin.dashboard.orders.columns.status") %> <span class="sortarrow"></span></th>
                  <th class="num sortable" data-key="total"><%= t("admin.dashboard.orders.columns.total") %> <span class="sortarrow"></span></th>
                  <th class="num"></th>
                </tr>
              </thead>
              <tbody id="orders-body"></tbody>
            </table>
            <div class="empty" id="orders-empty">
              <i class="bi bi-receipt-cutoff"></i>
              <p><%= t("admin.dashboard.orders.empty.title") %></p>
              <span><%= t("admin.dashboard.orders.empty.hint") %></span>
            </div>
          </div>
        </div>
      </section>

      <section class="view" data-view="clients" hidden>
        <div class="panel">
          <div class="panel-top">
            <div class="panel-top-main">
              <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.dashboard.clients.heading") %></h2>
              <div class="sub"><%= t("admin.dashboard.clients.sub") %></div>
            </div>
            <div class="panel-top-right">
              <span class="result-count" id="clients-count"></span>
              <div class="gsearch">
                <i class="bi bi-search"></i>
                <input id="c-q" type="text" class="gsearch__input--wide" placeholder="<%= t("admin.dashboard.clients.search_placeholder") %>">
              </div>
            </div>
          </div>

          <div class="tbl-wrap">
            <table class="tbl" id="clients-table">
              <thead>
                <tr>
                  <th class="sortable" data-key="name"><%= t("admin.dashboard.clients.columns.client") %> <span class="sortarrow"></span></th>
                  <th class="sortable" data-key="cpf"><%= t("admin.dashboard.clients.columns.cpf") %> <span class="sortarrow"></span></th>
                  <th><%= t("admin.dashboard.clients.columns.phone") %></th>
                  <th class="sortable" data-key="city"><%= t("admin.dashboard.clients.columns.city") %> <span class="sortarrow"></span></th>
                  <th class="sortable" data-key="since"><%= t("admin.dashboard.clients.columns.since") %> <span class="sortarrow"></span></th>
                  <th class="num sortable" data-key="orders"><%= t("admin.dashboard.clients.columns.orders") %> <span class="sortarrow"></span></th>
                  <th class="sortable" data-key="status"><%= t("admin.dashboard.clients.columns.situation") %> <span class="sortarrow"></span></th>
                  <th class="num"></th>
                </tr>
              </thead>
              <tbody id="clients-body"></tbody>
            </table>
            <div class="empty" id="clients-empty">
              <i class="bi bi-person-x"></i>
              <p><%= t("admin.dashboard.clients.empty.title") %></p>
              <span><%= t("admin.dashboard.clients.empty.hint") %></span>
            </div>
          </div>
        </div>
      </section>

      <section class="view" data-view="reports" hidden>
        <div class="panel">
          <div class="panel-top">
            <div class="panel-top-main">
              <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.dashboard.reports.heading") %></h2>
              <div class="sub"><%= t("admin.dashboard.reports.sub") %></div>
            </div>
            <div class="panel-top-right">
              <span class="result-count" id="reports-count"></span>
            </div>
          </div>

          <div class="tbl-wrap">
            <table class="tbl" id="reports-table">
              <thead>
                <tr>
                  <th><%= t("admin.dashboard.reports.columns.generated") %></th>
                  <th><%= t("admin.dashboard.reports.columns.operator") %></th>
                  <th><%= t("admin.dashboard.reports.columns.period") %></th>
                  <th class="num"><%= t("admin.dashboard.reports.columns.orders") %></th>
                  <th class="num"></th>
                </tr>
              </thead>
              <tbody id="reports-body"></tbody>
            </table>
            <div class="empty" id="reports-empty">
              <i class="bi bi-printer"></i>
              <p><%= t("admin.dashboard.reports.empty.title") %></p>
              <span><%= t("admin.dashboard.reports.empty.hint") %></span>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>

<div class="toasts" id="toasts" aria-live="polite"></div>

<% content_for :scripts do %>
  <%= javascript_include_tag "backoffice/dashboard", type: "module" %>
<% end %>
