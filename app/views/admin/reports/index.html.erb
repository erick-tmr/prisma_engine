<% content_for :title, t("admin.dashboard.title") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "vendor/bootstrap-icons" %>
  <%= stylesheet_link_tag "base/tokens", "base/animations", "pages/backoffice-shell", "pages/backoffice-dashboard" %>
<% end %>

<div class="app-rainbow" aria-hidden="true"></div>

<div class="app" data-list="reports">
  <%= render "admin/sidebar", active: "reports" %>

  <div class="main">
    <header class="topbar">
      <button class="icon-btn" id="menu-toggle" type="button" aria-label="<%= t("admin.dashboard.menu") %>"><i class="bi bi-list"></i></button>
      <div class="topbar-head">
        <h1><%= t("admin.dashboard.views.reports.title") %></h1>
        <span class="crumb"><%= t("admin.dashboard.views.reports.crumb") %></span>
      </div>
      <div class="topbar-right">
        <button class="icon-btn" type="button" aria-label="<%= t("admin.dashboard.notifications") %>"><i class="bi bi-bell"></i><span class="dot"></span></button>
      </div>
    </header>

    <main class="content">
      <div class="panel">
        <div class="panel-top">
          <div class="panel-top-main">
            <h2><span class="rbar" aria-hidden="true"></span> <%= t("admin.dashboard.reports.heading") %></h2>
            <div class="sub"><%= t("admin.dashboard.reports.sub") %></div>
          </div>
          <div class="panel-top-right">
            <%= render "results_count" %>
          </div>
        </div>

        <%= render "results_table" %>
      </div>
    </main>
  </div>
</div>

<div class="toasts" id="toasts" aria-live="polite"></div>

<% content_for :scripts do %>
  <%= javascript_import_module_tag "backoffice/reports" %>
<% end %>
