<%# locals: (order:) %>
<tr data-order="<%= order.number %>">
  <td><a class="cell-mono cell-link" href="<%= admin_order_path(order) %>"><%= order.number %></a></td>
  <td class="cell-num"><%= l(order.created_at.to_date, format: :list) %></td>
  <td class="cell-num"><%= t("admin.lists.items", count: order.order_items.sum(&:quantity)) %></td>
  <td class="num"><span class="amount"><%= format_brl(order.total_cents) %></span></td>
  <td><span class="pill st-<%= order.status %>"><%= t("account.orders.states.#{order.status}.label") %></span></td>
  <td class="num"><i class="bi bi-chevron-right row-chev"></i></td>
</tr>
