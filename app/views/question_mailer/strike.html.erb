<%= render layout: "shared/email_card", locals: {
      badge_label: t("question_mailer.strike.#{@ban.penalty}.badge_label"),
      badge_color: @theme[:accent],
      hero_image: @theme[:hero],
      hero_height: 180,
      heading: t("question_mailer.strike.#{@ban.penalty}.heading"),
      first_name: @strike.user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("question_mailer.strike.#{@ban.penalty}.intro_html") %>
    </td>
  </tr>
  <%= render "shared/email_quote_card",
             eyebrow: t("question_mailer.strike.removed_question"),
             eyebrow_color: @theme[:accent],
             accent: @theme[:accent],
             quote: @question.body,
             meta_lines: [ t("question_mailer.strike.removed_product_html", product: @question.product.name),
                           t("question_mailer.sent_meta_html",
                             sent_at: email_datetime(@question.created_at),
                             protocol: @question.id) ] %>
  <%= render "shared/email_panel",
             background: @theme[:panel_background],
             border: @theme[:panel_border],
             title_color: @theme[:accent],
             title: t("question_mailer.strike.#{@ban.penalty}.title"),
             text: t("question_mailer.strike.#{@ban.penalty}.text_html",
                     date: @blocked_until,
                     first_date: email_date(@ban.ladder.first[:reached_at])) %>
  <%= render "strike_progress", rungs: @ban.ladder, accent: @theme[:accent],
             caption: t("question_mailer.strike.#{@ban.penalty}.progress") %>
  <% if @ban.final_warning? %>
    <%= render "shared/email_panel",
               background: "#fdf0f0",
               border: "#f5cfcf",
               title_color: "#b3261e",
               title: t("question_mailer.strike.second.next_title"),
               text: t("question_mailer.strike.second.next_text") %>
  <% end %>
  <% if @ban.permanent? %>
    <%= render "strike_ladder", rungs: @ban.ladder, highlight: @ban.penalty, accent: @theme[:accent] %>
  <% end %>
  <tr>
    <td class="px" style="padding:16px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.55;color:#6b7280;">
      <%= t("question_mailer.strike.rules") %>
    </td>
  </tr>
  <%= render "shared/email_cta", url: "mailto:#{t('mailer.support_email')}",
             label: t("question_mailer.strike.cta") %>
  <tr>
    <td class="px" style="padding:16px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.55;color:#6b7280;">
      <%= t("question_mailer.strike.#{@ban.penalty}.outro") %>
    </td>
  </tr>
<% end %>
