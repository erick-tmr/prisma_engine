<%= render layout: "shared/email_card", locals: {
      badge_label: t("question_mailer.answered.badge_label"),
      badge_color: "#007bff",
      hero_image: "dragon-letter-full.png",
      hero_height: 180,
      heading: t("question_mailer.answered.heading"),
      first_name: @question.user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("question_mailer.answered.intro_html", product: @product.name) %>
    </td>
  </tr>
  <%= render "shared/email_quote_card",
             eyebrow: t("question_mailer.answered.your_question"),
             eyebrow_color: "#9aa0a8",
             accent: "#e5e7eb",
             quote: @question.body,
             meta_lines: [ t("question_mailer.sent_meta_html",
                             sent_at: email_datetime(@question.created_at),
                             protocol: @question.id) ] %>
  <%= render "shared/email_quote_card",
             top: 12,
             background: "#eef6ff",
             border: "#cfe4ff",
             eyebrow: t("question_mailer.answered.our_answer", store: t("products.questions.store_name")),
             eyebrow_color: "#007bff",
             quote: @question.answer_body,
             meta_lines: [ t("question_mailer.answered.answer_meta",
                             store: t("products.questions.store_name"),
                             date: email_date(@question.answered_at)) ] %>
  <%= render "shared/email_cta", url: product_url(@product, anchor: "perguntas"),
             label: t("question_mailer.answered.cta") %>
  <tr>
    <td class="px" style="padding:16px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.55;color:#6b7280;">
      <%= t("question_mailer.answered.closing_note") %>
    </td>
  </tr>
<% end %>
