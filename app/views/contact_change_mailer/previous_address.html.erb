<%= render layout: "shared/email_card", locals: {
      badge_label: t("contact_change_mailer.badge_label"),
      badge_color: "#007bff",
      hero_image: "dragon-face.png",
      hero_height: 180,
      heading: t("contact_change_mailer.previous_address.heading"),
      first_name: @user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("contact_change_mailer.previous_address.intro") %>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:16px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;">
      <div style="background:#f6f7f8;border-radius:10px;padding:12px 16px;font-size:13px;color:#6b7280;line-height:1.6;"><%= t("contact_change_mailer.previous_address.new_email_label") %> <span style="color:#1a1d21;font-weight:700;"><%= @user.email %></span></div>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:16px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.55;color:#6b7280;">
      <%= t("contact_change_mailer.disclaimer") %>
    </td>
  </tr>
<% end %>
