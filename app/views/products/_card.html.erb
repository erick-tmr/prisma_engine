<%# locals: (product:) %>
<div class="col-6 col-md-3 mb-4">
  <%= link_to product_path(slug: product.slug), class: "product-card" do %>
    <div class="product-card__thumb<%= " product-card__thumb--ph" unless product.image.present? %>">
      <span class="product-card__wishlist" aria-hidden="true"><i class="bi bi-heart"></i></span>
      <% if product.image.present? %>
        <img src="<%= product.image %>" alt="<%= product.title %>" width="600" height="400" loading="lazy">
      <% else %>
        <span class="product-card__ph-label">Foto em breve</span>
      <% end %>
    </div>
    <div class="product-card__body">
      <p class="product-card__cat"><%= product.category_label %></p>
      <p class="product-card__title"><%= product.title %></p>
      <p class="product-card__price"><%= product.price_formatted %></p>
    </div>
  <% end %>
</div>
