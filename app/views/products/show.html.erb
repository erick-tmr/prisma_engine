<% content_for :title, "#{@product.title} — Prisma Games" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "components/variant", "components/mes-pill", "pages/product" %>
<% end %>

<% photos = @product.product_photos.in_display_order.select { |p| p.image.attached? } %>
<% main_src = photos.first ? Storefront::ImageSource.call(photos.first.image) : @product.image %>

<div class="pdp">
  <%= render "shared/breadcrumb",
        crumbs: [["Início", root_path], ["Catálogo", products_path],
                 [@product.category_label, category_path(slug: @product.category.slug)]],
        current: @product.title %>

  <div class="pdp-grid">
    <div class="gallery">
      <div class="gallery-main">
        <% if main_src.present? %>
          <a href="<%= main_src %>" class="gallery-main__zoom" data-fancybox="product-gallery" data-main-zoom>
            <img src="<%= main_src %>" alt="<%= @product.title %>" data-main-img>
          </a>
        <% end %>
      </div>

      <% if photos.size > 1 %>
        <div class="gallery-thumbs">
          <% photos.each_with_index do |photo, index| %>
            <% src = Storefront::ImageSource.call(photo.image) %>
            <button type="button" class="thumb<%= ' is-selected' if index.zero? %>" data-thumb data-src="<%= src %>">
              <img src="<%= src %>" alt="<%= photo.alt_text.presence || @product.title %>">
              <% if photo.alt_text.present? %><span class="thumb__tag"><%= photo.alt_text %></span><% end %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="buy">
      <div class="buy__eyebrow">
        <span class="buy__cat"><%= @product.category_label %></span>
        <% if @gotm %>
          <span class="mes-pill"><i class="bi bi-stars"></i> Jogo do Mês · <%= gotm_month_name(@gotm.month) %> <%= @gotm.year %></span>
        <% end %>
      </div>

      <h1 class="buy__title"><%= @product.title %></h1>

      <% if @gotm %>
        <section class="mes-panel" aria-label="Jogo do Mês">
          <div class="mes-panel__head">
            <h2 class="mes-panel__title">É o Jogo do Mês na Prisma</h2>
            <span class="mes-panel__month">Edição de <%= gotm_month_name(@gotm.month) %> · <%= @gotm.year %></span>
          </div>
          <p class="mes-panel__lead">Todo mês elegemos um clássico e mandamos junto um <b>kit de brindes colecionáveis</b> — sem custo extra.</p>
          <% brindes = @gotm_product.brindes.in_display_order %>
          <% if brindes.any? %>
            <div class="mes-incl">
              <% brindes.each do |brinde| %>
                <span><i class="bi bi-check2"></i> <%= brinde.caption %></span>
              <% end %>
            </div>
          <% end %>
          <div class="mes-deadline" data-gotm-countdown data-gotm-year="<%= @gotm.year %>" data-gotm-month="<%= @gotm.month %>">
            <i class="bi bi-clock-history"></i>
            <span>Os brindes acompanham o jogo <b>enquanto for o destaque do mês</b> — <b data-countdown-text>termina em breve</b>.</span>
          </div>
        </section>
      <% end %>

      <div class="price-box">
        <span class="price-now tnum" data-price><%= @product.price_formatted %></span>
      </div>

      <%= form_with url: cart_items_path, method: :post, local: true,
            data: { pdp_form: true, base_cents: @product.price_cents } do %>
        <%= hidden_field_tag :product_id, @product.id %>

        <% grouped_options = @product.product_options.in_display_order.group_by(&:group_name) %>
        <% grouped_options.each do |group_name, opts| %>
          <% default = opts.first %>
          <%= hidden_field_tag "option_ids[]", default.id, data: { variant_group: group_name } %>
          <div class="variant-group">
            <div class="variant-group__label">
              <i class="bi <%= variant_group_icon(group_name) %>"></i><%= group_name %>
              <span class="variant-group__sel" data-vsel="<%= group_name %>"><%= default.name %></span>
            </div>
            <div class="variant-pills">
              <% opts.each do |opt| %>
                <% flag = variant_option_flag(opt.name) %>
                <button type="button" class="variant-pill<%= ' is-selected' if opt.id == default.id %>"
                        data-vpill data-vgroup="<%= group_name %>" data-vopt="<%= opt.id %>" data-vname="<%= opt.name %>">
                  <%= opt.name %><%= " #{flag}" if flag %>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @product.custom_order? %>
          <div class="pedido-box" data-pedido-box>
            <div class="pedido-box__head">
              <i class="bi bi-card-checklist"></i>
              <h2 class="pedido-box__title">Detalhes do seu pedido</h2>
            </div>
            <p class="pedido-box__sub">Produto sob encomenda. Diga qual jogo você quer que a gente produza.</p>
            <div class="pedido-box__field">
              <label for="pedido-game">Nome do jogo <span class="pedido-box__req">*</span></label>
              <%= text_field_tag "request[game]", nil,
                    id: "pedido-game", class: "pedido-box__input", maxlength: 120,
                    autocomplete: "off", placeholder: "Ex.: Pokémon Unbound (romhack)",
                    data: { pedido_game: true } %>
              <p class="pedido-box__error">Informe o nome do jogo que você quer encomendar.</p>
              <p class="pedido-box__hint">Digite o título exato do jogo ou romhack que você quer encomendar.</p>
            </div>
            <div class="pedido-box__field">
              <label for="pedido-obs">Observações <span class="pedido-box__opt">opcional</span></label>
              <%= text_area_tag "request[notes]", nil,
                    id: "pedido-obs", class: "pedido-box__input pedido-box__textarea",
                    maxlength: 500, rows: 3,
                    placeholder: "Versão ou patch específico, link de referência, região, prazo desejado." %>
            </div>
          </div>
        <% end %>

        <div class="buy__actions">
          <div class="stepper">
            <button type="button" class="stepper__btn" data-dec aria-label="Diminuir" disabled><i class="bi bi-dash"></i></button>
            <input type="number" class="stepper__input" name="quantity" value="1" min="1" max="99" data-qty aria-label="Quantidade">
            <button type="button" class="stepper__btn" data-inc aria-label="Aumentar"><i class="bi bi-plus"></i></button>
          </div>
          <button type="submit" class="pdp-btn pdp-btn--dark"><i class="bi bi-cart-plus"></i> Adicionar ao carrinho</button>
        </div>
      <% end %>

      <a href="https://wa.me/5535920001100?text=<%= u("Olá! Tenho interesse em #{@product.title}") %>" target="_blank" rel="noopener" class="pdp-btn pdp-btn--wa">
        <i class="bi bi-whatsapp"></i> Tirar dúvidas no WhatsApp
      </a>

      <div class="trust">
        <div><i class="bi bi-shield-check"></i> Produzido no Brasil com garantia</div>
        <div><i class="bi bi-floppy"></i> Save em FRAM (não precisa de bateria)</div>
        <div><i class="bi bi-truck"></i> Correios · PAC, SEDEX e Mini Envios</div>
        <div><i class="bi bi-credit-card-2-front"></i> Pix ou cartão</div>
      </div>
    </div>
  </div>

  <% if @product.description.present? %>
    <section class="descr" aria-label="Descrição do produto">
      <h2 class="descr__title">Descrição</h2>
      <p class="descr__sub">Tudo sobre este cartucho</p>
      <div class="descr__body"><%= product_description @product.description %></div>
    </section>
  <% end %>

  <% if @gotm_product %>
    <%= render "products/gotm_freebies", gotm_product: @gotm_product %>
  <% end %>
</div>

<% content_for :scripts do %>
  <%= javascript_include_tag "storefront/pdp", type: "module" %>
<% end %>
