<% content_for :head do %>
  <%= stylesheet_link_tag "pages/account" %>
<% end %>

<% content_for :main do %>
  <div class="account">
    <div class="account__head">
      <div class="account__avatar"><%= account_avatar_initials(current_user.full_name) %></div>
      <div class="account__head-text">
        <h1><%= t("account.layout.heading") %></h1>
        <p><%= t("account.layout.greeting", name: current_user.first_name) %></p>
      </div>
    </div>

    <div class="account__grid">
      <aside>
        <%= render "account/sidebar" %>
      </aside>
      <section>
        <%= yield %>
      </section>
    </div>
  </div>
<% end %>

<%= render template: "layouts/application" %>
