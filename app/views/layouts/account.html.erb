<% content_for :main do %>
  <div class="account-wrap">
    <div class="account-head">
      <div class="account-avatar"><%= account_avatar_initials(current_user.full_name) %></div>
      <div class="account-head-text">
        <h1><%= t("account.layout.heading") %></h1>
        <p><%= t("account.layout.greeting", name: current_user.first_name) %></p>
      </div>
    </div>

    <div class="account-grid">
      <aside>
        <%= render "account/sidebar" %>
      </aside>
      <section>
        <%= yield %>
      </section>
    </div>
  </div>
<% end %>

<%= render template: "layouts/application" %>
