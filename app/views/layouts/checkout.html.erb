<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title><%= content_for(:title).presence || "Checkout — Prisma Games" %></title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%= yield :head %>
  </head>

  <body class="checkout-body">
    <div class="rainbow-strip"></div>

    <%# Minimal chrome — fewer exit points than the storefront header. %>
    <header class="co-header">
      <div class="co-header-inner">
        <%= link_to "/carrinho", class: "co-logo", "aria-label": "Prisma Games" do %>
          <img src="/images/stores/uploads/2359718/prisma-games.png" alt="Prisma Games">
        <% end %>
        <% unless content_for?(:checkout_bare) %>
          <%= link_to "/carrinho", class: "co-back" do %>
            <i class="bi bi-arrow-left"></i> Voltar ao carrinho
          <% end %>
        <% end %>
        <span class="co-secure"><i class="bi bi-shield-lock-fill"></i> Compra 100% segura</span>
      </div>
    </header>

    <% unless content_for?(:checkout_bare) %>
      <nav class="co-steps" aria-label="Etapas do checkout">
        <div class="co-steps-inner">
          <span class="co-step done"><span class="dot"><i class="bi bi-check-lg"></i></span><span class="lbl">Carrinho</span></span>
          <span class="co-step-sep done"></span>
          <span class="co-step done"><span class="dot"><i class="bi bi-check-lg"></i></span><span class="lbl">Identificação</span></span>
          <span class="co-step-sep done"></span>
          <span class="co-step current"><span class="dot">3</span><span class="lbl">Entrega</span></span>
          <span class="co-step-sep"></span>
          <span class="co-step"><span class="dot">4</span><span class="lbl">Pagamento</span></span>
        </div>
      </nav>
    <% end %>

    <% if flash.any? %>
      <div class="pg-flash co-flash">
        <% flash.each do |key, value| %>
          <% meta = pg_alert_meta(key) %>
          <div class="pg-alert pg-alert-<%= meta[:variant] %>" role="alert">
            <i class="bi <%= meta[:icon] %> pg-alert-ic"></i>
            <div class="pg-alert-body"><%= value %></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>

    <%= yield :scripts %>
  </body>
</html>
