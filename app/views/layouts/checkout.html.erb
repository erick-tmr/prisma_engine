<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title><%= content_for(:title).presence || "Checkout — Prisma Games" %></title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <meta name="theme-color" content="#111214">

    <%= stylesheet_link_tag "vendor/bootstrap.min", "vendor/bootstrap-icons" %>

    <%= stylesheet_link_tag "base/tokens", "base/base", "base/animations",
          "components/field", "components/flash",
          "pages/checkout",
          "data-turbo-track": "reload" %>

    <%= yield :head %>
  </head>

  <body class="checkout-body">
    <div class="checkout-strip"></div>

    <header class="checkout-header">
      <div class="checkout-header__inner">
        <%= link_to "/carrinho", class: "checkout-header__logo", "aria-label": "Prisma Games" do %>
          <img src="/images/prisma-games-logo.png" alt="Prisma Games">
        <% end %>
        <% unless content_for?(:checkout_bare) %>
          <%= link_to "/carrinho", class: "checkout-header__back" do %>
            <i class="bi bi-arrow-left"></i> Voltar ao carrinho
          <% end %>
        <% end %>
        <span class="checkout-header__secure"><i class="bi bi-shield-lock-fill"></i> Compra 100% segura</span>
      </div>
    </header>

    <% unless content_for?(:checkout_bare) %>
      <nav class="checkout-steps" aria-label="Etapas do checkout">
        <div class="checkout-steps__inner">
          <span class="checkout-steps__step checkout-steps__step--done"><span class="checkout-steps__dot"><i class="bi bi-check-lg"></i></span><span class="checkout-steps__label">Carrinho</span></span>
          <span class="checkout-steps__sep checkout-steps__sep--done"></span>
          <span class="checkout-steps__step checkout-steps__step--done"><span class="checkout-steps__dot"><i class="bi bi-check-lg"></i></span><span class="checkout-steps__label">Identificação</span></span>
          <span class="checkout-steps__sep checkout-steps__sep--done"></span>
          <span class="checkout-steps__step checkout-steps__step--current"><span class="checkout-steps__dot">3</span><span class="checkout-steps__label">Entrega</span></span>
          <span class="checkout-steps__sep"></span>
          <span class="checkout-steps__step"><span class="checkout-steps__dot">4</span><span class="checkout-steps__label">Pagamento</span></span>
        </div>
      </nav>
    <% end %>

    <% if flash.any? %>
      <div class="flash-stack">
        <% flash.each do |key, value| %>
          <% meta = pg_alert_meta(key) %>
          <div class="flash flash--<%= meta[:variant] %>" role="alert">
            <i class="bi <%= meta[:icon] %> flash__icon"></i>
            <div class="flash__body"><%= value %></div>
            <button type="button" class="flash__close" aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>

    <%= javascript_include_tag "storefront/flash", type: "module" %>
    <%= yield :scripts %>
  </body>
</html>
