<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <title><%= content_for(:title).presence || OpenGraphHelper::SITE_NAME %></title>
    <meta name="description" content="<%= og_description %>">

    <link rel="canonical" href="<%= canonical_url %>">

    <%= render "shared/open_graph" %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <meta name="theme-color" content="#111214">

    <%= stylesheet_link_tag "vendor/bootstrap.min", "vendor/bootstrap-icons",
          "vendor/owl.carousel.min", "vendor/owl.theme.default.min",
          "vendor/jquery.fancybox.min", "vendor/cookiealert" %>

    <%= stylesheet_link_tag "base/tokens", "base/base", "base/animations",
          "components/header", "components/nav-strip", "components/links-menu",
          "components/drawer", "components/footer", "components/flash",
          "components/section-title", "components/product-card", "components/chip",
          "components/button", "components/field", "components/breadcrumb",
          "components/topic-rail",
          "data-turbo-track": "reload" %>

    <%= yield :head %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <%= render "shared/drawer" %>
    <%= render "shared/header" %>
    <%= render "shared/nav" %>

    <main class="wrapper py-3">
      <% if flash.any? %>
        <div class="flash-stack">
          <% flash.each do |key, value| %>
            <% meta = pg_alert_meta(key) %>
            <div class="flash flash--<%= meta[:variant] %>" role="alert">
              <i class="bi <%= meta[:icon] %> flash__icon"></i>
              <div class="flash__body">
                <%= value %>
                <% if key.to_s == "cart_added" %>
                  <%= link_to cart_path, class: "flash__cta" do %>
                    Ver carrinho <i class="bi bi-arrow-right-short"></i>
                  <% end %>
                <% end %>
              </div>
              <button type="button" class="flash__close" aria-label="Fechar"><i class="bi bi-x-lg"></i></button>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= content_for?(:main) ? yield(:main) : yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "shared/cookie_banner" unless cookies[:acceptCookies] %>

    <%= javascript_include_tag "vendor/jquery.min", "vendor/owl.carousel.min",
          "vendor/jquery.fancybox.min", "vendor/jquery.mask.min",
          "vendor/bootstrap-input-spinner", "vendor/cookiealert" %>

    <%= javascript_tag nonce: true do %>
      $(function () {
        $('.links-menu').each(function () {
          var $wrap    = $(this);
          var $trigger = $wrap.find('[data-links-menu="trigger"]');
          var $panel   = $wrap.find('[data-links-menu="panel"]');

          function open()  { $wrap.addClass('is-open');    $panel.prop('hidden', false); $trigger.attr('aria-expanded', 'true'); }
          function close() { $wrap.removeClass('is-open'); $panel.prop('hidden', true);  $trigger.attr('aria-expanded', 'false'); }

          $trigger.on('click', function (e) {
            e.stopPropagation();
            $wrap.hasClass('is-open') ? close() : open();
          });
          $(document).on('click', function (e) {
            if (!$wrap.is(e.target) && $wrap.has(e.target).length === 0) close();
          });
          $(document).on('keydown', function (e) {
            if (e.key === 'Escape') close();
          });
        });

        var $drawer = $('#site-drawer');
        var $backdrop = $('.drawer__backdrop');

        function openDrawer() {
          $drawer.addClass('is-open').attr('aria-hidden', 'false');
          $backdrop.addClass('is-open');
          $('body').addClass('is-drawer-locked');
        }

        function closeDrawer() {
          $drawer.removeClass('is-open').attr('aria-hidden', 'true');
          $backdrop.removeClass('is-open');
          $('body').removeClass('is-drawer-locked');
        }

        $('[data-toggle="drawer"]').on('click', function (e) {
          e.preventDefault();
          openDrawer();
        });
        $('.drawer__close, [data-drawer-dismiss]').on('click', closeDrawer);
        $(document).on('keydown', function (e) {
          if (e.key === 'Escape' && $drawer.hasClass('is-open')) closeDrawer();
        });

        $('.owl-carousel').each(function () {
          var $el = $(this);
          $el.owlCarousel({
            loop: $el.data('loop') !== false,
            margin: $el.data('margin') || 10,
            nav: $el.data('nav') !== false,
            dots: $el.data('dots') === true,
            autoplay: $el.data('autoplay') === true,
            autoplayTimeout: 5000,
            responsive: {
              0:    { items: $el.data('items-xs') || 2 },
              576:  { items: $el.data('items-sm') || 3 },
              768:  { items: $el.data('items-md') || 4 },
              992:  { items: $el.data('items-lg') || 5 },
              1200: { items: $el.data('items-xl') || 5 }
            }
          });
        });

        $('[data-fancybox]').fancybox({});
        $('input[type="number"][data-spinner]').inputSpinner();
        $('[data-mask-cpf]').mask('000.000.000-00', { reverse: true });
        $('[data-mask-cnpj]').mask('00.000.000/0000-00', { reverse: true });
        $('[data-mask-phone]').mask('(00) 00000-0000');

        // .flash is our brand flash; Bootstrap's data-bs-dismiss looks for
        // .alert, so dismiss is wired directly here.
        $(document).on('click', '.flash__close', function () {
          var $a = $(this).closest('.flash');
          $a.css({ transition: 'opacity .15s ease', opacity: 0 });
          setTimeout(function () { $a.remove(); }, 150);
        });
      });
    <% end %>

    <%= yield :scripts %>
  </body>
</html>
