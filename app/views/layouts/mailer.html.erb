<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <style>
      :root { color-scheme: light; supported-color-schemes: light; }
      body { margin: 0; padding: 0; background-color: #eef1f5; -webkit-text-size-adjust: 100%; }
      img { border: 0; outline: none; -ms-interpolation-mode: bicubic; }
      table { border-collapse: collapse; }
      a { text-decoration: none; }
      @media only screen and (max-width: 600px) {
        .container { width: 100% !important; max-width: 100% !important; border-radius: 0 !important; }
        .px { padding-left: 22px !important; padding-right: 22px !important; }
        .heropad { padding-left: 16px !important; padding-right: 16px !important; }
        .h1 { font-size: 22px !important; line-height: 1.25 !important; }
        .hero-img { height: 132px !important; }
        .stack { display: block !important; width: 100% !important; }
        .price { text-align: left !important; white-space: normal !important; padding-top: 0 !important; padding-bottom: 12px !important; font-weight: 700 !important; }
        .item { padding-bottom: 2px !important; }
        .btn a { display: block !important; text-align: center !important; }
      }
    </style>
  </head>

  <body style="margin:0;background-color:#eef1f5;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#eef1f5;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <%= yield %>

          <% unless content_for?(:mailer_footer_rendered) %>
            <hr style="margin-top: 24px; border: 0; border-top: 1px solid #e9ecef;">
            <p style="font-size: 12px; color: #6c757d;">
              <%= t("mailer.help_footer_html", email: t("mailer.support_email")) %>
            </p>
          <% end %>
        </td>
      </tr>
    </table>
  </body>
</html>
