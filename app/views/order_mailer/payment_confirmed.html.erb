<%= render layout: "shared/email_card", locals: {
      badge_label: t("order_mailer.payment_confirmed.badge_label"),
      badge_color: "#0f9d58",
      hero_image: "dragon-fly.png",
      hero_height: 150,
      heading: t("order_mailer.payment_confirmed.heading"),
      first_name: @order.user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.payment_confirmed.intro") %>
    </td>
  </tr>
  <%= render "shared/email_steps", current: 0 %>
  <%= render "summary", shipping_service: @order.shipment.service_label %>
  <%= render "shared/email_cta", url: account_order_url(@order), label: t("order_mailer.payment_confirmed.cta") %>
<% end %>
