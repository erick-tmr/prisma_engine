<%= render layout: "shared/email_card", locals: {
      badge_label: t("order_mailer.awaiting_return.badge_label"),
      badge_color: "#b9650a",
      hero_image: "dragon-letter-full.png",
      hero_height: 180,
      heading: t("order_mailer.awaiting_return.heading"),
      first_name: @order.user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.awaiting_return.intro") %>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.awaiting_return.assembly") %>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:16px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #f0d9b8;border-radius:12px;background:#fdf8f0;">
        <tr>
          <td style="padding:14px 16px;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#7a4a12;">
            <%= t("order_mailer.awaiting_return.tip") %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.awaiting_return.pending_note") %>
    </td>
  </tr>
  <%= render "summary" %>
  <%= render "shared/email_cta", url: account_order_url(@order), label: t("order_mailer.awaiting_return.cta") %>
<% end %>
