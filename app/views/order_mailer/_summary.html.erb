<h2 style="font-size: 16px; color: #212529;"><%= t("order_mailer.summary_heading") %></h2>

<p style="margin: 0 0 12px;">
  <strong><%= t("order_mailer.order_label") %>:</strong> <%= @order.number %>
</p>

<table role="presentation" width="100%" style="border-collapse: collapse; margin-bottom: 12px;">
  <% @order.order_items.each do |item| %>
    <tr>
      <td style="padding: 4px 0;"><%= item.quantity %>x <%= item.name %></td>
      <td style="padding: 4px 0; text-align: right; white-space: nowrap;"><%= format_brl(item.line_total_cents) %></td>
    </tr>
  <% end %>
</table>

<table role="presentation" width="100%" style="border-collapse: collapse; border-top: 1px solid #e9ecef;">
  <tr>
    <td style="padding: 4px 0;"><%= t("order_mailer.subtotal") %></td>
    <td style="padding: 4px 0; text-align: right;"><%= format_brl(@order.subtotal_cents) %></td>
  </tr>
  <tr>
    <td style="padding: 4px 0;"><%= t("order_mailer.shipping") %></td>
    <td style="padding: 4px 0; text-align: right;"><%= format_brl(@order.total_cents - @order.subtotal_cents) %></td>
  </tr>
  <tr>
    <td style="padding: 4px 0;"><strong><%= t("order_mailer.total") %></strong></td>
    <td style="padding: 4px 0; text-align: right;"><strong><%= format_brl(@order.total_cents) %></strong></td>
  </tr>
</table>
