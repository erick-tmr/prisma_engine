<%# locals: (shipping_service:) %>
<% shipping_label = t("order_mailer.shipping_with_service", service: shipping_service) %>
<tr>
  <td class="px" style="padding:22px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e5e7eb;border-radius:12px;">
      <tr>
        <td style="padding:16px 18px 6px;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;">
          <div style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#6b7280;font-weight:700;"><%= t("order_mailer.summary_heading") %></div>
          <div style="font-size:15px;font-weight:700;color:#1a1d21;margin-top:4px;"><%= t("order_mailer.order_label") %> <%= @order.number %></div>
        </td>
      </tr>
      <tr>
        <td style="padding:0 18px;">
          <% @order.order_items.each do |item| %>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="stack item" style="padding:7px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;color:#1a1d21;vertical-align:top;"><%= item.quantity %>x <%= item.name %></td>
                <td class="stack price" style="padding:7px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;color:#1a1d21;text-align:right;white-space:nowrap;vertical-align:top;"><%= format_brl(item.line_total_cents) %></td>
              </tr>
            </table>
          <% end %>
        </td>
      </tr>
      <tr>
        <td style="padding:6px 18px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #e5e7eb;">
            <tr>
              <td style="padding:9px 0 3px;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;color:#6b7280;"><%= t("order_mailer.subtotal") %></td>
              <td style="padding:9px 0 3px;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;color:#6b7280;text-align:right;"><%= format_brl(@order.subtotal_cents) %></td>
            </tr>
            <tr>
              <td style="padding:3px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;color:#6b7280;"><%= shipping_label %></td>
              <td style="padding:3px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;color:#6b7280;text-align:right;"><%= format_brl(@order.total_cents - @order.subtotal_cents) %></td>
            </tr>
            <tr>
              <td style="padding:6px 0 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:16px;font-weight:800;color:#1a1d21;"><%= t("order_mailer.total") %></td>
              <td style="padding:6px 0 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:16px;font-weight:800;color:#1a1d21;text-align:right;"><%= format_brl(@order.total_cents) %></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </td>
</tr>
