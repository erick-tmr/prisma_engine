<%= render layout: "shared/email_card", locals: {
      badge_label: t("order_mailer.returned.badge_label"),
      badge_color: "#b9650a",
      hero_image: "dragon-face.png",
      hero_height: 180,
      heading: t("order_mailer.returned.#{@kind}.heading"),
      first_name: @order.user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.returned.#{@kind}.intro") %>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.returned.#{@kind}.next_step") %>
    </td>
  </tr>
  <%= render "summary", shipping_service: @order.shipment.service_label %>
  <%= render "shared/email_cta", url: @whatsapp_url, label: t("order_mailer.returned.cta") %>
<% end %>
