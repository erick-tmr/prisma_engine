<%= render layout: "shared/email_card", locals: {
      badge_label: t("order_mailer.delivered.badge_label"),
      badge_color: "#007bff",
      hero_image: "dragon-face.png",
      hero_height: 180,
      heading: t("order_mailer.delivered.heading"),
      first_name: @order.user.first_name
    } do %>
  <tr>
    <td style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.delivered.intro") %>
    </td>
  </tr>
  <%= render "summary" %>
  <%= render "shared/email_tracking_chip", code: @order.shipment.tracking_code %>
  <%= render "shared/email_cta", url: account_orders_url, label: t("order_mailer.delivered.cta") %>
<% end %>
