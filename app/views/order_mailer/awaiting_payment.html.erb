<%= render layout: "shared/email_card", locals: {
      badge_label: t("order_mailer.awaiting_payment.badge_label"),
      badge_color: "#e08a00",
      hero_image: "dragon-letter-full.png",
      hero_height: 180,
      heading: t("order_mailer.awaiting_payment.heading"),
      first_name: @order.user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.awaiting_payment.intro") %>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.awaiting_payment.deadline_html", deadline: @order.payment_deadline.strftime("%d/%m/%Y, %Hh%M")) %>
    </td>
  </tr>
  <%= render "summary", shipping_service: @order.shipment.service_label %>
  <%= render "shared/email_cta", url: checkout_return_url(order_nsu: @order.number), label: t("order_mailer.awaiting_payment.cta") %>
<% end %>
