<% scope = "order_mailer.delivery_issue.#{@issue.kind}" %>
<%= t("mailer.greeting", name: @order.user.first_name) %>

<%= t("#{scope}.heading") %>

<%= t("#{scope}.intro") %>
<% if @issue.detail.present? %>
<%= t("order_mailer.delivery_issue.correios_says") %> <%= @issue.detail %>
<% end %>
<%= t("order_mailer.delivery_issue.support_note") %>

<%= t("order_mailer.tracking_code", code: @order.shipment.tracking_code) %>
<%= t("order_mailer.delivery_issue.tracking_note") %>

<%= t("#{scope}.cta") %>: <%= Shipping::CORREIOS_CONTACT_URL %>
<%= t("order_mailer.track_link") %>: <%= @order.shipment.tracking_url %>

<%= t("mailer.signature") %>
