<%= render layout: "shared/email_card", locals: {
      badge_label: t("order_mailer.delivery_issue.badge_label"),
      badge_color: "#e08a00",
      hero_image: "dragon-letter-full.png",
      hero_height: 180,
      heading: t("order_mailer.delivery_issue.heading"),
      first_name: @order.user.first_name
    } do %>
  <tr>
    <td style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.delivery_issue.intro") %>
    </td>
  </tr>
  <%= render "shared/email_tracking_chip", code: @order.shipment.tracking_code %>
  <%= render "shared/email_cta", url: "mailto:#{t('mailer.support_email')}", label: t("order_mailer.delivery_issue.cta") %>
<% end %>
