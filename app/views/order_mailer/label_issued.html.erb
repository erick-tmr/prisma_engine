<%= render layout: "shared/email_card", locals: {
      badge_label: t("order_mailer.label_issued.badge_label"),
      badge_color: "#007bff",
      hero_image: "dragon-letter-full.png",
      hero_height: 180,
      heading: t("order_mailer.label_issued.heading"),
      first_name: @order.user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.label_issued.intro") %>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.label_issued.tracking_hint") %>
    </td>
  </tr>
  <%= render "shared/email_steps", current: 1 %>
  <%= render "shared/email_tracking_panel",
             code: @order.shipment.tracking_code,
             note: t("order_mailer.label_issued.tracking_note") %>
  <%= render "summary", shipping_service: @order.shipment.service_label %>
  <%= render "shared/email_cta", url: account_order_url(@order), label: t("order_mailer.label_issued.cta") %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.6;color:#6b7280;">
      <%= t("order_mailer.label_issued.posting_note_html") %>
    </td>
  </tr>
<% end %>
