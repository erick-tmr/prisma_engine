<% window = Shipping::DeliveryWindow.for(@order.shipment) -%>
<%= t("mailer.greeting", name: @order.user.first_name) %>

<%= t("order_mailer.shipped.heading") %>

<%= t("order_mailer.shipped.intro") %>

<% if window -%>
<%= t("order_mailer.shipped.delivery_window", from: l(window.first, format: :day_month), to: l(window.last, format: :day_month), address: @order.shipment.short_address) %>
<% else -%>
<%= t("order_mailer.shipped.destination", address: @order.shipment.short_address) %>
<% end -%>

<%= t("order_mailer.tracking_code", code: @order.shipment.tracking_code) %>
<%= t("order_mailer.shipped.tracking_note") %>
<%= t("order_mailer.track_link") %>: <%= @order.shipment.tracking_url %>

<%= render "summary", shipping_service: @order.shipment.service_label %>

<%= t("order_mailer.shipped.cta") %>: <%= account_order_url(@order) %>

<%= t("mailer.signature") %>
