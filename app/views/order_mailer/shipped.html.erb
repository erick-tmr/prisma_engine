<% window = Shipping::DeliveryWindow.for(@order.shipment) %>
<%= render layout: "shared/email_card", locals: {
      badge_label: t("order_mailer.shipped.badge_label"),
      badge_color: "#007bff",
      hero_image: "dragon-fly.png",
      hero_height: 180,
      heading: t("order_mailer.shipped.heading"),
      first_name: @order.user.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("order_mailer.shipped.intro") %>
    </td>
  </tr>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <% if window %>
        <%= t("order_mailer.shipped.delivery_window_html",
              from: l(window.first, format: :day_month),
              to: l(window.last, format: :day_month),
              address: @order.shipment.short_address) %>
      <% else %>
        <%= t("order_mailer.shipped.destination_html", address: @order.shipment.short_address) %>
      <% end %>
    </td>
  </tr>
  <%= render "shared/email_steps", current: 2 %>
  <%= render "shared/email_tracking_panel",
             code: @order.shipment.tracking_code,
             note: t("order_mailer.shipped.tracking_note"),
             track_url: @order.shipment.tracking_url %>
  <%= render "summary", shipping_service: @order.shipment.service_label %>
  <%= render "shared/email_cta", url: account_order_url(@order), label: t("order_mailer.shipped.cta") %>
<% end %>
