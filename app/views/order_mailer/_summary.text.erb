<%= t("order_mailer.summary_heading") %>
<%= t("order_mailer.order_label") %>: <%= @order.number %>

<% @order.order_items.each do |item| -%>
- <%= item.quantity %>x <%= item.name %>: <%= format_brl(item.line_total_cents) %>
<% end -%>

<%= t("order_mailer.subtotal") %>: <%= format_brl(@order.subtotal_cents) %>
<%= t("order_mailer.shipping") %>: <%= format_brl(@order.total_cents - @order.subtotal_cents) %>
<%= t("order_mailer.total") %>: <%= format_brl(@order.total_cents) %>
