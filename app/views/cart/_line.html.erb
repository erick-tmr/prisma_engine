<%#
  Locals: line (Cart::Line), is_gotm (Boolean)
  One row in the cart. The variant editor is a single PATCH form whose
  hidden inputs hold the currently-selected option id per group; clicking
  a pill rewrites its group's hidden input and submits via JS (see
  cart/show.html.erb scripts block).
%>
<%
  grouped_options = line.product.product_options.in_display_order.group_by(&:group_name)
%>
<div class="cart-item<%= ' is-gotm' if is_gotm %>" data-row="<%= line.id %>">
  <div class="cart-item-thumb">
    <% if line.product.image.present? %>
      <img src="<%= line.product.image %>" alt="<%= line.product.title %>">
    <% end %>
  </div>

  <div>
    <p class="cart-item-cat"><%= line.product.category_label %></p>
    <p class="cart-item-title"><%= line.product.title %></p>

    <div class="cart-item-meta">
      <% if is_gotm %>
        <span class="chip chip-edicao"><i class="bi bi-stars"></i>Jogo do Mês</span>
      <% end %>
      <% grouped_options.each_key do |group_name| %>
        <% selected = line.selected_for(group_name) %>
        <% next unless selected %>
        <%
          flag = variant_option_flag(selected.name)
          label = flag ? "#{selected.name} #{flag}" : selected.name
        %>
        <span class="chip">
          <i class="bi <%= variant_group_icon(group_name) %>"></i><%= label %>
        </span>
      <% end %>
    </div>

    <% if grouped_options.any? %>
      <button type="button" class="variant-edit-btn" data-edit-toggle>
        <i class="bi bi-sliders2"></i>
        <span class="lbl-open">Editar variações</span>
        <span class="lbl-close">Fechar variações</span>
      </button>

      <%= form_with url: cart_item_path(line.id), method: :patch, local: true, class: "variant-editor", data: { variant_form: true } do %>
        <% grouped_options.each do |group_name, opts| %>
          <% selected = line.selected_for(group_name) %>
          <%= hidden_field_tag "option_ids[]", selected&.id, data: { variant_group: group_name } %>
          <div class="vgroup">
            <div class="vgroup-label"><i class="bi <%= variant_group_icon(group_name) %>"></i><%= group_name %></div>
            <div class="vpills">
              <% opts.each do |opt| %>
                <%
                  is_sel = selected&.id == opt.id
                  flag = variant_option_flag(opt.name)
                  delta_label = opt.price_delta_cents.positive? ? "+#{HasMoney.format(opt.price_delta_cents)}" : nil
                %>
                <button type="button"
                        class="vpill<%= ' sel' if is_sel %>"
                        data-vgroup="<%= group_name %>"
                        data-vopt="<%= opt.id %>">
                  <%= opt.name %><%= " #{flag}" if flag %>
                  <% if delta_label %><span class="vdelta"><%= delta_label %></span><% end %>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <div class="cart-item-controls">
      <%= form_with url: cart_item_path(line.id), method: :patch, local: true, class: "cart-stepper", data: { stepper_form: true } do %>
        <button type="button" data-dec aria-label="Diminuir" <%= "disabled" if line.quantity <= 1 %>><i class="bi bi-dash"></i></button>
        <input type="number" name="quantity" value="<%= line.quantity %>" min="1" max="99" data-qty aria-label="Quantidade">
        <button type="button" data-inc aria-label="Aumentar"><i class="bi bi-plus"></i></button>
      <% end %>

      <%= button_to cart_item_path(line.id),
                    method: :delete,
                    class: "cart-item-remove",
                    form: { data: { turbo: false } },
                    data: { confirm: "Remover este item do carrinho?" } do %>
        <i class="bi bi-trash3"></i> Remover
      <% end %>
    </div>
  </div>

  <div class="cart-item-prices">
    <div class="cart-item-line-total"><%= line.line_total_formatted %></div>
    <div class="cart-item-unit"><%= line.unit_price_formatted %> / un.</div>
  </div>
</div>
