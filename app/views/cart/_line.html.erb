<%
  grouped_options = line.product.product_options.in_display_order.group_by(&:group_name)
  is_pedido = line.requested_game.present?
%>
<div class="cart-item<%= ' is-gotm' if is_gotm %><%= ' is-pedido' if is_pedido %>" data-cart-item data-row="<%= line.id %>">
  <div class="cart-item__thumb<%= ' cart-item__thumb--pedido' if is_pedido && line.product.image.blank? %>">
    <% if line.product.image.present? %>
      <img src="<%= line.product.image %>" alt="<%= line.product.title %>">
    <% elsif is_pedido %>
      <i class="bi bi-card-checklist"></i>
    <% end %>
  </div>

  <div>
    <p class="cart-item__cat"><%= line.product.category_label %></p>
    <p class="cart-item__title"><%= line.product.title %></p>

    <div class="cart-item__meta">
      <% if is_gotm %>
        <span class="chip chip--edition"><i class="bi bi-stars"></i>Jogo do Mês</span>
      <% end %>
      <% grouped_options.each_key do |group_name| %>
        <% selected = line.selected_for(group_name) %>
        <% next unless selected %>
        <%
          flag = variant_option_flag(selected.name)
          label = flag ? "#{selected.name} #{flag}" : selected.name
        %>
        <span class="chip">
          <i class="bi <%= variant_group_icon(group_name) %>"></i><%= label %>
        </span>
      <% end %>
    </div>

    <% if is_pedido %>
      <div class="cart-item__pedido">
        <div class="cart-item__pedido-head"><i class="bi bi-controller"></i> Seu pedido</div>
        <div class="cart-item__pedido-field">
          <span class="k">Jogo solicitado</span>
          <span class="v"><%= line.requested_game %></span>
        </div>
        <div class="cart-item__pedido-field">
          <span class="k">Observações</span>
          <span class="v<%= ' is-empty' if line.request_notes.blank? %>"><%= line.request_notes.presence || "Sem observações" %></span>
        </div>
      </div>
    <% elsif grouped_options.any? %>
      <button type="button" class="cart-item__edit-btn" data-edit-toggle>
        <i class="bi bi-sliders2"></i>
        <span class="cart-item__edit-open">Editar variações</span>
        <span class="cart-item__edit-close">Fechar variações</span>
      </button>

      <%= form_with url: cart_item_path(line.id), method: :patch, local: true, class: "cart-item__editor", data: { variant_form: true } do %>
        <% grouped_options.each do |group_name, opts| %>
          <% selected = line.selected_for(group_name) %>
          <%= hidden_field_tag "option_ids[]", selected&.id, data: { variant_group: group_name } %>
          <div class="variant-group">
            <div class="variant-group__label"><i class="bi <%= variant_group_icon(group_name) %>"></i><%= group_name %></div>
            <div class="variant-pills">
              <% opts.each do |opt| %>
                <%
                  is_sel = selected&.id == opt.id
                  flag = variant_option_flag(opt.name)
                %>
                <button type="button"
                        class="variant-pill<%= ' is-selected' if is_sel %>"
                        data-vpill
                        data-vgroup="<%= group_name %>"
                        data-vopt="<%= opt.id %>">
                  <%= opt.name %><%= " #{flag}" if flag %>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <div class="cart-item__controls">
      <%= form_with url: cart_item_path(line.id), method: :patch, local: true, class: "cart-stepper", data: { stepper_form: true } do %>
        <button type="button" data-dec aria-label="Diminuir" <%= "disabled" if line.quantity <= 1 %>><i class="bi bi-dash"></i></button>
        <input type="number" name="quantity" value="<%= line.quantity %>" min="1" max="99" data-qty aria-label="Quantidade">
        <button type="button" data-inc aria-label="Aumentar"><i class="bi bi-plus"></i></button>
      <% end %>

      <%= button_to cart_item_path(line.id),
                    method: :delete,
                    class: "cart-item__remove",
                    form: { data: { turbo: false } },
                    data: { confirm: "Remover este item do carrinho?" } do %>
        <i class="bi bi-trash3"></i> Remover
      <% end %>
    </div>
  </div>

  <div class="cart-item__prices">
    <div class="cart-item__total"><%= line.line_total_formatted %></div>
    <div class="cart-item__unit"><%= line.unit_price_formatted %> / un.</div>
  </div>
</div>
