<% content_for :title, "Carrinho — Prisma Games" %>

<div class="cart-page">
  <nav class="cart-breadcrumb" aria-label="breadcrumb">
    <%= link_to "Início", root_path %><i class="bi bi-chevron-right"></i>
    <%= link_to "Catálogo", products_path %><i class="bi bi-chevron-right"></i>
    <span class="cur">Carrinho</span>
  </nav>

  <div class="cart-head">
    <h1>Seu carrinho</h1>
    <%
      qty = @cart.total_quantity
      qty_word = qty == 1 ? "item" : "itens"
    %>
    <span data-head-count><%= qty %> <%= qty_word %></span>
  </div>

  <div class="cart-grid">
    <section class="cart-card" aria-label="Itens do carrinho">
      <div class="cart-card-head">
        <i class="bi bi-bag-check" style="font-size:18px"></i>
        <h2>Itens</h2>
        <span class="count" data-list-count>
          <%= @lines.length %> <%= @lines.length == 1 ? "produto" : "produtos" %>
        </span>
      </div>

      <% if @lines.any? %>
        <div data-items>
          <% @lines.each do |line| %>
            <%= render "cart/line", line: line, is_gotm: @gotm_product_ids.include?(line.product.id) %>
          <% end %>
        </div>

        <div class="cart-item-foot">
          <%= link_to products_path do %>
            <i class="bi bi-arrow-left" style="font-size:13px"></i> Continuar comprando
          <% end %>
        </div>
      <% else %>
        <div class="cart-empty">
          <div class="cart-empty-art"><i class="bi bi-controller"></i></div>
          <h3>Seu carrinho está vazio</h3>
          <p>Os clássicos do Game Boy estão esperando. Dê uma olhada no catálogo e escolha o seu próximo jogo.</p>
          <%= link_to products_path, class: "cart-btn cart-btn-dark" do %>
            <i class="bi bi-grid" style="font-size:13px"></i> Ver catálogo
          <% end %>
        </div>
      <% end %>
    </section>

    <aside class="cart-rail">
      <section class="cart-card" aria-label="Calcular frete"
               data-cart-shipping data-quote-url="<%= cart_quote_path %>">
        <div class="rainbow-top"></div>
        <div class="cart-card-head">
          <i class="bi bi-truck" style="font-size:18px"></i>
          <h2>Calcular frete e prazo</h2>
        </div>
        <div class="frete-body">
          <p class="frete-lead">Informe seu CEP para ver as opções de envio dos Correios e o prazo de entrega.</p>
          <div class="cep-row">
            <input class="cep-input" data-cep inputmode="numeric" maxlength="9" placeholder="00000-000" aria-label="CEP">
            <button type="button" class="cart-btn cart-btn-calc" data-calc>Calcular</button>
          </div>
          <div class="cep-err" data-cep-err>CEP inválido. Digite os 8 números.</div>

          <div class="frete-dest" data-dest>
            <i class="bi bi-geo-alt-fill"></i>
            <span>Entrega para <strong data-dest-city></strong></span>
            <a href="#" data-dest-change>alterar</a>
          </div>

          <div class="ship-opts" data-ship-opts></div>
        </div>
      </section>

      <section class="cart-card" aria-label="Resumo do pedido">
        <div class="cart-card-head">
          <i class="bi bi-receipt" style="font-size:18px"></i>
          <h2>Resumo do pedido</h2>
        </div>
        <div class="sum-body">
          <div class="sum-line">
            <span class="muted">Subtotal <span data-sub-qty>(<%= qty %> <%= qty_word %>)</span></span>
            <span class="val tnum" data-subtotal data-subtotal-cents="<%= @cart.subtotal_cents %>">
              <%= @cart.subtotal_formatted %>
            </span>
          </div>
          <div class="sum-line">
            <span class="muted">Frete <span data-ship-method style="font-weight:600;color:var(--pg-ink)"></span></span>
            <span class="val tnum" data-shipping style="color:var(--pg-muted);font-weight:500">a calcular</span>
          </div>

          <hr class="sum-div">

          <div class="sum-total">
            <span class="lbl">Total</span>
            <span class="amt tnum" data-total><%= @cart.subtotal_formatted %></span>
          </div>

          <div class="cta-stack">
            <%= button_to cart_finalize_path,
                          method: :post,
                          class: "cart-btn cart-btn-dark",
                          form: { data: { turbo: false, finalize_form: true } },
                          disabled: @lines.empty? do %>
              <i class="bi bi-lock-fill" style="font-size:13px"></i> Finalizar compra
            <% end %>
          </div>
        </div>
      </section>
    </aside>
  </div>

  <% if @lines.any? %>
    <div class="cart-mobile-bar" data-mobile-bar>
      <div class="mb-info">
        <span class="mb-lbl">Total</span>
        <span class="mb-amt" data-mb-total><%= @cart.subtotal_formatted %></span>
      </div>
      <%= button_to cart_finalize_path,
                    method: :post,
                    class: "cart-btn cart-btn-dark",
                    form: { data: { turbo: false, finalize_form: true } } do %>
        <i class="bi bi-lock-fill" style="font-size:13px"></i> Finalizar compra
      <% end %>
    </div>
  <% end %>
</div>

<% content_for :scripts do %>
  <%= javascript_include_tag "storefront/cart", type: "module" %>
<% end %>
