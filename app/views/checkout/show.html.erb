<% content_for :title, "Checkout | Prisma Games" %>
<%
  selected = @selected_address
  fmt_cep  = ->(zip) { "#{zip[0, 5]}-#{zip[5, 3]}" }
  count    = @cart.total_quantity
%>

<div class="checkout">
  <main class="checkout__page">
    <div class="checkout__title">
      <h1>Entrega e pagamento</h1>
      <span>Confira os dados, escolha o envio e finalize com segurança.</span>
    </div>

    <div class="checkout__grid">
      <div class="checkout__steps">

        <section class="checkout__card checkout__step<%= ' is-done' if selected %>" data-step="address" id="step-address">
          <div class="checkout__step-head">
            <span class="checkout__step-num" data-step-num>1</span>
            <h2>Endereço de entrega</h2>
            <span class="checkout__step-flag<%= ' is-visible' if selected %>" data-addr-flag><i class="bi bi-check-circle-fill"></i> Confirmado</span>
          </div>
          <div class="checkout__step-body">
            <div class="checkout__step-error"><i class="bi bi-exclamation-circle-fill"></i> Selecione ou cadastre um endereço de entrega.</div>

            <div class="checkout__addr-selected<%= ' is-visible' if selected %>" data-addr-selected>
              <span class="checkout__addr-pin"><i class="bi bi-geo-alt-fill"></i></span>
              <div class="checkout__addr-body">
                <% if selected %>
                  <p class="checkout__addr-receiver">Entregar para <strong data-sel-receiver><%= selected.receiver_name %></strong> · CPF <span data-sel-cpf><%= format_cpf(selected.receiver_cpf) %></span></p>
                  <p class="checkout__addr-street" data-sel-street><%= "#{selected.street}, #{selected.number}" %></p>
                  <div class="checkout__addr-line" data-sel-line1><%= [ selected.complement, selected.neighborhood ].compact_blank.join(" · ") %></div>
                  <div class="checkout__addr-line" data-sel-line2><%= "#{selected.city} · #{selected.state} · CEP #{fmt_cep.call(selected.zip)}" %></div>
                  <span class="checkout__badge<%= ' is-hidden' unless selected.default? %>" data-sel-badge><i class="bi bi-check-circle-fill"></i> Endereço padrão</span>
                <% end %>
              </div>
              <button class="checkout__addr-change" data-addr-change-btn type="button"><i class="bi bi-pencil"></i> Alterar</button>
            </div>

            <div class="checkout__addr-note" data-addr-note>
              <%= label_tag :receiver_obs, class: "checkout__addr-note-label" do %>Observação para os Correios <span class="opt">· opcional</span><% end %>
              <%= text_area_tag :receiver_obs, nil, form: "checkout-form", rows: 2,
                    maxlength: Shipment::RECEIVER_OBS_LIMIT, data: { correios_obs: true },
                    placeholder: "Ex.: entregar na portaria, apto nos fundos, ponto de referência…" %>
              <div class="checkout__addr-note-foot">
                <span class="checkout__addr-note-hint" data-note-hint><i class="bi bi-exclamation-circle-fill"></i> Máximo de <%= Shipment::RECEIVER_OBS_LIMIT %> caracteres.</span>
                <span class="checkout__addr-note-count" data-note-count>0/<%= Shipment::RECEIVER_OBS_LIMIT %></span>
              </div>
            </div>

            <div class="checkout__addr-list<%= ' is-open' unless selected %>" data-addr-list>
              <% @addresses.each do |addr| %>
                <label class="checkout__addr-opt<%= ' is-selected' if addr.id == selected&.id %>" data-addr-opt
                       data-address-id="<%= addr.id %>"
                       data-receiver="<%= addr.receiver_name %>" data-cpf="<%= format_cpf(addr.receiver_cpf) %>"
                       data-street="<%= "#{addr.street}, #{addr.number}" %>"
                       data-line1="<%= [ addr.complement, addr.neighborhood ].compact_blank.join(' · ') %>"
                       data-line2="<%= "#{addr.city} · #{addr.state} · CEP #{fmt_cep.call(addr.zip)}" %>"
                       data-default="<%= addr.default? ? '1' : '0' %>"
                       data-city="<%= "#{addr.city}, #{addr.state}" %>" data-cep="<%= addr.zip %>">
                  <%= radio_button_tag "address_id", addr.id, addr.id == selected&.id,
                        form: "checkout-form", class: "visually-hidden", data: { addr_radio: true } %>
                  <span class="checkout__addr-radio"></span>
                  <div class="checkout__addr-body">
                    <p class="checkout__addr-receiver">Para <strong><%= addr.receiver_name %></strong> · CPF <%= format_cpf(addr.receiver_cpf) %></p>
                    <p class="checkout__addr-street"><%= "#{addr.street}, #{addr.number}" %><%= ", #{addr.complement}" if addr.complement.present? %></p>
                    <div class="checkout__addr-line"><%= "#{addr.neighborhood} · #{addr.city} · #{addr.state} · CEP #{fmt_cep.call(addr.zip)}" %></div>
                    <% if addr.default? %><span class="checkout__badge"><i class="bi bi-check-circle-fill"></i> Endereço padrão</span><% end %>
                  </div>
                </label>
              <% end %>

              <button class="checkout__addr-add" data-addr-add-btn type="button"><i class="bi bi-plus-lg"></i> Adicionar novo endereço</button>
            </div>

            <%= form_with url: checkout_address_path, method: :post, class: "checkout__addr-form", id: "addr-form",
                          html: { novalidate: true,
                                  data: { addr_form: true,
                                          user_name: current_user.full_name,
                                          user_cpf: format_cpf(current_user.cpf),
                                          cep_lookup_url: "#{account_addresses_path}/cep" } } do |f| %>
              <label class="checkout__form-self">
                <%= check_box_tag :receiver_self, "1", false, data: { receiver_self: true } %> Eu mesmo(a) sou quem vai receber
              </label>
              <div class="checkout__form-grid">
                <div class="field checkout__col--4">
                  <%= f.label :receiver_name, "Nome de quem vai receber", class: "field__label" %>
                  <%= f.text_field :receiver_name, name: "address[receiver_name]", class: "field__input", required: true, placeholder: "Nome completo" %>
                </div>
                <div class="field checkout__col--2">
                  <%= f.label :receiver_cpf, "CPF do destinatário", class: "field__label" %>
                  <%= f.text_field :receiver_cpf, name: "address[receiver_cpf]", class: "field__input", required: true, inputmode: "numeric", placeholder: "000.000.000-00" %>
                </div>
                <div class="field checkout__col--2">
                  <%= f.label :zip, "CEP", class: "field__label" %>
                  <%= f.text_field :zip, name: "address[zip]", class: "field__input", required: true, inputmode: "numeric", maxlength: 9, placeholder: "00000-000", data: { mask_cep: true } %>
                </div>
                <div class="field checkout__col--3">
                  <%= f.label :street, "Endereço", class: "field__label" %>
                  <%= f.text_field :street, name: "address[street]", class: "field__input", required: true, placeholder: "Rua, avenida…" %>
                </div>
                <div class="field checkout__col--1">
                  <%= f.label :number, "Número", class: "field__label" %>
                  <%= f.text_field :number, name: "address[number]", class: "field__input", required: true, placeholder: "Nº", maxlength: Address::NUMBER_LIMIT %>
                </div>
                <div class="field checkout__col--3">
                  <%= f.label :complement, class: "field__label" do %>Complemento <span class="opt">(opcional)</span><% end %>
                  <%= f.text_field :complement, name: "address[complement]", class: "field__input", placeholder: "Apto, bloco…" %>
                </div>
                <div class="field checkout__col--3">
                  <%= f.label :neighborhood, "Bairro", class: "field__label" %>
                  <%= f.text_field :neighborhood, name: "address[neighborhood]", class: "field__input", required: true, placeholder: "Bairro" %>
                </div>
                <div class="field checkout__col--4">
                  <%= f.label :city, "Cidade", class: "field__label" %>
                  <%= f.text_field :city, name: "address[city]", class: "field__input", required: true, placeholder: "Cidade" %>
                </div>
                <div class="field checkout__col--2">
                  <%= f.label :state, "UF", class: "field__label" %>
                  <%= f.select :state, Address::UF_LIST, { include_blank: "–" }, name: "address[state]", class: "field__input", required: true %>
                </div>
              </div>
              <div class="checkout__form-actions">
                <%= f.submit "Salvar e usar", class: "checkout__btn checkout__btn--dark checkout__btn--sm" %>
                <button class="checkout__btn checkout__btn--ghost checkout__btn--sm" data-addr-cancel type="button">Cancelar</button>
              </div>
            <% end %>
          </div>
        </section>

        <%= render "merge" if @mergeable_orders.any? %>

        <section class="checkout__card checkout__step" data-step="shipping" id="step-shipping">
          <div class="checkout__step-head">
            <span class="checkout__step-num" data-step-num>2</span>
            <h2>Forma de envio</h2>
            <span class="checkout__step-flag" data-ship-flag><i class="bi bi-check-circle-fill"></i> Selecionado</span>
          </div>
          <div class="checkout__step-body">
            <div class="checkout__step-error"><i class="bi bi-exclamation-circle-fill"></i> Escolha uma forma de envio para continuar.</div>
            <p class="checkout__ship-dest"><i class="bi bi-geo-alt-fill"></i> Enviando para <strong data-ship-dest><%= "#{selected.city}, #{selected.state} · CEP #{fmt_cep.call(selected.zip)}" if selected %></strong></p>
            <div class="checkout__ship-opts" data-ship-opts
                 data-preselected="<%= @selected_shipping_service %>"
                 data-quote-url="<%= cart_quote_path %>">
            </div>
          </div>
        </section>

        <section class="checkout__card checkout__step" data-step="observation" id="step-observation">
          <div class="checkout__step-head">
            <span class="checkout__step-num" data-step-num>3</span>
            <h2>Observação do pedido</h2>
            <span class="checkout__step-flag" data-obs-flag><i class="bi bi-check-circle-fill"></i> Confirmado</span>
          </div>
          <div class="checkout__step-body">
            <div class="checkout__step-error"><i class="bi bi-exclamation-circle-fill"></i> Escreva uma observação ou marque que não tem nenhuma para continuar.</div>
            <div class="checkout__obs-note">
              <i class="bi bi-info-circle-fill"></i>
              <span>Deixe aqui a observação <strong>sobre o pedido</strong></span>
            </div>
            <div class="checkout__obs-field">
              <%= text_area_tag :observation, nil, form: "checkout-form", class: "checkout__obs-input",
                    maxlength: Order::OBSERVATION_LIMIT, data: { obs_input: true },
                    placeholder: "Ex.: caixa da versão 2 japonesa; carcaça amarela com glitter tipo o Pokémon Crystal." %>
              <span class="checkout__obs-count" data-obs-count>0/<%= Order::OBSERVATION_LIMIT %></span>
            </div>
            <label class="checkout__obs-none">
              <%= check_box_tag :no_observation, "1", false, data: { obs_none: true } %> Não tenho nenhuma observação sobre este pedido
            </label>
          </div>
        </section>

      </div>

      <aside class="checkout__rail">
        <section class="checkout__card">
          <div class="rainbow-bar rainbow-bar--top"></div>
          <div class="checkout__sum-head">
            <i class="bi bi-receipt"></i>
            <h2>Resumo do pedido</h2>
            <span class="count"><%= "#{count} #{count == 1 ? 'item' : 'itens'}" %></span>
          </div>

          <div class="checkout__sum-items">
            <% @cart.lines.each do |line| %>
              <% is_pedido = line.requested_game.present? %>
              <div class="checkout__sum-item">
                <%= link_to product_path(line.product), class: "checkout__sum-thumb#{' checkout__sum-thumb--pedido' if is_pedido && line.product.image.blank?}", aria: { label: line.product.title } do %>
                  <% if line.product.image.present? %>
                    <%= storefront_image_tag line.product.image, resize: 240, alt: line.product.title %>
                  <% elsif is_pedido %>
                    <i class="bi bi-card-checklist" aria-hidden="true"></i>
                  <% end %>
                <% end %>
                <div class="checkout__sum-item-body">
                  <p class="checkout__sum-item-cat"><%= line.product.category_label %></p>
                  <p class="checkout__sum-item-name"><%= link_to line.product.title, product_path(line.product) %></p>
                  <% if line.options.any? %>
                    <div class="checkout__sum-item-opts"><%= line.options.map { |o| (flag = variant_option_flag(o.name)) ? "#{o.name} #{flag}" : o.name }.join(" · ") %></div>
                  <% end %>
                  <% if is_pedido %>
                    <div class="checkout__sum-item-pedido">
                      <div class="checkout__sum-item-pedido-head"><i class="bi bi-controller"></i> Seu pedido</div>
                      <div class="checkout__sum-item-pedido-row"><span class="k">Jogo:</span> <span class="v"><%= line.requested_game %></span></div>
                      <div class="checkout__sum-item-pedido-row"><span class="k">Obs.:</span> <span class="v<%= ' is-empty' if line.request_notes.blank? %>"><%= line.request_notes.presence || "Sem observações" %></span></div>
                    </div>
                  <% end %>
                </div>
                <div class="checkout__sum-item-right">
                  <span class="checkout__sum-item-price"><%= line.line_total_formatted %></span>
                  <span class="checkout__sum-item-qty"><%= line.quantity %> un.</span>
                </div>
              </div>
            <% end %>
          </div>

          <% if @mergeable_orders.any? %>
            <div class="checkout__merge-summary" data-merge-summary hidden>
              <div class="checkout__merge-summary-head">
                <i class="bi bi-box-seam"></i> Pedidos juntados
                <span class="n"><%= t("checkout.merge.orders_paid", count: @mergeable_orders.size) %></span>
              </div>
              <% @mergeable_orders.each do |order| %>
                <div class="checkout__merge-summary-row">
                  <span>#<%= order.number %> · <%= t("checkout.merge.items", count: order.order_items.sum(&:quantity)) %> · <%= HasMoney.format(order.total_cents) %></span>
                  <span class="paid">Já pago</span>
                </div>
              <% end %>
              <div class="checkout__merge-summary-note">
                <i class="bi bi-truck"></i>
                <span>Enviados nesta mesma entrega. Você economiza <strong data-merge-savings>–</strong> em frete.</span>
              </div>
            </div>
          <% end %>

          <div class="checkout__sum-totals">
            <div class="checkout__sum-line">
              <span class="muted">Subtotal <span>(<%= count %>)</span></span>
              <span class="val tnum" data-subtotal data-subtotal-cents="<%= @cart.subtotal_cents %>"><%= HasMoney.format(@cart.subtotal_cents) %></span>
            </div>
            <div class="checkout__sum-line">
              <span class="muted">Frete <span class="checkout__sum-method" data-ship-method></span></span>
              <span class="val is-pending tnum" data-shipping>Selecione o envio</span>
            </div>
            <hr class="checkout__sum-divider">
            <div class="checkout__sum-total">
              <span class="lbl">Total</span>
              <span class="amt tnum" data-total><%= HasMoney.format(@cart.subtotal_cents) %></span>
            </div>
          </div>

          <%= form_with url: checkout_create_path, method: :post, id: "checkout-form",
                        html: { class: "checkout__pay-foot", data: { checkout_form: true } } do |f| %>
            <%= f.hidden_field :shipping_service, value: @selected_shipping_service, data: { checkout_service: true } %>

            <div class="checkout__pay-note">
              <i class="bi bi-shield-lock-fill"></i>
              <span>O pagamento é processado em ambiente seguro pelo nosso parceiro. Ao confirmar, você será redirecionado para concluir com Pix ou cartão de crédito.</span>
            </div>

            <div class="checkout__pay-error" data-pay-error><i class="bi bi-exclamation-circle-fill"></i> <span data-pay-error-msg>Escolha uma forma de envio antes de pagar.</span></div>

            <%= f.submit "Confirmar e pagar", class: "checkout__btn checkout__btn--dark checkout__btn--block checkout__btn--pay", data: { pay_btn: true } %>

            <div class="checkout__trust">
              <div><i class="bi bi-shield-check"></i> <span>Ambiente criptografado · seus dados protegidos</span></div>
              <div><i class="bi bi-box-seam"></i> <span>Enviado com rastreio pelos Correios</span></div>
              <div><i class="bi bi-credit-card"></i> <span>Parcelamento <b>com juros</b>, calculado pela InfinitePay</span></div>
            </div>
          <% end %>
        </section>
      </aside>
    </div>
  </main>

  <div class="checkout__mobile-bar">
    <div class="checkout__mb-info">
      <span class="checkout__mb-label">Total</span>
      <span class="checkout__mb-amount tnum" data-mb-total><%= HasMoney.format(@cart.subtotal_cents) %></span>
    </div>
    <button class="checkout__btn checkout__btn--dark" type="submit" form="checkout-form"><i class="bi bi-lock-fill"></i> Confirmar e pagar</button>
  </div>

  <div class="checkout__redirect" data-redirect>
    <div class="checkout__redirect-card">
      <div class="rainbow-bar rainbow-bar--top"></div>
      <div class="checkout__redirect-body">
        <div class="checkout__spinner"></div>
        <h3>Abrindo o pagamento…</h3>
        <p>O pagamento abre em uma nova aba. Conclua por lá, esta página acompanha o status do pedido.</p>
      </div>
    </div>
  </div>

  <%= render "payment_agreement" %>
</div>

<% content_for :scripts do %>
  <%= javascript_include_tag "storefront/checkout", type: "module" %>
  <%= javascript_include_tag "storefront/address_form", type: "module" %>
<% end %>
