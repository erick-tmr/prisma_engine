<% content_for :title, "Checkout — Prisma Games" %>
<%
  selected = @selected_address
  fmt_cep  = ->(zip) { "#{zip[0, 5]}-#{zip[5, 3]}" }
  count    = @cart.total_quantity
%>

<div class="checkout-page">
  <main class="page">
    <div class="co-title">
      <h1>Entrega e pagamento</h1>
      <span>Confira os dados, escolha o envio e finalize com segurança.</span>
    </div>

    <div class="co-grid">
      <%# LEFT: steps %>
      <div class="steps">

        <%# STEP 1 — ADDRESS %>
        <section class="card step<%= ' step-done' if selected %>" data-step="address" id="step-address">
          <div class="step-head">
            <span class="step-num" data-step-num>1</span>
            <h2>Endereço de entrega</h2>
            <span class="step-flag" data-addr-flag<%= ' style=display:none'.html_safe unless selected %>><i class="bi bi-check-circle-fill"></i> Confirmado</span>
          </div>
          <div class="step-body">
            <div class="step-error"><i class="bi bi-exclamation-circle-fill"></i> Selecione ou cadastre um endereço de entrega.</div>

            <%# Selected / default address %>
            <div class="addr-selected" data-addr-selected<%= ' style=display:none'.html_safe unless selected %>>
              <span class="addr-pin"><i class="bi bi-geo-alt-fill"></i></span>
              <div class="addr-body">
                <% if selected %>
                  <p class="addr-receiver">Entregar para <strong data-sel-receiver><%= selected.receiver_name %></strong> · CPF <span data-sel-cpf><%= format_cpf(selected.receiver_cpf) %></span></p>
                  <p class="addr-street" data-sel-street><%= "#{selected.street}, #{selected.number}" %></p>
                  <div class="addr-line" data-sel-line1><%= [ selected.complement, selected.neighborhood ].compact_blank.join(" · ") %></div>
                  <div class="addr-line" data-sel-line2><%= "#{selected.city} — #{selected.state} · CEP #{fmt_cep.call(selected.zip)}" %></div>
                  <span class="badge-default" data-sel-badge<%= ' style=display:none'.html_safe unless selected.default? %>><i class="bi bi-check-circle-fill"></i> Endereço padrão</span>
                <% end %>
              </div>
              <button class="addr-change" data-addr-change-btn type="button"><i class="bi bi-pencil"></i> Alterar</button>
            </div>

            <%# Saved address list (revealed) %>
            <div class="addr-list<%= ' open' unless selected %>" data-addr-list>
              <% @addresses.each do |addr| %>
                <label class="addr-opt<%= ' sel' if addr.id == selected&.id %>" data-addr-opt
                       data-address-id="<%= addr.id %>"
                       data-receiver="<%= addr.receiver_name %>" data-cpf="<%= format_cpf(addr.receiver_cpf) %>"
                       data-street="<%= "#{addr.street}, #{addr.number}" %>"
                       data-line1="<%= [ addr.complement, addr.neighborhood ].compact_blank.join(' · ') %>"
                       data-line2="<%= "#{addr.city} — #{addr.state} · CEP #{fmt_cep.call(addr.zip)}" %>"
                       data-default="<%= addr.default? ? '1' : '0' %>"
                       data-city="<%= "#{addr.city}, #{addr.state}" %>" data-cep="<%= addr.zip %>">
                  <%= radio_button_tag "address_id", addr.id, addr.id == selected&.id,
                        form: "checkout-form", class: "visually-hidden", data: { addr_radio: true } %>
                  <span class="addr-radio"></span>
                  <div class="addr-body">
                    <p class="addr-receiver">Para <strong><%= addr.receiver_name %></strong> · CPF <%= format_cpf(addr.receiver_cpf) %></p>
                    <p class="addr-street"><%= "#{addr.street}, #{addr.number}" %><%= " — #{addr.complement}" if addr.complement.present? %></p>
                    <div class="addr-line"><%= "#{addr.neighborhood} · #{addr.city} — #{addr.state} · CEP #{fmt_cep.call(addr.zip)}" %></div>
                    <% if addr.default? %><span class="badge-default"><i class="bi bi-check-circle-fill"></i> Endereço padrão</span><% end %>
                  </div>
                </label>
              <% end %>

              <button class="addr-add-btn" data-addr-add-btn type="button"><i class="bi bi-plus-lg"></i> Adicionar novo endereço</button>
            </div>

            <%# Add-new address form (its own form; posts a real Address) %>
            <%= form_with url: checkout_address_path, method: :post, class: "addr-form", id: "addr-form",
                          html: { novalidate: true,
                                  data: { addr_form: true,
                                          user_name: current_user.full_name,
                                          user_cpf: format_cpf(current_user.cpf),
                                          cep_lookup_url: "#{account_addresses_path}/cep" } } do |f| %>
              <label class="form-self">
                <%= check_box_tag :receiver_self, "1", false, data: { receiver_self: true } %> Eu mesmo(a) sou quem vai receber
              </label>
              <div class="form-grid">
                <div class="field co-col-4">
                  <%= f.label :receiver_name, "Nome de quem vai receber", class: "field-label" %>
                  <%= f.text_field :receiver_name, name: "address[receiver_name]", class: "field-input", required: true, placeholder: "Nome completo" %>
                </div>
                <div class="field co-col-2">
                  <%= f.label :receiver_cpf, "CPF do destinatário", class: "field-label" %>
                  <%= f.text_field :receiver_cpf, name: "address[receiver_cpf]", class: "field-input", required: true, inputmode: "numeric", placeholder: "000.000.000-00" %>
                </div>
                <div class="field co-col-2">
                  <%= f.label :zip, "CEP", class: "field-label" %>
                  <%= f.text_field :zip, name: "address[zip]", class: "field-input", required: true, inputmode: "numeric", maxlength: 9, placeholder: "00000-000", data: { mask_cep: true } %>
                </div>
                <div class="field co-col-3">
                  <%= f.label :street, "Endereço", class: "field-label" %>
                  <%= f.text_field :street, name: "address[street]", class: "field-input", required: true, placeholder: "Rua, avenida…" %>
                </div>
                <div class="field co-col-1">
                  <%= f.label :number, "Número", class: "field-label" %>
                  <%= f.text_field :number, name: "address[number]", class: "field-input", required: true, placeholder: "Nº" %>
                </div>
                <div class="field co-col-3">
                  <%= f.label :complement, class: "field-label" do %>Complemento <span class="opt">(opcional)</span><% end %>
                  <%= f.text_field :complement, name: "address[complement]", class: "field-input", placeholder: "Apto, bloco…" %>
                </div>
                <div class="field co-col-3">
                  <%= f.label :neighborhood, "Bairro", class: "field-label" %>
                  <%= f.text_field :neighborhood, name: "address[neighborhood]", class: "field-input", required: true, placeholder: "Bairro" %>
                </div>
                <div class="field co-col-4">
                  <%= f.label :city, "Cidade", class: "field-label" %>
                  <%= f.text_field :city, name: "address[city]", class: "field-input", required: true, placeholder: "Cidade" %>
                </div>
                <div class="field co-col-2">
                  <%= f.label :state, "UF", class: "field-label" %>
                  <%= f.select :state, Address::UF_LIST, { include_blank: "—" }, name: "address[state]", class: "field-input", required: true %>
                </div>
              </div>
              <div class="form-actions">
                <%= f.submit "Salvar e usar", class: "btn btn-dark btn-sm" %>
                <button class="btn btn-ghost btn-sm" data-addr-cancel type="button">Cancelar</button>
              </div>
            <% end %>
          </div>
        </section>

        <%# STEP 2 — SHIPPING %>
        <section class="card step" data-step="shipping" id="step-shipping">
          <div class="step-head">
            <span class="step-num" data-step-num>2</span>
            <h2>Forma de envio</h2>
            <span class="step-flag" data-ship-flag style="display:none"><i class="bi bi-check-circle-fill"></i> Selecionado</span>
          </div>
          <div class="step-body">
            <div class="step-error"><i class="bi bi-exclamation-circle-fill"></i> Escolha uma forma de envio para continuar.</div>
            <p class="ship-dest"><i class="bi bi-geo-alt-fill"></i> Enviando para <strong data-ship-dest><%= "#{selected.city}, #{selected.state} · CEP #{fmt_cep.call(selected.zip)}" if selected %></strong></p>
            <div class="ship-opts" data-ship-opts
                 data-preselected="<%= @selected_shipping_service %>"
                 data-quote-url="<%= cart_quote_path %>">
              <%# shipping options injected by storefront/checkout.js from the live Correios quote %>
            </div>
          </div>
        </section>

      </div>

      <%# RIGHT: order summary %>
      <aside class="rail">
        <section class="card">
          <div class="rainbow-top"></div>
          <div class="sum-head">
            <i class="bi bi-receipt"></i>
            <h2>Resumo do pedido</h2>
            <span class="count"><%= "#{count} #{count == 1 ? 'item' : 'itens'}" %></span>
          </div>

          <div class="sum-items">
            <% @cart.lines.each do |line| %>
              <div class="sum-item">
                <div class="sum-thumb">
                  <% if line.product.image.present? %><img src="<%= line.product.image %>" alt="<%= line.product.title %>"><% end %>
                </div>
                <div class="sum-item-body">
                  <p class="sum-item-cat"><%= line.product.category_label %></p>
                  <p class="sum-item-name"><%= line.product.title %></p>
                  <% if line.options.any? %>
                    <div class="sum-item-opts"><%= line.options.map { |o| (flag = variant_option_flag(o.name)) ? "#{o.name} #{flag}" : o.name }.join(" · ") %></div>
                  <% end %>
                </div>
                <div class="sum-item-right">
                  <span class="sum-item-price"><%= line.line_total_formatted %></span>
                  <span class="sum-item-qty"><%= line.quantity %> un.</span>
                </div>
              </div>
            <% end %>
          </div>

          <div class="sum-totals">
            <div class="sum-line">
              <span class="muted">Subtotal <span>(<%= count %>)</span></span>
              <span class="val tnum" data-subtotal data-subtotal-cents="<%= @cart.subtotal_cents %>"><%= HasMoney.format(@cart.subtotal_cents) %></span>
            </div>
            <div class="sum-line">
              <span class="muted">Frete <span data-ship-method style="font-weight:600;color:var(--pg-ink)"></span></span>
              <span class="val pending tnum" data-shipping>Selecione o envio</span>
            </div>
            <hr class="sum-div">
            <div class="sum-total">
              <span class="lbl">Total</span>
              <span class="amt tnum" data-total><%= HasMoney.format(@cart.subtotal_cents) %></span>
            </div>
            <p class="sum-installment">em até <b>12x</b> de <b class="tnum" data-installment></b> sem juros</p>
          </div>

          <%# The pay button submits this form (address_id via the radios above,
              shipping_service set by checkout.js). The form lives here so the rail
              button is a plain submit; the address radios and the mobile-bar button
              associate by the HTML form= attribute. %>
          <%= form_with url: checkout_create_path, method: :post, id: "checkout-form",
                        html: { class: "pay-foot", data: { checkout_form: true } } do |f| %>
            <%= f.hidden_field :shipping_service, value: @selected_shipping_service, data: { checkout_service: true } %>

            <div class="pay-note">
              <i class="bi bi-shield-lock-fill"></i>
              <span>O pagamento é processado em ambiente seguro pelo nosso parceiro. Ao confirmar, você será redirecionado para concluir com Pix ou cartão de crédito.</span>
            </div>

            <div class="pay-error" data-pay-error><i class="bi bi-exclamation-circle-fill"></i> <span data-pay-error-msg>Escolha uma forma de envio antes de pagar.</span></div>

            <%= f.submit "Confirmar e pagar", class: "btn btn-dark btn-block btn-pay", data: { pay_btn: true } %>

            <div class="trust">
              <div><i class="bi bi-shield-check"></i> Ambiente criptografado · seus dados protegidos</div>
              <div><i class="bi bi-box-seam"></i> Enviado com rastreio pelos Correios</div>
            </div>
          <% end %>
        </section>
      </aside>
    </div>
  </main>

  <%# ============ MOBILE STICKY BAR ============ %>
  <div class="mobile-bar">
    <div class="mb-info">
      <span class="mb-lbl">Total</span>
      <span class="mb-amt tnum" data-mb-total><%= HasMoney.format(@cart.subtotal_cents) %></span>
    </div>
    <button class="btn btn-dark" type="submit" form="checkout-form"><i class="bi bi-lock-fill"></i> Confirmar e pagar</button>
  </div>

  <%# ============ FINALIZING INTERSTITIAL (shown by checkout.js on submit) ============ %>
  <div class="redirect-overlay" data-redirect>
    <div class="redirect-card">
      <div class="rainbow-top"></div>
      <div class="redirect-body">
        <div class="spinner"></div>
        <h3>Finalizando seu pedido…</h3>
        <p>Estamos registrando seu pedido. Não feche nem atualize esta janela.</p>
      </div>
    </div>
  </div>
</div>

<% content_for :scripts do %>
  <%= javascript_include_tag "storefront/checkout", type: "module" %>
  <%= javascript_include_tag "storefront/address_form", type: "module" %>
<% end %>
