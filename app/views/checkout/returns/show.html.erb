<% content_for :title, "Status do pagamento — Prisma Games" %>
<% content_for :checkout_bare, true %>
<%
  first_name = @order.user.first_name
  pay_label  = { "pix" => "Pix", "credit_card" => "Cartão de crédito" }[@order.payment_method]
  fmt_cep    = ->(zip) { "#{zip[0, 5]}-#{zip[5, 3]}" }
%>

<main class="pay-return pay-return--<%= @state %>">

  <section class="pay-return__card pay-return__hero">
    <div class="pay-return__accent"></div>
    <div class="pay-return__hero-body">
      <div class="pay-return__hero-ic">
        <% if @state == "success" %><i class="bi bi-check-lg"></i>
        <% elsif @state == "failed" %><i class="bi bi-x-lg"></i>
        <% else %><i class="bi bi-hourglass-split"></i>
        <% end %>
      </div>

      <% if @state == "success" %>
        <h1>Pagamento confirmado!</h1>
        <p>Tudo certo, <b><%= first_name %></b>! Recebemos o pagamento e seu pedido já entrou na fila de separação.</p>
      <% elsif @state == "failed" %>
        <h1>Pedido cancelado por falta de pagamento</h1>
        <p>Não recebemos o pagamento dentro do prazo de <b>24 horas</b>, então este pedido foi cancelado automaticamente. Nenhum valor foi cobrado — você pode refazer o pedido quando quiser.</p>
      <% else %>
        <h1>Pagamento em processamento</h1>
        <p>Falta pouco, <b><%= first_name %></b>. Ainda não recebemos a confirmação do pagamento — conclua na página do nosso parceiro. Guardamos seus itens por <b>24 horas</b>.</p>
      <% end %>

      <div class="pay-return__hero-meta">
        <span class="pay-return__pill"><i class="bi bi-receipt"></i> Pedido <%= @order.number %></span>
        <span class="pay-return__pill"><i class="bi bi-calendar3"></i> <%= @order.placed_at.strftime("%d/%m/%Y") %></span>
      </div>

      <% if @state == "success" %><div class="pay-return__status-tag"><i class="bi bi-check-circle-fill"></i> Pagamento aprovado</div>
      <% elsif @state == "failed" %><div class="pay-return__status-tag"><i class="bi bi-x-circle-fill"></i> Cancelado por expiração do prazo</div>
      <% else %><div class="pay-return__status-tag"><i class="bi bi-clock-history"></i> Aguardando pagamento</div>
      <% end %>
    </div>
  </section>

  <% if @state == "pending" %>
    <section class="pay-return__card pay-return__action-panel">
      <div class="pay-return__accent"></div>
      <div class="pay-return__action-body">
        <div class="pay-return__action-head"><i class="bi bi-hourglass-split"></i><h2>Conclua seu pagamento</h2></div>
        <p class="pay-return__action-sub">Volte ao ambiente seguro do parceiro para finalizar. Assim que o pagamento for confirmado, atualizamos seu pedido automaticamente.</p>

        <div class="pay-return__countdown" data-countdown data-deadline="<%= @order.payment_deadline.iso8601 %>">
          <div class="pay-return__cd-top"><i class="bi bi-clock-history"></i> O pedido será cancelado automaticamente em</div>
          <div class="pay-return__cd-clock">
            <span class="pay-return__cd-unit"><span class="pay-return__cd-num" data-cd-h>--</span><span class="pay-return__cd-lbl">horas</span></span>
            <span class="pay-return__cd-sep">:</span>
            <span class="pay-return__cd-unit"><span class="pay-return__cd-num" data-cd-m>--</span><span class="pay-return__cd-lbl">min</span></span>
            <span class="pay-return__cd-sep">:</span>
            <span class="pay-return__cd-unit"><span class="pay-return__cd-num" data-cd-s>--</span><span class="pay-return__cd-lbl">seg</span></span>
          </div>
          <div class="pay-return__cd-deadline">Prazo final: <b><%= @order.payment_deadline.strftime("%d/%m/%Y, %Hh%M") %></b></div>
        </div>

        <%= form_with url: checkout_pay_path, method: :post do %>
          <%= hidden_field_tag :order_nsu, @order.number %>
          <button class="pay-return__btn pay-return__btn--status pay-return__btn--block pay-return__btn--lg" type="submit"><i class="bi bi-lock-fill"></i> Finalizar pagamento</button>
        <% end %>
        <div class="pay-return__actions">
          <%= link_to checkout_return_path(order_nsu: @order.number), class: "pay-return__btn pay-return__btn--ghost pay-return__btn--md" do %>
            <i class="bi bi-arrow-clockwise"></i> Já paguei, atualizar
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <% if @state == "failed" %>
    <section class="pay-return__card pay-return__action-panel">
      <div class="pay-return__accent"></div>
      <div class="pay-return__action-body">
        <div class="pay-return__action-head"><i class="bi bi-arrow-counterclockwise"></i><h2>Refazer pedido</h2></div>
        <p class="pay-return__action-sub">Monte o pedido novamente com os mesmos itens e conclua o pagamento dentro do prazo.</p>
        <div class="pay-return__reason-box"><i class="bi bi-clock-history"></i><span><b>Motivo:</b> o prazo de 24 horas para pagamento expirou sem confirmação. Nenhum valor foi cobrado.</span></div>
        <%= link_to products_path, class: "pay-return__btn pay-return__btn--status pay-return__btn--block pay-return__btn--lg" do %>
          <i class="bi bi-arrow-repeat"></i> Refazer pedido e pagar
        <% end %>
        <div class="pay-return__actions">
          <%= link_to checkout_path, class: "pay-return__btn pay-return__btn--ghost pay-return__btn--md" do %><i class="bi bi-pencil"></i> Revisar entrega<% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section class="pay-return__card">
    <div class="pay-return__sum-head">
      <i class="bi bi-bag-check"></i>
      <h2>Resumo do pedido</h2>
      <span class="count"><%= @order.order_items.size %> <%= @order.order_items.size == 1 ? "item" : "itens" %></span>
    </div>

    <div class="pay-return__sum-items">
      <% @order.order_items.each do |item| %>
        <div class="pay-return__sum-item">
          <div class="pay-return__sum-thumb">
            <% if item.photo_path.present? %><%= storefront_image_tag item.photo_path, resize: 240, alt: item.name %><% end %>
          </div>
          <div class="pay-return__sum-item-body">
            <% if item.product&.category_label.present? %><p class="pay-return__sum-item-cat"><%= item.product.category_label %></p><% end %>
            <p class="pay-return__sum-item-name"><%= item.name %></p>
            <% if item.chosen_options.any? %><div class="pay-return__sum-item-opts"><%= item.chosen_options.join(" · ") %></div><% end %>
          </div>
          <div class="pay-return__sum-item-right">
            <span class="pay-return__sum-item-price tnum"><%= HasMoney.format(item.line_total_cents) %></span>
            <span class="pay-return__sum-item-qty tnum"><%= item.quantity %> un.</span>
          </div>
        </div>
      <% end %>
    </div>

    <div class="pay-return__sum-totals">
      <div class="pay-return__sum-line"><span class="muted">Subtotal</span><span class="val tnum"><%= HasMoney.format(@order.subtotal_cents) %></span></div>
      <div class="pay-return__sum-line"><span class="muted">Frete · <%= @order.shipment.service %></span><span class="val tnum"><%= HasMoney.format(@order.shipment.shipping_cents) %></span></div>
      <hr class="pay-return__sum-divider">
      <div class="pay-return__sum-total"><span class="lbl">Total</span><span class="amt tnum"><%= HasMoney.format(@order.total_cents) %></span></div>
    </div>

    <div class="pay-return__info-grid">
      <div class="pay-return__info-cell">
        <p class="pay-return__info-label"><i class="bi bi-truck"></i> Entrega</p>
        <div class="pay-return__info-body">
          <% ship = @order.shipment %>
          <div class="strong"><%= ship.receiver_name %></div>
          <div><%= "#{ship.street}, #{ship.number}" %><%= " — #{ship.complement}" if ship.complement.present? %></div>
          <div><%= "#{ship.neighborhood} · #{ship.city} — #{ship.state}" %></div>
          <div>CEP <%= fmt_cep.call(ship.zip) %></div>
        </div>
      </div>
      <div class="pay-return__info-cell">
        <p class="pay-return__info-label"><i class="bi bi-credit-card"></i> Pagamento</p>
        <div class="pay-return__info-body">
          <% if pay_label %><div class="strong"><%= pay_label %></div><% end %>
          <% if @order.receipt_url.present? %>
            <div><a href="<%= @order.receipt_url %>" class="link" target="_blank" rel="noopener">Ver comprovante</a></div>
          <% end %>
          <% if @state == "success" %><span class="pay-return__pay-status"><i class="bi bi-check-circle-fill"></i> Pago</span>
          <% elsif @state == "failed" %><span class="pay-return__pay-status"><i class="bi bi-x-circle-fill"></i> Expirado</span>
          <% else %><span class="pay-return__pay-status"><i class="bi bi-clock-history"></i> Aguardando</span>
          <% end %>
        </div>
      </div>
    </div>

    <% if @order.observation.present? %>
      <div class="pay-return__note">
        <i class="bi bi-chat-left-text"></i>
        <div>
          <span class="pay-return__note-label">Sua observação</span>
          <span class="pay-return__note-text"><%= @order.observation %></span>
        </div>
      </div>
    <% end %>
  </section>

  <% if @state == "success" %>
    <div class="pay-return__actions">
      <%= link_to account_orders_path, class: "pay-return__btn pay-return__btn--dark pay-return__btn--lg" do %><i class="bi bi-box-seam"></i> Acompanhar pedido<% end %>
      <%= link_to products_path, class: "pay-return__btn pay-return__btn--ghost pay-return__btn--lg" do %><i class="bi bi-grid"></i> Continuar comprando<% end %>
    </div>
  <% end %>

  <p class="pay-return__support-line">
    Precisa de ajuda com este pedido? <a href="https://wa.me/5535920001100" class="link">Falar com a Central Prisma</a>
  </p>
</main>

<% content_for :scripts do %>
  <%= javascript_include_tag "storefront/payment_countdown", type: "module" %>
<% end %>
