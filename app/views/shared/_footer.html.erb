<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <div class="footer__logo">
          <img src="/images/stores/uploads/2359718/prisma-games.png" alt="Prisma Games">
        </div>
        <p class="footer__desc">
          Prisma Games — especializada em desenvolvimento e produção de hardware
          para o Game Boy, da Nintendo.
        </p>
        <a href="<%= social_links[:whatsapp] %>" target="_blank" rel="noopener" class="footer__whatsapp">
          <i class="bi bi-whatsapp"></i> <span>(35) 9 2000-1100</span>
        </a>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Links úteis</h4>
        <ul>
          <li><a href="#">Sobre nós</a></li>
          <li><a href="#">Como comprar</a></li>
          <li><a href="#">Trocas e devoluções</a></li>
          <li><a href="#">Contato</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Informações</h4>
        <ul>
          <li><%= link_to "Perguntas frequentes", perguntas_frequentes_path %></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Siga</h4>
        <div class="footer__social">
          <a href="<%= social_links[:instagram] %>" target="_blank" rel="noopener" aria-label="Instagram">
            <i class="bi bi-instagram"></i>
          </a>
          <a href="https://www.youtube.com/@PrismaGamesTV" target="_blank" rel="noopener" aria-label="YouTube">
            <i class="bi bi-youtube"></i>
          </a>
          <a href="<%= social_links[:whatsapp] %>" target="_blank" rel="noopener" aria-label="WhatsApp">
            <i class="bi bi-whatsapp"></i>
          </a>
        </div>
      </div>
    </div>

    <hr class="footer__divider">

    <div class="footer__bottom">
      <span>&copy; <%= Date.current.year %> Prisma Games. Todos os direitos reservados.</span>
      <div class="footer__payment">
        <span>Pagamento seguro</span>
        <span class="footer__pay-ic" title="Cartão"><i class="bi bi-credit-card-2-back"></i></span>
        <span class="footer__pay-ic" title="Pix"><i class="bi bi-currency-dollar"></i></span>
      </div>
    </div>
  </div>
</footer>
