<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <div class="footer__logo">
          <img src="/images/prisma-games-logo.png" alt="Prisma Games">
        </div>
        <p class="footer__desc">
          Desenvolvimento, criação e melhorias para videogames clássicos,
          respeitando sua história e expandindo suas possibilidades.
          <span class="footer__desc-focus">Atualmente focado no nosso querido portátil ❤️</span>
        </p>
      </div>

      <div class="footer__col footer__contact">
        <a href="<%= social_links[:whatsapp] %>" target="_blank" rel="noopener" class="footer__contact-phone">
          <span class="footer__ic"><i class="bi bi-whatsapp"></i></span>
          <span>(35) 9 2000-1100</span>
        </a>
        <div class="footer__contact-block">
          <h4 class="footer__heading">Fale conosco:</h4>
          <a href="mailto:contato@prismagames.com.br" class="footer__contact-row">
            <span class="footer__ic"><i class="bi bi-envelope"></i></span>
            <span>contato@prismagames.com.br</span>
          </a>
        </div>
        <div class="footer__contact-block">
          <h4 class="footer__heading">Horário de atendimento</h4>
          <div class="footer__contact-row">
            <span class="footer__ic"><i class="bi bi-clock"></i></span>
            <span>Seg. a Sex. / 10h às 17h</span>
          </div>
        </div>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Informações</h4>
        <ul>
          <li><%= link_to "Perguntas frequentes", perguntas_frequentes_path %></li>
          <li><%= link_to "Direitos", direitos_path %></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__heading">Siga</h4>
        <div class="footer__social">
          <a href="<%= social_links[:instagram] %>" target="_blank" rel="noopener" aria-label="Instagram">
            <i class="bi bi-instagram"></i>
          </a>
          <a href="https://www.youtube.com/@PrismaGamesTV" target="_blank" rel="noopener" aria-label="YouTube">
            <i class="bi bi-youtube"></i>
          </a>
          <a href="<%= social_links[:whatsapp] %>" target="_blank" rel="noopener" aria-label="WhatsApp">
            <i class="bi bi-whatsapp"></i>
          </a>
        </div>
      </div>
    </div>

    <hr class="footer__divider">

    <div class="footer__bottom">
      <span>&copy; <%= Date.current.year %> Prisma Games. Todos os direitos reservados.</span>
      <span><%= link_to "Desenvolvido por Erick Takeshi com ❤️", "https://ericktakeshi.com.br/", target: "_blank", rel: "noopener" %></span>
    </div>
  </div>
</footer>
