<footer class="pg-footer">
  <div class="pg-footer-inner">
    <div class="pg-footer-grid">
      <div class="pg-footer-brand">
        <div class="pg-footer-logo">
          <img src="/images/stores/uploads/2359718/prisma-games.png" alt="Prisma Games">
        </div>
        <p class="pg-footer-desc">
          Prisma Games — especializada em desenvolvimento e produção de hardware
          para o Game Boy, da Nintendo.
        </p>
        <a href="<%= social_links[:whatsapp] %>" target="_blank" rel="noopener" class="pg-footer-whatsapp">
          <i class="bi bi-whatsapp"></i> <span>(35) 9 2000-1100</span>
        </a>
      </div>

      <div class="pg-footer-col">
        <h4 class="pg-footer-heading">Links úteis</h4>
        <ul>
          <li><a href="#">Sobre nós</a></li>
          <li><a href="#">Como comprar</a></li>
          <li><a href="#">Trocas e devoluções</a></li>
          <li><a href="#">Contato</a></li>
        </ul>
      </div>

      <div class="pg-footer-col">
        <h4 class="pg-footer-heading">Informações</h4>
        <ul>
          <li><%= link_to "Perguntas frequentes", page_path(slug: "perguntas-frequentes") %></li>
        </ul>
      </div>

      <div class="pg-footer-col">
        <h4 class="pg-footer-heading">Siga</h4>
        <div class="pg-footer-social">
          <a href="<%= social_links[:instagram] %>" target="_blank" rel="noopener" aria-label="Instagram">
            <i class="bi bi-instagram"></i>
          </a>
          <a href="https://www.youtube.com/@PrismaGamesTV" target="_blank" rel="noopener" aria-label="YouTube">
            <i class="bi bi-youtube"></i>
          </a>
          <a href="<%= social_links[:whatsapp] %>" target="_blank" rel="noopener" aria-label="WhatsApp">
            <i class="bi bi-whatsapp"></i>
          </a>
        </div>
      </div>
    </div>

    <hr class="pg-footer-divider">

    <div class="pg-footer-bottom">
      <span>&copy; <%= Date.current.year %> Prisma Games. Todos os direitos reservados.</span>
      <div class="pg-footer-payment">
        <span>Pagamento seguro</span>
        <span class="pay-ic" title="Cartão"><i class="bi bi-credit-card-2-back"></i></span>
        <span class="pay-ic" title="Pix"><i class="bi bi-currency-dollar"></i></span>
        <span class="pay-ic" title="Boleto"><i class="bi bi-receipt"></i></span>
      </div>
    </div>
  </div>
</footer>
