<header class="header">
  <div class="header__inner">
    <button class="header__burger" type="button"
            data-toggle="drawer" data-target="#site-drawer"
            aria-controls="site-drawer" aria-expanded="false" aria-label="Abrir menu de categorias">
      <i class="bi bi-list"></i>
    </button>

    <%= link_to root_path, class: "header__logo", "aria-label": "Prisma Games" do %>
      <img src="/images/prisma-games-logo.png" alt="Prisma Games">
    <% end %>

    <%= form_with url: products_path, method: :get, local: true, class: "header__search" do %>
      <%= text_field_tag :term, params[:term],
            class: "header__search-input",
            placeholder: "Buscar jogos, hardware, acessórios…",
            aria: { label: "Buscar produtos" } %>
      <button type="submit" class="header__search-btn" aria-label="Buscar">
        <i class="bi bi-search"></i>
      </button>
    <% end %>

    <div class="header__actions">
      <% if user_signed_in? %>
        <%= link_to account_profile_path, class: "header__action", title: t("account.short_label") do %>
          <i class="bi bi-person"></i>
          <span class="header__action-label"><%= t("account.greeting_html", name: current_user.first_name) %></span>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path, class: "header__action", title: t("account.short_label") do %>
          <i class="bi bi-person"></i>
          <span class="header__action-label"><%= t("account.short_label") %></span>
        <% end %>
      <% end %>

      <%= link_to "/carrinho", class: "header__action header__cart", title: "Carrinho" do %>
        <i class="bi bi-handbag"></i>
        <span class="header__action-label">Carrinho</span>
        <span class="header__cart-count" data-cart-count><%= current_cart_count %></span>
      <% end %>
    </div>
  </div>

  <%= form_with url: products_path, method: :get, local: true, class: "header__search header__search--mobile" do %>
    <%= text_field_tag :term, params[:term],
          class: "header__search-input",
          placeholder: "Buscar produtos…",
          aria: { label: "Buscar produtos" } %>
    <button type="submit" class="header__search-btn" aria-label="Buscar">
      <i class="bi bi-search"></i>
    </button>
  <% end %>
</header>
