<header class="site-header bg-white border-bottom py-2">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-6 col-md-3 d-flex align-items-center">
        <button class="btn btn-link text-dark p-0 me-2 site-drawer-toggle" type="button"
                data-toggle="drawer" data-target="#site-drawer"
                aria-controls="site-drawer" aria-expanded="false" aria-label="Abrir menu de categorias">
          <i class="bi bi-list" style="font-size: 1.6rem;"></i>
        </button>
        <%= link_to root_path, class: "site-logo d-inline-block" do %>
          <img src="/images/stores/uploads/2359718/prisma-games.png" alt="Prisma Games" height="48">
        <% end %>
      </div>

      <div class="col-md-6 d-none d-md-block">
        <%= form_with url: products_path, method: :get, local: true, class: "w-100" do %>
          <div class="input-group w-100">
            <%= text_field_tag :term, params[:term],
                  class: "form-control",
                  placeholder: "Buscar jogos, hardware, acessórios…",
                  aria: { label: "Buscar produtos" } %>
            <button type="submit" class="btn btn-dark" aria-label="Buscar">
              <i class="bi bi-search"></i>
            </button>
          </div>
        <% end %>
      </div>

      <div class="col-6 col-md-3 text-end">
        <% if user_signed_in? %>
          <%= link_to edit_user_registration_path, class: "btn btn-link text-dark", title: t("account.short_label") do %>
            <i class="bi bi-person fs-5"></i>
            <span class="d-none d-lg-inline"><%= t("account.greeting_html", name: current_user.first_name) %></span>
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete,
                class: "btn btn-link text-dark p-0 align-baseline",
                form: { class: "d-inline" },
                title: t("account.sign_out") do %>
            <i class="bi bi-box-arrow-right fs-5"></i>
            <span class="d-none d-lg-inline"><%= t("account.sign_out") %></span>
          <% end %>
        <% else %>
          <%= link_to new_user_session_path, class: "btn btn-link text-dark", title: t("account.sign_in") do %>
            <i class="bi bi-person fs-5"></i>
            <span class="d-none d-lg-inline"><%= t("account.sign_in") %></span>
          <% end %>
          <%= link_to new_user_registration_path, class: "btn btn-link text-dark d-none d-lg-inline" do %>
            <%= t("account.sign_up") %>
          <% end %>
        <% end %>
        <%= link_to "/carrinho", class: "btn btn-link text-dark site-cart", title: "Carrinho" do %>
          <i class="bi bi-handbag fs-5"></i>
          <span class="d-none d-lg-inline">Carrinho</span>
          <span class="cart-counter" data-cart-count>0</span>
        <% end %>
      </div>
    </div>

    <div class="row d-md-none mt-2">
      <div class="col-12">
        <%= form_with url: products_path, method: :get, local: true, class: "w-100" do %>
          <div class="input-group w-100">
            <%= text_field_tag :term, params[:term],
                  class: "form-control form-control-sm",
                  placeholder: "Buscar produtos…",
                  aria: { label: "Buscar produtos" } %>
            <button type="submit" class="btn btn-dark btn-sm" aria-label="Buscar">
              <i class="bi bi-search"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</header>
