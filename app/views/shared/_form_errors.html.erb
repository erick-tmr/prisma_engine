<% if record.errors.any? %>
  <div class="flash flash--danger" role="alert">
    <i class="bi bi-exclamation-octagon-fill flash__icon"></i>
    <div class="flash__body">
      <strong><%= t("forms.errors_heading") %></strong>
      <ul class="flash__list">
        <% record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
