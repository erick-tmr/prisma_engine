<tr>
  <td class="px" style="padding:22px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e5e7eb;border-radius:12px;background:#f8fafc;">
      <tr>
        <td style="padding:16px 18px <%= local_assigns[:track_url] ? 6 : 16 %>px;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;">
          <div style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#6b7280;font-weight:700;"><%= t("order_mailer.tracking_panel_heading") %></div>
          <div class="code" style="font-size:19px;font-weight:800;color:#1a1d21;margin-top:6px;letter-spacing:.08em;font-family:ui-monospace,Menlo,Consolas,monospace;"><%= code %></div>
          <div style="font-size:13px;line-height:1.6;color:#6b7280;margin-top:8px;"><%= note %></div>
        </td>
      </tr>
      <% if local_assigns[:track_url] %>
        <tr>
          <td style="padding:0 18px 16px;">
            <a href="<%= track_url %>" style="font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;font-weight:700;color:#007bff;text-decoration:none;"><%= t("order_mailer.track_link") %> &rarr;</a>
          </td>
        </tr>
      <% end %>
    </table>
  </td>
</tr>
