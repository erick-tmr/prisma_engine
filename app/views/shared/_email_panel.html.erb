<tr>
  <td class="px" style="padding:<%= local_assigns.fetch(:top, 20) %>px 40px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:<%= background %>;border:1px solid <%= border %>;border-radius:12px;">
      <tr>
        <td style="padding:14px 18px;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;">
          <div style="font-size:14px;font-weight:800;line-height:1.4;color:<%= title_color %>;"><%= title %></div>
          <div style="height:6px;line-height:6px;font-size:0;">&nbsp;</div>
          <div style="font-size:13px;line-height:1.6;color:#374151;"><%= text %></div>
        </td>
      </tr>
    </table>
  </td>
</tr>
