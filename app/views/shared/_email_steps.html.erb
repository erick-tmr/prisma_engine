<tr>
  <td class="px" style="padding:22px 40px 0;">
    <table role="presentation" class="steps" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <% %w[payment label_issued posted delivered].each_with_index do |step, index| %>
          <% reached = index <= current %>
          <td width="25%" align="center" style="font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:12px;font-weight:<%= index == current ? 800 : 500 %>;color:<%= reached ? "#007bff" : "#9aa3af" %>;padding:0 2px;">
            <div style="height:8px;line-height:8px;font-size:0;">&nbsp;</div>
            <div style="width:100%;height:4px;background:<%= reached ? "#007bff" : "#e5e7eb" %>;border-radius:4px;">&nbsp;</div>
            <div style="height:8px;line-height:8px;font-size:0;">&nbsp;</div>
            <%= t("order_mailer.steps.#{step}") %>
          </td>
        <% end %>
      </tr>
    </table>
  </td>
</tr>
