<% content_for :mailer_footer_rendered, true %>
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 10px 40px rgba(16,32,64,0.12);">
  <tr>
    <td align="center" bgcolor="#eef6ff" style="background:linear-gradient(180deg,#e6f2ff 0%,#ffffff 58%);padding:26px 24px 0;">
      <span style="display:inline-block;background:#ffffff;border:2px dashed <%= badge_color %>;color:<%= badge_color %>;font-size:11px;font-weight:800;letter-spacing:.14em;padding:6px 14px;border-radius:999px;text-transform:uppercase;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif"><%= badge_label %></span>
      <div style="height:14px;line-height:14px;font-size:0;">&nbsp;</div>
      <img src="<%= email_asset_url(hero_image) %>" alt="Prisma Games" height="<%= hero_height %>" style="display:block;height:<%= hero_height %>px;width:auto;border:0;outline:none;margin:0 auto;">
    </td>
  </tr>
  <tr>
    <td style="padding:24px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;">
      <h1 style="margin:0;font-size:26px;line-height:1.2;font-weight:800;color:#1a1d21;letter-spacing:-0.01em;"><%= heading %></h1>
    </td>
  </tr>
  <tr>
    <td style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("mailer.greeting_html", name: first_name) %>
    </td>
  </tr>
  <%= yield %>
  <tr>
    <td style="padding:30px 40px 34px;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;">
      <hr style="border:0;border-top:1px solid #e5e7eb;margin:0 0 20px;">
      <img src="<%= email_asset_url("prisma-games-logo.png") %>" alt="Prisma Games" width="150" style="display:block;width:150px;height:auto;border:0;">
      <div style="font-size:12px;color:#6b7280;margin-top:12px;line-height:1.6;">
        <%= t("mailer.tagline") %><br>
        <%= t("mailer.help_footer_html", email: t("mailer.support_email")) %>
      </div>
    </td>
  </tr>
</table>
