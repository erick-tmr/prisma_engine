<aside id="site-drawer" class="drawer" aria-hidden="true">
  <div class="drawer__header d-flex align-items-center justify-content-between px-3 py-3 border-bottom">
    <%= link_to root_path, class: "drawer__brand" do %>
      <img src="/images/prisma-games-logo.png" alt="Prisma Games" height="36">
    <% end %>
    <button type="button" class="btn btn-link text-dark p-0 drawer__close"
            aria-label="Fechar menu">
      <i class="bi bi-x-lg"></i>
    </button>
  </div>

  <nav class="drawer__body" aria-label="Categorias">
    <div class="px-3 pt-3 pb-1 small text-muted text-uppercase">Catálogo</div>
    <ul class="list-unstyled mb-0">
      <li>
        <%= link_to products_path, class: "drawer__link" do %>
          <i class="bi bi-grid me-2"></i> Todos os jogos
          <span class="badge text-bg-secondary ms-auto"><%= Product.published.count %></span>
        <% end %>
      </li>
      <li>
        <%= link_to category_path(slug: "pedidos-de-jogos"),
              class: "drawer__link" do %>
          <i class="bi bi-clipboard-check me-2"></i> Pedidos de Jogos
          <span class="badge text-bg-secondary ms-auto"><%= Product.for_category("pedidos-de-jogos").published.count %></span>
        <% end %>
      </li>
      <li>
        <%= link_to category_path(slug: "miscelanea"),
              class: "drawer__link" do %>
          <i class="bi bi-box-seam me-2"></i> Extras &amp; Acessórios
          <span class="badge text-bg-secondary ms-auto"><%= Product.for_category("miscelanea").published.count %></span>
        <% end %>
      </li>
      <li>
        <%= link_to category_path(slug: "game-boy-classic"),
              class: "drawer__link" do %>
          <i class="bi bi-controller me-2"></i> Game Boy Classic
          <span class="badge text-bg-secondary ms-auto"><%= Product.for_category("game-boy-classic").published.count %></span>
        <% end %>
      </li>
      <li>
        <%= link_to category_path(slug: "game-boy-color"),
              class: "drawer__link" do %>
          <i class="bi bi-palette me-2"></i> Game Boy Color
          <span class="badge text-bg-secondary ms-auto"><%= Product.for_category("game-boy-color").published.count %></span>
        <% end %>
      </li>
    </ul>

    <div class="px-3 pt-3 pb-1 small text-muted text-uppercase">Conteúdo</div>
    <ul class="list-unstyled mb-0">
      <li>
        <%= link_to perguntas_frequentes_path, class: "drawer__link" do %>
          <i class="bi bi-question-circle me-2"></i> Perguntas frequentes
        <% end %>
      </li>
      <li>
        <%= link_to direitos_path, class: "drawer__link" do %>
          <i class="bi bi-shield-check me-2"></i> Direitos
        <% end %>
      </li>
    </ul>

    <div class="px-3 pt-3 pb-1 small text-muted text-uppercase">Recomendações do Vini</div>
    <ul class="list-unstyled mb-0">
      <% cache [ "drawer-recommendations", nav_recommendations ] do %>
        <% nav_recommendations.each do |recommendation| %>
          <li>
            <a href="<%= recommendation.url %>" target="_blank" rel="noopener noreferrer"
               class="drawer__link">
              <%= render "shared/recommendation_media", recommendation: recommendation %>
            </a>
          </li>
        <% end %>
      <% end %>
    </ul>

    <div class="px-3 pt-3 pb-1 small text-muted text-uppercase"><%= t("account.drawer.heading") %></div>
    <ul class="list-unstyled mb-0">
      <% if user_signed_in? %>
        <li>
          <%= link_to account_profile_path, class: "drawer__link" do %>
            <i class="bi bi-person me-2"></i> <%= t("account.drawer.my_account") %>
          <% end %>
        </li>
      <% else %>
        <li>
          <%= link_to new_user_session_path, class: "drawer__link" do %>
            <i class="bi bi-person me-2"></i> <%= t("account.short_label") %>
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to "/carrinho", class: "drawer__link" do %>
          <i class="bi bi-handbag me-2"></i> Carrinho
        <% end %>
      </li>
    </ul>
  </nav>

  <div class="drawer__footer p-3 border-top">
    <a href="https://wa.me/5535920001100" target="_blank" rel="noopener" class="btn btn-success w-100">
      <i class="bi bi-whatsapp me-1"></i> Falar no WhatsApp
    </a>
  </div>
</aside>

<div class="drawer__backdrop" data-drawer-dismiss="true" aria-hidden="true"></div>
