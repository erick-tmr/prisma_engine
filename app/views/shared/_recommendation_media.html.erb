<%# locals: (recommendation:) %>
<% if recommendation.favicon.attached? %>
  <%= storefront_image_tag Storefront::ImageSource.call(recommendation.favicon),
        class: "partner-avatar partner-avatar--img",
        alt: "", width: 36, height: 36, loading: "lazy" %>
<% else %>
  <span class="partner-avatar" style="--avatar-gradient: <%= recommendation.avatar_gradient %>"><%= recommendation.letter_avatar_initial %></span>
<% end %>
<span class="partner-meta">
  <strong><%= recommendation.display_title %></strong>
  <small><%= recommendation.tagline %></small>
</span>
<i class="bi bi-box-arrow-up-right partner-link-ic" aria-hidden="true"></i>
