<% content_for :title, "Prisma Games — Game Boy ❤️" %>

<section class="hero bg-dark text-light py-5 mb-4">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-7">
        <h1 class="display-5 font-weight-bold mb-3">Game Boy <span class="text-danger">❤️</span></h1>
        <p class="lead mb-4">
          Hardware e jogos sob demanda para o portátil da Nintendo. Cartuchos
          com FRAM, saves duradouros, ber&ccedil;o e caixa em papel mais grosso —
          produzidos no Brasil com garantia.
        </p>
        <div>
          <%= link_to "Ver todos os jogos", products_path, class: "btn btn-light btn-lg mr-2" %>
          <a href="https://wa.me/5535920001100" target="_blank" rel="noopener" class="btn btn-success btn-lg">
            <i class="bi bi-whatsapp"></i> Falar no WhatsApp
          </a>
        </div>
      </div>
      <div class="col-md-5 text-center mt-4 mt-md-0">
        <img src="/images/stores/uploads/2359718/prisma-games.png" alt="Prisma Games" class="img-fluid bg-light p-3 rounded" style="max-height: 220px;">
      </div>
    </div>
  </div>
</section>

<section class="container mb-5">
  <div class="row">
    <div class="col-md-6 mb-4">
      <%= link_to category_path(slug: "game-boy-classic", category_id: 351512), class: "card text-white text-decoration-none" do %>
        <% sample = @classic.first %>
        <% if sample&.image %>
          <img src="<%= sample.image %>" alt="Game Boy Classic" class="card-img" style="max-height: 240px; object-fit: cover; filter: brightness(0.55);">
        <% end %>
        <div class="card-img-overlay d-flex align-items-end">
          <div>
            <h2 class="h4 mb-0">Game Boy Classic</h2>
            <p class="mb-0 small">Cartuchos e hardware</p>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-md-6 mb-4">
      <%= link_to category_path(slug: "game-boy-color", category_id: 354342), class: "card text-white text-decoration-none" do %>
        <% sample = @color.first %>
        <% if sample&.image %>
          <img src="<%= sample.image %>" alt="Game Boy Color" class="card-img" style="max-height: 240px; object-fit: cover; filter: brightness(0.55);">
        <% end %>
        <div class="card-img-overlay d-flex align-items-end">
          <div>
            <h2 class="h4 mb-0">Game Boy Color</h2>
            <p class="mb-0 small">Linha colorida</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="container mb-5">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <h2 class="h4 mb-0">Em destaque</h2>
    <%= link_to "Ver tudo →", products_path, class: "small text-muted" %>
  </div>
  <div class="row">
    <% @featured.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="bg-light py-5 mb-5">
  <div class="container text-center">
    <h2 class="h3 mb-3">Atendimento direto pelo WhatsApp</h2>
    <p class="text-muted mb-4">
      Tire dúvidas sobre disponibilidade, frete ou patches específicos.
      Respondemos de segunda a sábado.
    </p>
    <a href="https://wa.me/5535920001100" target="_blank" rel="noopener" class="btn btn-success btn-lg">
      <i class="bi bi-whatsapp"></i> (35) 9 2000-1100
    </a>
  </div>
</section>
