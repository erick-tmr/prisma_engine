<% content_for :title, "Prisma Games | Game Boy ❤️" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "components/mes-pill", "pages/home" %>
<% end %>

<%= render "first_visit_warning" unless cookies[:pg_aviso_home_v1] %>

<% if @banners.any? %>
  <section class="banner">
    <div class="owl-carousel owl-theme"
         data-loop="true"
         data-nav="false"
         data-dots="true"
         data-autoplay="true"
         data-items-xs="1"
         data-items-sm="1"
         data-items-md="1"
         data-items-lg="1"
         data-items-xl="1">
      <% @banners.each_with_index do |banner, index| %>
        <% banner_src = Storefront::ImageSource.call(banner.image) %>
        <% content_for :head, hero_preload_link(banner_src) if index.zero? %>
        <div class="banner__slot">
          <%= storefront_image_tag banner_src, preset: :hero, alt: banner.alt,
                width: 1110, height: 550, loading: (index.zero? ? "eager" : "lazy"),
                fetchpriority: (index.zero? ? "high" : nil) %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if @current_gotm && @current_gotm.game_of_the_month_products.any? %>
  <% cache gotm_band_cache_key(@current_gotm) do %>
    <%= render "game_of_month", gotm: @current_gotm %>
  <% end %>
<% end %>

<section class="section">
  <%= render "block_title", slug: "pedidos-de-jogos",
                            label: "Pedidos de Jogos",
                            icon: "clipboard-check" %>
  <div class="row">
    <% cache product_cards_cache_key(@pedidos) do %>
      <%= render partial: "products/card", collection: @pedidos, as: :product %>
    <% end %>
  </div>
</section>

<section class="section">
  <%= render "block_title", slug: "miscelanea",
                            label: "Extras & Acessórios",
                            icon: "box-seam" %>
  <div class="row">
    <% cache product_cards_cache_key(@extras) do %>
      <%= render partial: "products/card", collection: @extras, as: :product %>
    <% end %>
  </div>
</section>

<section class="section">
  <%= render "block_title", slug: "game-boy-classic",
                            label: "Game Boy Classic" %>
  <div class="row">
    <% cache product_cards_cache_key(@classic) do %>
      <%= render partial: "products/card", collection: @classic, as: :product %>
    <% end %>
  </div>
</section>

<section class="section">
  <%= render "block_title", slug: "game-boy-color",
                            label: "Game Boy Color",
                            logo: "game-boy-color-horizontal" %>
  <div class="row">
    <% cache product_cards_cache_key(@color) do %>
      <%= render partial: "products/card", collection: @color, as: :product %>
    <% end %>
  </div>
</section>

<section class="cta-band">
  <div class="cta-band__inner">
    <h2>Atendimento direto pelo WhatsApp</h2>
    <p>
      Tire dúvidas sobre disponibilidade, frete ou patches específicos.
      Respondemos de segunda a sábado.
    </p>
    <%= link_to "https://wa.me/5535920001100",
                class: "cta-band__btn", target: "_blank", rel: "noopener" do %>
      <i class="bi bi-whatsapp" aria-hidden="true"></i> (35) 9 2000-1100
    <% end %>
  </div>
</section>

<% content_for :scripts do %>
  <%= javascript_include_tag "storefront/game_of_month", type: "module" %>
<% end %>
