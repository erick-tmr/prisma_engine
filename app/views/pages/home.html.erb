<% content_for :title, "Prisma Games — Game Boy ❤️" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "pages/home" %>
<% end %>

<% if @banners.any? %>
  <section class="banner">
    <div class="owl-carousel owl-theme"
         data-loop="true"
         data-nav="false"
         data-dots="true"
         data-autoplay="true"
         data-items-xs="1"
         data-items-sm="1"
         data-items-md="1"
         data-items-lg="1"
         data-items-xl="1">
      <% @banners.each_with_index do |banner, index| %>
        <div class="banner__slot">
          <img src="<%= Storefront::ImageSource.call(banner.image) %>" alt="<%= banner.alt %>" width="1110" height="550" loading="<%= index.zero? ? "eager" : "lazy" %>">
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<section class="section">
  <%= render "block_title", slug: "pedidos-de-jogos",
                            label: "Pedidos de Jogos",
                            icon: "clipboard-check" %>
  <div class="row">
    <% @pedidos.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="section">
  <%= render "block_title", slug: "miscelanea",
                            label: "Extras & Acessórios",
                            icon: "box-seam" %>
  <div class="row">
    <% @extras.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="section">
  <%= render "block_title", slug: "game-boy-classic",
                            label: "Game Boy Classic" %>
  <div class="row">
    <% @classic.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="section">
  <%= render "block_title", slug: "game-boy-color",
                            label: "Game Boy Color",
                            logo: "game-boy-color-horizontal" %>
  <div class="row">
    <% @color.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="cta-band">
  <div class="cta-band__inner">
    <h2>Atendimento direto pelo WhatsApp</h2>
    <p>
      Tire dúvidas sobre disponibilidade, frete ou patches específicos.
      Respondemos de segunda a sábado.
    </p>
    <%= link_to "https://wa.me/5535920001100",
                class: "cta-band__btn", target: "_blank", rel: "noopener" do %>
      <i class="bi bi-whatsapp" aria-hidden="true"></i> (35) 9 2000-1100
    <% end %>
  </div>
</section>
