<% content_for :title, "Prisma Games — Game Boy ❤️" %>

<section class="pg-banner-wrap">
  <div class="owl-carousel owl-theme"
       data-loop="true"
       data-nav="false"
       data-dots="true"
       data-autoplay="true"
       data-items-xs="1"
       data-items-sm="1"
       data-items-md="1"
       data-items-lg="1"
       data-items-xl="1">
    <div class="banner-slot">
      <img src="/images/stores/uploads/2475313/conversions/large.jpg" alt="Banner Pokémon Yellow" loading="eager">
    </div>
    <div class="banner-slot">
      <img src="/images/stores/uploads/2690742/conversions/large.jpg" alt="Banner Game Boy Color" loading="lazy">
    </div>
    <div class="banner-slot">
      <img src="/images/stores/uploads/2475445/conversions/large.jpg" alt="Banner Pokémon Hack" loading="lazy">
    </div>
  </div>
</section>

<section class="pg-section">
  <%= render "block_title", slug: "game-boy-classic", category_id: 351512,
                            label: "Game Boy Classic" %>
  <div class="row">
    <% @classic.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="pg-section">
  <%= render "block_title", slug: "game-boy-color", category_id: 354342,
                            label: "Game Boy Color",
                            logo: "game-boy-color-horizontal" %>
  <div class="row">
    <% @color.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="bg-light py-5 mb-5">
  <div class="container text-center">
    <h2 class="h3 mb-3">Atendimento direto pelo WhatsApp</h2>
    <p class="text-muted mb-4">
      Tire dúvidas sobre disponibilidade, frete ou patches específicos.
      Respondemos de segunda a sábado.
    </p>
    <a href="https://wa.me/5535920001100" target="_blank" rel="noopener" class="btn btn-success btn-lg">
      <i class="bi bi-whatsapp"></i> (35) 9 2000-1100
    </a>
  </div>
</section>
