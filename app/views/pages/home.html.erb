<% content_for :title, "Prisma Games — Game Boy ❤️" %>

<section class="pg-banner-wrap">
  <div class="owl-carousel owl-theme"
       data-loop="true"
       data-nav="false"
       data-dots="true"
       data-autoplay="true"
       data-items-xs="1"
       data-items-sm="1"
       data-items-md="1"
       data-items-lg="1"
       data-items-xl="1">
    <div class="banner-slot">
      <img src="/images/stores/uploads/2475313/conversions/large.jpg" alt="Banner Pokémon Yellow" loading="eager">
    </div>
    <div class="banner-slot">
      <img src="/images/stores/uploads/2690742/conversions/large.jpg" alt="Banner Game Boy Color" loading="lazy">
    </div>
    <div class="banner-slot">
      <img src="/images/stores/uploads/2475445/conversions/large.jpg" alt="Banner Pokémon Hack" loading="lazy">
    </div>
  </div>
</section>

<section class="pg-section">
  <div class="block-title-wrap">
    <%= link_to category_path(slug: "game-boy-classic", category_id: 351512),
          class: "block-title-logo", aria: { label: "Ver tudo de Game Boy Classic" } do %>
      <span class="nav-chip-circle">
        <img src="/images/nav-logos/game-boy-classic.jpg" alt="" width="72" height="72">
      </span>
      <h2 class="block-title">Game Boy Classic</h2>
    <% end %>
    <div class="rainbow-runner" aria-hidden="true"></div>
    <%= link_to "Ver tudo →",
          category_path(slug: "game-boy-classic", category_id: 351512),
          class: "section-see-all" %>
  </div>
  <div class="row">
    <% @classic.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="pg-section">
  <div class="block-title-wrap">
    <%= link_to category_path(slug: "game-boy-color", category_id: 354342),
          class: "block-title-logo", aria: { label: "Ver tudo de Game Boy Color" } do %>
      <span class="nav-chip-circle">
        <img src="/images/nav-logos/game-boy-color.jpg" alt="" width="72" height="72">
      </span>
      <h2 class="block-title">Game Boy Color</h2>
    <% end %>
    <div class="rainbow-runner" aria-hidden="true"></div>
    <%= link_to "Ver tudo →",
          category_path(slug: "game-boy-color", category_id: 354342),
          class: "section-see-all" %>
  </div>
  <div class="row">
    <% @color.each do |product| %>
      <%= render "products/card", product: product %>
    <% end %>
  </div>
</section>

<section class="bg-light py-5 mb-5">
  <div class="container text-center">
    <h2 class="h3 mb-3">Atendimento direto pelo WhatsApp</h2>
    <p class="text-muted mb-4">
      Tire dúvidas sobre disponibilidade, frete ou patches específicos.
      Respondemos de segunda a sábado.
    </p>
    <a href="https://wa.me/5535920001100" target="_blank" rel="noopener" class="btn btn-success btn-lg">
      <i class="bi bi-whatsapp"></i> (35) 9 2000-1100
    </a>
  </div>
</section>
