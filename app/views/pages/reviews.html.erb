<% content_for :title, "Reviews — Prisma Games" %>

<div class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 small">
      <li class="breadcrumb-item"><%= link_to "Início", root_path %></li>
      <li class="breadcrumb-item active" aria-current="page">Reviews</li>
    </ol>
  </nav>

  <h1 class="h3 mb-3">Reviews</h1>
  <p class="text-muted mb-4">
    Depoimentos de quem já recebeu seus cartuchos e hardware. Conteúdo a ser
    preenchido a partir da página atual do site.
  </p>

  <div class="row">
    <% 6.times do |i| %>
      <div class="col-md-6 mb-4">
        <blockquote class="card h-100 shadow-sm p-3 mb-0">
          <div class="text-warning small mb-2">
            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
          </div>
          <p class="text-muted small mb-2">
            Espaço reservado para o depoimento — substituir pelo texto vindo da página atual.
          </p>
          <footer class="small text-muted">— Cliente</footer>
        </blockquote>
      </div>
    <% end %>
  </div>

  <div class="bg-light text-center py-4 mt-3 rounded">
    <p class="mb-2">Comprou e quer compartilhar sua experiência?</p>
    <a href="https://wa.me/5535920001100" target="_blank" rel="noopener" class="btn btn-success">
      <i class="bi bi-whatsapp"></i> Enviar review pelo WhatsApp
    </a>
  </div>
</div>
