<% content_for :title, "Recomendação de jogos — Prisma Games" %>

<div class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 small">
      <li class="breadcrumb-item"><%= link_to "Início", root_path %></li>
      <li class="breadcrumb-item active" aria-current="page">Recomendação de jogos</li>
    </ol>
  </nav>

  <h1 class="h3 mb-3">Recomendação de jogos</h1>
  <p class="text-muted mb-4">
    Curadoria por categoria — RPGs, plataforma, puzzles, hacks e clássicos
    indispensáveis. Texto detalhado a ser preenchido a partir da página atual do site.
  </p>

  <div class="row">
    <% [
      ["RPGs",      "Jogos de história longa, exploração e progressão de personagens."],
      ["Plataforma","Os clássicos de pulo e fase do catálogo Game Boy."],
      ["Puzzles",   "Jogos de raciocínio, ideais para sessões curtas."],
      ["Hacks",     "Romhacks notáveis traduzidos ou expandidos pela comunidade."],
    ].each do |label, blurb| %>
      <div class="col-md-6 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h2 class="h5"><%= label %></h2>
            <p class="text-muted small mb-3"><%= blurb %></p>
            <%= link_to "Ver no catálogo →", products_path, class: "small" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
