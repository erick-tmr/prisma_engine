<%# locals: (slug:, label:, logo: nil, icon: nil) %>
<% logo ||= slug %>

<div class="section-title">
  <%= link_to category_path(slug: slug),
              class: "section-title__logo", "aria-label": "Ver tudo de #{label}" do %>
    <div class="section-title__center">
      <% if icon %>
        <span class="section-title__wordmark">
          <span class="wm-ic" aria-hidden="true"><i class="bi bi-<%= icon %>"></i></span>
          <%= label %>
        </span>
      <% else %>
        <img src="/images/nav-logos/<%= logo %>.svg"
             alt="<%= label %>" loading="lazy">
      <% end %>
      <span class="rainbow-bar" aria-hidden="true"></span>
    </div>
  <% end %>

  <h2 class="sr-only"><%= label %></h2>

  <%= link_to category_path(slug: slug),
              class: "section-title__see-all" do %>
    Ver tudo <i class="bi bi-arrow-right" aria-hidden="true"></i>
  <% end %>
</div>
