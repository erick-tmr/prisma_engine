<%= render layout: "shared/email_card", locals: {
      badge_label: t("reset_password_mailer.badge_label"),
      badge_color: "#007bff",
      hero_image: "dragon-letter-full.png",
      hero_height: 180,
      heading: t("reset_password_mailer.heading"),
      first_name: @resource.first_name
    } do %>
  <tr>
    <td style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("reset_password_mailer.intro") %>
    </td>
  </tr>
  <tr>
    <td style="padding:16px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.55;color:#6b7280;">
      <%= t("reset_password_mailer.disclaimer") %>
    </td>
  </tr>
  <%= render "shared/email_cta", url: edit_password_url(@resource, reset_password_token: @token), label: t("reset_password_mailer.cta") %>
<% end %>
