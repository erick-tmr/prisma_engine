<%= render layout: "shared/email_card", locals: {
      badge_label: t("confirmation_mailer.badge_label"),
      badge_color: "#0f9d58",
      hero_image: "dragon-fly.png",
      hero_height: 150,
      heading: t("confirmation_mailer.heading"),
      first_name: @resource.first_name
    } do %>
  <tr>
    <td class="px" style="padding:14px 40px 0;font-family:'Inter',-apple-system,'Segoe UI',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
      <%= t("confirmation_mailer.intro") %>
    </td>
  </tr>
  <%= render "shared/email_cta", url: confirmation_url(@resource, confirmation_token: @token), label: t("confirmation_mailer.cta") %>
<% end %>
