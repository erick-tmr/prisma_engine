<% content_for :title, t("auth.page_title.sign_in") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "pages/auth" %>
<% end %>

<div class="auth">
  <div class="auth__card">
    <div class="auth__brand">
      <div class="auth__prism" aria-hidden="true">
        <span class="auth__ray auth__ray--soft"></span>
        <span class="auth__ray auth__ray--line"></span>
      </div>
      <span class="auth__wordmark">Prisma Games</span>
    </div>

    <div class="auth__form-side">
      <div class="auth__switch">
        <%= link_to t("auth.switch.sign_in"), new_session_path(resource_name), class: "is-active" %>
        <%= link_to t("auth.switch.sign_up"), new_registration_path(resource_name) %>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth__form", novalidate: true }) do |f| %>
        <div class="field">
          <%= f.label :email, t("auth.fields.email"), class: "field__label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field__input", required: true, placeholder: "voce@email.com" %>
        </div>

        <div class="field">
          <%= f.label :password, t("auth.fields.password"), class: "field__label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "field__input", required: true, placeholder: "••••••••" %>
        </div>

        <div class="auth__meta-row">
          <% if devise_mapping.rememberable? %>
            <label class="auth__check">
              <%= f.check_box :remember_me %> <%= t("auth.fields.remember_me") %>
            </label>
          <% else %>
            <span></span>
          <% end %>
          <%= link_to t("auth.sign_in.forgot_password"), new_password_path(resource_name), class: "auth__forgot" %>
        </div>

        <%= f.submit t("auth.sign_in.submit"), class: "button button--block" %>
      <% end %>

      <div class="auth__foot">
        <%= t("auth.sign_in.no_account") %>
        <%= link_to t("auth.sign_in.sign_up"), new_registration_path(resource_name) %>
      </div>
    </div>
  </div>
</div>
