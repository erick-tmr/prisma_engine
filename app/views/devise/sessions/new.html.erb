<% content_for :title, t("auth.page_title.sign_in") %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <div class="auth-prism" aria-hidden="true">
        <span class="ray-soft"></span>
        <span class="ray-line"></span>
      </div>
      <span class="auth-wordmark">Prisma Games</span>
    </div>

    <div class="auth-form-side">
      <div class="auth-switch">
        <%= link_to t("auth.switch.sign_in"), new_session_path(resource_name), class: "active" %>
        <%= link_to t("auth.switch.sign_up"), new_registration_path(resource_name) %>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form", novalidate: true }) do |f| %>
        <div class="field">
          <%= f.label :email, t("auth.fields.email"), class: "field-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input", required: true, placeholder: "voce@email.com" %>
        </div>

        <div class="field">
          <%= f.label :password, t("auth.fields.password"), class: "field-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "field-input", required: true, placeholder: "••••••••" %>
        </div>

        <div class="auth-meta-row">
          <% if devise_mapping.rememberable? %>
            <label class="auth-check">
              <%= f.check_box :remember_me %> <%= t("auth.fields.remember_me") %>
            </label>
          <% else %>
            <span></span>
          <% end %>
          <%= link_to t("auth.sign_in.forgot_password"), new_password_path(resource_name), class: "auth-forgot" %>
        </div>

        <%= f.submit t("auth.sign_in.submit"), class: "btn-prisma block" %>
      <% end %>

      <div class="auth-foot">
        <%= t("auth.sign_in.no_account") %>
        <%= link_to t("auth.sign_in.sign_up"), new_registration_path(resource_name) %>
        <span class="auth-foot-sep">·</span>
        <%= link_to t("auth.sign_in.resend_confirmation"), new_confirmation_path(resource_name) %>
      </div>
    </div>
  </div>
</div>
