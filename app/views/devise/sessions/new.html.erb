<% content_for :title, t("auth.page_title.sign_in") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h4 mb-3 text-center"><%= t("auth.sign_in.heading") %></h1>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { novalidate: true }) do |f| %>
            <div class="mb-3">
              <%= f.label :email, t("auth.fields.email"), class: "form-label small" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :password, t("auth.fields.password"), class: "form-label small" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control", required: true %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="mb-3 form-check">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, t("auth.fields.remember_me"), class: "form-check-label small" %>
              </div>
            <% end %>

            <%= f.submit t("auth.sign_in.submit"), class: "btn btn-dark w-100" %>
          <% end %>

          <hr class="my-4">

          <div class="d-flex flex-column gap-2 small text-center">
            <%= link_to t("auth.sign_in.forgot_password"), new_password_path(resource_name) %>
            <%= link_to t("auth.sign_in.resend_confirmation"), new_confirmation_path(resource_name) %>
            <div class="text-muted">
              <%= t("auth.sign_in.no_account") %>
              <%= link_to t("auth.sign_in.sign_up"), new_registration_path(resource_name) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
