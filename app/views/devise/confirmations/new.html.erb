<% content_for :title, t("auth.confirmations.page_title") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "pages/auth" %>
<% end %>

<div class="auth">
  <div class="auth__card">
    <div class="auth__brand">
      <div class="auth__prism" aria-hidden="true">
        <span class="auth__ray auth__ray--soft"></span>
        <span class="auth__ray auth__ray--line"></span>
      </div>
      <span class="auth__wordmark">Prisma Games</span>
    </div>

    <div class="auth__form-side">
      <div class="confirm__hero-ic"><i class="bi bi-envelope-check"></i></div>
      <h1 class="auth__heading"><%= t("auth.confirmations.heading") %></h1>
      <p class="auth__sub">
        <%= @email.present? ? t("auth.confirmations.lede_known") : t("auth.confirmations.lede_unknown") %>
      </p>

      <% if @editable_email %>
        <div class="confirm__email" data-email-edit>
          <span class="confirm__email-pill" data-email-edit-view>
            <i class="bi bi-envelope"></i> <%= @email %>
            <button type="button" class="confirm__email-edit" data-email-edit-open>
              <i class="bi bi-pencil-square"></i> <%= t("auth.confirmations.edit") %>
            </button>
          </span>
          <%= form_with url: signup_email_path, method: :patch, scope: :user, class: "confirm__email-form", data: { email_edit_form: "" }, html: { hidden: true, novalidate: true } do |f| %>
            <div class="field">
              <%= f.label :email, t("auth.fields.email"), class: "field__label" %>
              <%= f.email_field :email, value: @email, autocomplete: "email", class: "field__input", required: true %>
            </div>
            <div class="confirm__email-actions">
              <button type="submit" class="button"><%= t("auth.confirmations.edit_submit") %></button>
              <button type="button" class="button-ghost" data-email-edit-cancel><%= t("auth.confirmations.edit_cancel") %></button>
            </div>
          <% end %>
        </div>
      <% elsif @email.present? %>
        <span class="confirm__email-pill"><i class="bi bi-envelope"></i> <%= @email %></span>
      <% end %>

      <ol class="confirm__steps">
        <li>
          <span class="n">1</span>
          <span class="t"><%= t("auth.confirmations.steps.one_title") %><small><%= t("auth.confirmations.steps.one_hint") %></small></span>
        </li>
        <li>
          <span class="n">2</span>
          <span class="t"><%= t("auth.confirmations.steps.two_title") %><small><%= t("auth.confirmations.steps.two_hint") %></small></span>
        </li>
        <li>
          <span class="n">3</span>
          <span class="t"><%= t("auth.confirmations.steps.three_title") %><small><%= t("auth.confirmations.steps.three_hint") %></small></span>
        </li>
      </ol>

      <div class="confirm__resend">
        <p class="confirm__resend-text"><%= t("auth.confirmations.resend_hint") %></p>
        <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "auth__form", novalidate: true, data: { resend: "", resend_deadline: @resend_deadline&.iso8601, resend_wait_text: t("auth.resend.wait_text") } }) do |f| %>
          <% if @email.present? %>
            <%= f.hidden_field :email, value: @email %>
          <% else %>
            <div class="field">
              <%= f.label :email, t("auth.fields.email"), class: "field__label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field__input", required: true, placeholder: "voce@email.com" %>
            </div>
          <% end %>
          <button type="submit" class="button-ghost" data-resend-submit>
            <i class="bi bi-arrow-repeat"></i> <%= t("auth.confirmations.resend_submit") %>
          </button>
          <span class="confirm__resend-status" data-resend-status aria-live="polite"></span>
        <% end %>
      </div>

      <div class="auth__foot">
        <%= link_to t("auth.confirmations.to_sign_in"), new_session_path(resource_name) %>
      </div>
    </div>
  </div>
</div>

<% content_for :scripts do %>
  <%= javascript_include_tag "storefront/resend_cooldown", type: "module" %>
  <%= javascript_include_tag "storefront/signup_email_edit", type: "module" if @editable_email %>
<% end %>
