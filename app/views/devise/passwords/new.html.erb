<% content_for :title, t("auth.page_title.forgot_password") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h4 mb-2 text-center"><%= t("auth.passwords.new_heading") %></h1>
          <p class="text-muted small text-center mb-4"><%= t("auth.passwords.new_lede") %></p>

          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, novalidate: true }) do |f| %>
            <div class="mb-3">
              <%= f.label :email, t("auth.fields.email"), class: "form-label small" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %>
            </div>

            <%= f.submit t("auth.passwords.new_submit"), class: "btn btn-dark w-100" %>
          <% end %>

          <hr class="my-4">

          <div class="d-flex flex-column gap-2 small text-center">
            <%= link_to t("auth.sign_in.submit"), new_session_path(resource_name) %>
            <%= link_to t("auth.sign_in.sign_up"), new_registration_path(resource_name) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
