<% content_for :title, t("auth.page_title.reset_password") %>
<% content_for :head do %>
  <%= stylesheet_link_tag "pages/auth" %>
<% end %>

<div class="auth">
  <div class="auth__card">
    <div class="auth__brand">
      <div class="auth__prism" aria-hidden="true">
        <span class="auth__ray auth__ray--soft"></span>
        <span class="auth__ray auth__ray--line"></span>
      </div>
      <span class="auth__wordmark">Prisma Games</span>
    </div>

    <div class="auth__form-side">
      <h1 class="auth__heading"><%= t("auth.passwords.edit_heading") %></h1>
      <p class="auth__sub"><%= t("auth.passwords.edit_lede") %></p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth__form", novalidate: true }) do |f| %>
        <%= f.hidden_field :reset_password_token %>

        <%= render "shared/form_errors", record: resource %>

        <div class="field">
          <%= f.label :password, t("auth.fields.password"), class: "field__label" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "field__input", required: true, minlength: @minimum_password_length, placeholder: "••••••••" %>
          <% if @minimum_password_length %>
            <span class="field__hint"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></span>
          <% end %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation, t("auth.fields.password_confirmation"), class: "field__label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field__input", required: true, placeholder: "••••••••" %>
        </div>

        <%= f.submit t("auth.passwords.edit_submit"), class: "button button--block auth__submit" %>
      <% end %>
    </div>
  </div>
</div>
