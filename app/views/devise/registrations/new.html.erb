<% content_for :title, t("auth.page_title.sign_up") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h4 mb-3 text-center"><%= t("auth.sign_up.heading") %></h1>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { novalidate: true }) do |f| %>
            <% if resource.errors.any? %>
              <div class="alert alert-danger" role="alert">
                <ul class="mb-0 ps-3">
                  <% resource.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :full_name, t("auth.fields.full_name"), class: "form-label small" %>
              <%= f.text_field :full_name, autofocus: true, autocomplete: "name", class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :email, t("auth.fields.email"), class: "form-label small" %>
              <%= f.email_field :email, autocomplete: "email", class: "form-control", required: true %>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :cpf, t("auth.fields.cpf"), class: "form-label small" %>
                <%= f.text_field :cpf, autocomplete: "off", class: "form-control", required: true, data: { "mask-cpf": true }, inputmode: "numeric" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :phone, t("auth.fields.phone"), class: "form-label small" %>
                <%= f.telephone_field :phone, autocomplete: "tel", class: "form-control", data: { "mask-phone": true } %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :password, t("auth.fields.password"), class: "form-label small" %>
                <%= f.password_field :password, autocomplete: "new-password", class: "form-control", required: true, minlength: @minimum_password_length %>
                <% if @minimum_password_length %>
                  <div class="form-text"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></div>
                <% end %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :password_confirmation, t("auth.fields.password_confirmation"), class: "form-label small" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", required: true %>
              </div>
            </div>

            <%= f.submit t("auth.sign_up.submit"), class: "btn btn-success w-100" %>
          <% end %>

          <hr class="my-4">

          <p class="small text-muted text-center mb-0">
            <%= t("auth.sign_up.has_account") %>
            <%= link_to t("auth.sign_up.sign_in"), new_session_path(resource_name) %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
