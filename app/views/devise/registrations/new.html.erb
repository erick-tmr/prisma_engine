<% content_for :title, t("auth.page_title.sign_up") %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <div class="auth-prism" aria-hidden="true">
        <span class="ray-soft"></span>
        <span class="ray-line"></span>
      </div>
      <span class="auth-wordmark">Prisma Games</span>
    </div>

    <div class="auth-form-side">
      <div class="auth-switch">
        <%= link_to t("auth.switch.sign_in"), new_session_path(resource_name) %>
        <%= link_to t("auth.switch.sign_up"), new_registration_path(resource_name), class: "active" %>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form", novalidate: true }) do |f| %>
        <%= render "shared/form_errors", record: resource %>

        <div class="field">
          <%= f.label :full_name, t("auth.fields.full_name"), class: "field-label" %>
          <%= f.text_field :full_name, autofocus: true, autocomplete: "name", class: "field-input", required: true, placeholder: t("auth.placeholders.full_name") %>
        </div>

        <div class="field">
          <%= f.label :email, t("auth.fields.email"), class: "field-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "field-input", required: true, placeholder: "voce@email.com" %>
        </div>

        <div class="auth-row">
          <div class="field">
            <%= f.label :cpf, t("auth.fields.cpf"), class: "field-label" %>
            <%= f.text_field :cpf, autocomplete: "off", class: "field-input", required: true, data: { "mask-cpf": true }, inputmode: "numeric", placeholder: "000.000.000-00" %>
          </div>
          <div class="field">
            <%= f.label :phone, t("account.profile.phone_label"), class: "field-label" %>
            <%= f.telephone_field :phone, autocomplete: "tel", class: "field-input", required: true, data: { "mask-phone": true }, placeholder: "(00) 00000-0000" %>
          </div>
        </div>

        <div class="auth-row">
          <div class="field">
            <%= f.label :password, t("auth.fields.password"), class: "field-label" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "field-input", required: true, minlength: @minimum_password_length, placeholder: "••••••••" %>
            <% if @minimum_password_length %>
              <span class="field-hint"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></span>
            <% end %>
          </div>
          <div class="field">
            <%= f.label :password_confirmation, t("auth.fields.password_confirmation"), class: "field-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input", required: true, placeholder: "••••••••" %>
          </div>
        </div>

        <%= f.submit t("auth.sign_up.submit"), class: "btn-prisma block", style: "margin-top:6px;" %>

        <p class="auth-terms"><%= t("auth.sign_up.terms_html").html_safe %></p>
      <% end %>

      <div class="auth-foot">
        <%= t("auth.sign_up.has_account") %>
        <%= link_to t("auth.sign_up.sign_in"), new_session_path(resource_name) %>
      </div>
    </div>
  </div>
</div>
