<% content_for :title, t("account.orders.show_page_title", number: @order.number) %>

<div class="account__card account__panel">
  <div class="panel__body">
    <%= link_to account_orders_path, class: "account-back" do %>
      <i class="bi bi-arrow-left"></i> <%= t("account.orders.show.back") %>
    <% end %>

    <div class="order-detail__head">
      <div>
        <h2>#<%= @order.number %></h2>
        <div class="sub"><%= t("account.orders.show.placed_on", date: l(@order.placed_at.to_date, format: :long)) %></div>
      </div>
      <span class="status-pill status-pill--<%= @order.status %>">
        <%= t("account.orders.states.#{@order.status}.label") %>
      </span>
    </div>

    <div class="order-detail__status-banner">
      <div class="sb-text">
        <span class="status-pill status-pill--<%= @order.status %>">
          <%= t("account.orders.states.#{@order.status}.label") %>
        </span>
        <p><%= order_state_description(@order) %></p>
      </div>
    </div>

    <% if @order.merged? %>
      <div class="order-detail__status-banner">
        <div class="sb-text">
          <p><%= t("account.orders.show.merged_into_html", number: link_to("##{@order.merged_into.number}", account_order_path(@order.merged_into))) %></p>
        </div>
      </div>
    <% else %>
    <div class="order-detail__subcard">
      <div class="order-detail__subcard-head"><i class="bi bi-bag"></i> <%= t("account.orders.show.items") %></div>

      <% @order.order_items.each do |item| %>
        <div class="order-detail__item">
          <% image = item.image %>
          <div class="order-detail__item-thumb<%= " order-detail__item-thumb--empty" if image.blank? %>">
            <% if image.present? %>
              <%= storefront_image_tag image, resize: 160, alt: item.name, loading: "lazy" %>
            <% else %>
              <i class="bi <%= item.custom_order? ? "bi-card-checklist" : "bi-controller" %> order-detail__item-icon"></i>
            <% end %>
          </div>
          <div class="order-detail__item-info">
            <span class="name"><%= item.name %></span>
            <% if item.chosen_options.any? %>
              <span class="opts"><%= item.chosen_options.join(" · ") %></span>
            <% end %>
            <span class="qty"><%= t("account.orders.show.quantity", count: item.quantity) %> · <%= format_brl(item.unit_price_cents) %></span>
            <% if item.custom_order? %>
              <div class="order-detail__pedido">
                <div class="order-detail__pedido-head"><i class="bi bi-card-checklist"></i> <%= t("account.orders.show.request_heading") %></div>
                <div class="order-detail__pedido-field">
                  <span class="k"><%= t("account.orders.show.requested_game") %></span>
                  <span class="v"><%= item.requested_game %></span>
                </div>
                <div class="order-detail__pedido-field">
                  <span class="k"><%= t("account.orders.show.request_notes") %></span>
                  <span class="v<%= " is-empty" if item.request_notes.blank? %>"><%= item.request_notes.presence || t("account.orders.show.request_notes_blank") %></span>
                </div>
              </div>
            <% end %>
          </div>
          <span class="order-detail__item-line"><%= format_brl(item.line_total_cents) %></span>
        </div>
      <% end %>

      <div class="order-detail__totals">
        <div class="row-t"><span><%= t("account.orders.show.subtotal") %></span><span><%= format_brl(@order.subtotal_cents) %></span></div>
        <div class="row-t"><span><%= t("account.orders.show.shipping") %></span><span><%= format_brl(@order.shipment.shipping_cents) %></span></div>
        <div class="row-t row-total"><span><%= t("account.orders.show.total") %></span><span><%= format_brl(@order.total_cents) %></span></div>
      </div>
    </div>

    <% if @order.observation.present? %>
      <div class="order-detail__subcard">
        <div class="order-detail__subcard-head"><i class="bi bi-chat-left-text"></i> <%= t("account.orders.show.observation") %></div>
        <div class="order-detail__info-body">
          <p class="order-detail__obs"><%= @order.observation %></p>
        </div>
      </div>
    <% end %>

    <div class="order-detail__info-grid">
      <div class="order-detail__subcard">
        <div class="order-detail__subcard-head"><i class="bi bi-geo-alt"></i> <%= t("account.orders.show.shipping_address") %></div>
        <div class="order-detail__info-body">
          <% address = @order.shipment.address %>
          <div class="strong"><%= address[:recipient] %></div>
          <div><%= address[:street] %>, <%= address[:number] %><% if address[:complement].present? %>, <%= address[:complement] %><% end %></div>
          <div><%= address[:neighborhood] %></div>
          <div><%= address[:city] %> · <%= address[:state] %> · CEP <%= number_to_cep(address[:zip]) %></div>
        </div>
      </div>
      <div class="order-detail__subcard">
        <div class="order-detail__subcard-head"><i class="bi bi-wallet2"></i> <%= t("account.orders.show.payment") %></div>
        <div class="order-detail__info-body">
          <div class="order-detail__pay">
            <i class="bi <%= order_payment_method_icon(@order.payment_method) %>"></i>
            <%= order_payment_method_label(@order.payment_method) %>
          </div>
          <div class="order-detail__pay-status is-<%= @order.payment_status %>">
            <i class="bi <%= order_payment_status_icon(@order.payment_status) %>"></i>
            <%= t("account.orders.show.payment_status.#{@order.payment_status}") %>
          </div>
        </div>
      </div>
    </div>

    <%= render "tracking", shipment: @order.shipment,
          title: t("account.orders.show.tracking"), icon: "bi-truck" %>

    <% if @order.shipment.tracking_code.present? || @order.return_shipment&.tracking_code.present? %>
      <% content_for :scripts do %>
        <%= javascript_include_tag "storefront/order_tracking", type: "module" %>
      <% end %>
    <% end %>

    <% end %>

    <% if @order.awaiting_return? || @order.returning? %>
      <div class="order-detail__subcard">
        <div class="order-detail__subcard-head">
          <i class="bi bi-arrow-counterclockwise"></i> <%= t("account.orders.show.return_title") %>
        </div>
        <div class="order-detail__info-body">
          <% if @order.returning? %>
            <div class="strong"><%= t("account.orders.show.return_posted_lead") %></div>
            <div><%= t("account.orders.show.return_posted", code: @order.return_shipment.tracking_code) %></div>
          <% elsif order_return_label_ready?(@order) %>
            <div class="strong"><%= t("account.orders.show.return_instructions_lead") %></div>
            <div class="order-detail__return-package">
              <div class="order-detail__return-package-head"><%= t("account.orders.show.return_package_title") %></div>
              <p><%= t("account.orders.show.return_package_reuse") %></p>
              <p><%= t("account.orders.show.return_package_specs",
                       weight: Shipping.mini_envios_weight, dimensions: Shipping.mini_envios_dimensions) %></p>
              <p class="order-detail__return-package-warn"><%= t("account.orders.show.return_package_over") %></p>
            </div>
            <figure class="order-detail__return-figure">
              <%= image_tag "/images/mini-envios-dimensoes.png", loading: "lazy",
                    alt: t("account.orders.show.return_package_figure_alt",
                           max: Shipping.mini_envios_dimensions, min: Shipping.mini_envios_min_dimensions,
                           weight: Shipping.mini_envios_weight) %>
              <figcaption>
                <i class="bi bi-rulers" aria-hidden="true"></i>
                <span><%= t("account.orders.show.return_package_figure_caption",
                            max: Shipping.mini_envios_dimensions, min: Shipping.mini_envios_min_dimensions,
                            weight: Shipping.mini_envios_weight) %></span>
              </figcaption>
            </figure>
            <ol class="order-detail__return-steps">
              <li><%= t("account.orders.show.return_step_print") %></li>
              <li><%= t("account.orders.show.return_step_label") %></li>
              <li><%= t("account.orders.show.return_step_declaration") %></li>
              <li><%= t("account.orders.show.return_step_post") %></li>
            </ol>
            <p class="order-detail__return-tip">
              <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
              <span><%= t("account.orders.show.return_tip") %></span>
            </p>
            <a class="order-detail__return-btn" href="<%= return_label_account_order_path(@order) %>" target="_blank" rel="noopener">
              <i class="bi bi-download" aria-hidden="true"></i> <%= t("account.orders.show.return_label_cta") %>
            </a>
          <% else %>
            <div class="strong"><%= t("account.orders.show.return_pending_lead") %></div>
            <div><%= t("account.orders.show.return_pending") %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @order.return_shipment %>
      <%= render "tracking", shipment: @order.return_shipment,
            title: t("account.orders.show.return_tracking"), icon: "bi-arrow-counterclockwise" %>
    <% end %>

    <div class="order-detail__support">
      <p class="order-detail__support-text"><%= t("account.orders.show.support_text") %></p>
      <a class="order-detail__support-btn" href="<%= order_support_url(@order) %>" target="_blank" rel="noopener">
        <i class="bi bi-whatsapp" aria-hidden="true"></i> <%= t("account.orders.show.support_cta") %>
      </a>
    </div>
  </div>
</div>
