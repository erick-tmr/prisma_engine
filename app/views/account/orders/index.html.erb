<% content_for :title, t("account.orders.page_title") %>

<div class="account-card account-panel">
  <div class="panel-head">
    <h2><span class="rainbow-bar" aria-hidden="true"></span> <%= t("account.orders.heading") %></h2>
    <p><%= t("account.orders.lede") %></p>
  </div>

  <div class="panel-body">
    <% if @orders.empty? %>
      <div class="empty-state">
        <i class="bi bi-bag"></i>
        <p><%= t("account.orders.empty") %></p>
      </div>
    <% else %>
      <div class="order-list">
        <% @orders.each do |order| %>
          <%= link_to account_order_path(order), class: "order-row" do %>
            <div class="order-row-id">
              <span class="num">#<%= order.number %></span>
              <span class="date"><%= l(order.placed_at.to_date, format: :long) %></span>
            </div>
            <div class="order-row-right">
              <span class="status-pill status-<%= order.status %>">
                <%= t("account.orders.states.#{order.status}.label") %>
              </span>
              <span class="order-row-total"><%= format_brl(order.total_cents) %></span>
              <i class="bi bi-chevron-right order-row-chev"></i>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
