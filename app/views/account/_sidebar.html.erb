<nav class="list-group mb-3" aria-label="<%= t("account.sidebar.heading") %>">
  <%= link_to account_profile_path,
        class: "list-group-item list-group-item-action d-flex align-items-center gap-2 #{'active' if account_section_active?(account_profile_path)}" do %>
    <i class="bi bi-person"></i><span><%= t("account.sections.profile") %></span>
  <% end %>
  <%= link_to account_password_path,
        class: "list-group-item list-group-item-action d-flex align-items-center gap-2 #{'active' if account_section_active?(account_password_path)}" do %>
    <i class="bi bi-key"></i><span><%= t("account.sections.password") %></span>
  <% end %>
  <%= link_to account_addresses_path,
        class: "list-group-item list-group-item-action d-flex align-items-center gap-2 #{'active' if account_section_active?(account_addresses_path)}" do %>
    <i class="bi bi-geo-alt"></i><span><%= t("account.sections.addresses") %></span>
  <% end %>
  <%= link_to account_orders_path,
        class: "list-group-item list-group-item-action d-flex align-items-center gap-2 #{'active' if account_section_active?(account_orders_path)}" do %>
    <i class="bi bi-bag"></i><span><%= t("account.sections.orders") %></span>
  <% end %>
</nav>

<%= button_to destroy_user_session_path,
      method: :delete,
      class: "btn btn-outline-secondary",
      form: { class: "d-grid" } do %>
  <i class="bi bi-box-arrow-right me-2"></i><%= t("account.sections.sign_out") %>
<% end %>
