<% content_for :title, t("account.password.page_title") %>

<div class="account-card account-panel">
  <div class="panel-head">
    <h2><span class="rainbow-bar" aria-hidden="true"></span> <%= t("account.password.heading") %></h2>
    <p><%= t("account.password.lede") %></p>
  </div>

  <div class="panel-body">
    <%= form_with model: current_user, url: account_password_path, method: :patch, html: { novalidate: true } do |f| %>
      <% if current_user.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <ul class="mb-0 ps-3">
            <% current_user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field-grid single">
        <div class="field">
          <%= f.label :current_password, t("account.password.current_label"), class: "field-label" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "field-input", required: true, placeholder: "••••••••" %>
        </div>
      </div>

      <div class="field-grid" style="margin-top: 18px;">
        <div class="field">
          <%= f.label :password, t("account.password.new_label"), class: "field-label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "field-input", required: true, minlength: Devise.password_length.min, placeholder: "••••••••" %>
          <span class="field-hint"><%= t("account.password.min_length", count: Devise.password_length.min) %></span>
        </div>
        <div class="field">
          <%= f.label :password_confirmation, t("account.password.confirm_label"), class: "field-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input", required: true, placeholder: "••••••••" %>
        </div>
      </div>

      <div class="panel-actions">
        <%= f.submit t("account.password.submit"), class: "btn-prisma" %>
        <span class="saved-note"><i class="bi bi-shield-lock"></i> <%= t("account.password.saved_note") %></span>
      </div>
    <% end %>
  </div>
</div>
