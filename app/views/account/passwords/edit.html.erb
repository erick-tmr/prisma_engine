<% content_for :title, t("account.password.page_title") %>

<div class="card shadow-sm">
  <div class="card-body">
    <h1 class="h4 mb-3"><%= t("account.password.heading") %></h1>
    <p class="text-muted small mb-4"><%= t("account.password.lede") %></p>

    <%= form_with model: current_user, url: account_password_path, method: :patch, html: { novalidate: true } do |f| %>
      <% if current_user.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <ul class="mb-0 ps-3">
            <% current_user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :current_password, t("auth.fields.current_password"), class: "form-label small" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control", required: true %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :password, t("account.password.new_label"), class: "form-label small" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control", required: true, minlength: Devise.password_length.min %>
          <div class="form-text"><%= t("devise.shared.minimum_password_length", count: Devise.password_length.min) %></div>
        </div>
        <div class="col-md-6 mb-3">
          <%= f.label :password_confirmation, t("auth.fields.password_confirmation"), class: "form-label small" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", required: true %>
        </div>
      </div>

      <%= f.submit t("account.password.submit"), class: "btn btn-success" %>
    <% end %>
  </div>
</div>
