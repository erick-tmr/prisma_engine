<% content_for :title, t("account.addresses.new_page_title") %>

<div class="account__card account__panel">
  <div class="panel__head">
    <h2><span class="rainbow-bar" aria-hidden="true"></span> <%= t("account.addresses.new_heading") %></h2>
    <p><%= t("account.addresses.new_lede") %></p>
  </div>

  <div class="panel__body">
    <%= render "form",
          address: @address,
          form_url: account_addresses_path,
          form_method: :post,
          submit_label: t("account.addresses.submit_new") %>
  </div>
</div>
