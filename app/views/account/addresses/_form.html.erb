<%= form_with model: address, url: form_url, method: form_method,
              html: { novalidate: true,
                      data: { user_name: current_user.full_name,
                              user_cpf: format_cpf(current_user.cpf) } } do |f| %>
  <%= render "shared/form_errors", record: address %>

  <div class="alert alert-light addr-receiver-notice small">
    <%= t("account.addresses.receiver_notice_html") %>
  </div>

  <div class="form-check addr-receiver-self">
    <%= check_box_tag :receiver_self, "1", false,
                      class: "form-check-input", id: "receiver-self",
                      data: { "receiver-self": true } %>
    <%= label_tag :receiver_self, t("account.addresses.fields.receiver_self"),
                  class: "form-check-label" %>
  </div>

  <div class="addr-form-grid">
    <div class="field col-receiver-name">
      <%= f.label :receiver_name, t("account.addresses.fields.receiver_name"), class: "field-label" %>
      <%= f.text_field :receiver_name, class: "field-input", required: true %>
    </div>
    <div class="field col-receiver-cpf">
      <%= f.label :receiver_cpf, t("account.addresses.fields.receiver_cpf"), class: "field-label" %>
      <%= f.text_field :receiver_cpf, class: "field-input", required: true, inputmode: "numeric", placeholder: "000.000.000-00" %>
    </div>
    <div class="field col-zip">
      <%= f.label :zip, t("account.addresses.fields.zip"), class: "field-label" %>
      <%= f.text_field :zip, class: "field-input", required: true, data: { "mask-cep": true }, inputmode: "numeric", placeholder: "00000-000" %>
    </div>
    <div class="field col-street">
      <%= f.label :street, t("account.addresses.fields.street"), class: "field-label" %>
      <%= f.text_field :street, class: "field-input", required: true, placeholder: "Rua, avenida…" %>
    </div>
    <div class="field col-number">
      <%= f.label :number, t("account.addresses.fields.number"), class: "field-label" %>
      <%= f.text_field :number, class: "field-input", required: true %>
    </div>
    <div class="field col-complement">
      <%= f.label :complement, class: "field-label" do %>
        <%= t("account.addresses.fields.complement").sub(/ \(opcional\)\z/, "") %>
        <span class="opt">(opcional)</span>
      <% end %>
      <%= f.text_field :complement, class: "field-input" %>
    </div>
    <div class="field col-neighborhood">
      <%= f.label :neighborhood, t("account.addresses.fields.neighborhood"), class: "field-label" %>
      <%= f.text_field :neighborhood, class: "field-input", required: true %>
    </div>
    <div class="field col-city">
      <%= f.label :city, t("account.addresses.fields.city"), class: "field-label" %>
      <%= f.text_field :city, class: "field-input", required: true %>
    </div>
    <div class="field col-state">
      <%= f.label :state, t("account.addresses.fields.state"), class: "field-label" %>
      <%= f.select :state, Address::UF_LIST, { include_blank: true }, class: "field-input", required: true %>
    </div>
  </div>

  <div class="panel-actions">
    <%= f.submit submit_label, class: "btn-prisma" %>
    <%= link_to t("account.addresses.cancel"), account_addresses_path, class: "order-back", style: "margin:0;" %>
  </div>
<% end %>

<% content_for :scripts do %>
  <script>
    $(function () {
      $('[data-receiver-self]').on('change', function () {
        var $form = $(this).closest('form');
        var name = this.checked ? $form.data('user-name') : '';
        var cpf  = this.checked ? $form.data('user-cpf')  : '';
        $form.find('[name="address[receiver_name]"]').val(name);
        $form.find('[name="address[receiver_cpf]"]').val(cpf);
      });

      $('[data-mask-cep]').each(function () {
        var $cep = $(this);
        // Treat any CEP already in the field on page load (edit flow) as the
        // baseline — don't refetch unless the customer actually changes it.
        var last = $cep.val().replace(/\D/g, '');
        if (last.length !== 8) last = null;

        $cep.on('blur', function () {
          var digits = $cep.val().replace(/\D/g, '');
          if (digits.length !== 8 || digits === last) return;

          var $form = $cep.closest('form');
          $.getJSON('/minha-conta/enderecos/cep/' + digits)
            .done(function (data) {
              last = digits;
              // Always replace — a sparse response (town-wide CEP) would
              // otherwise leave stale values from the previous CEP behind.
              ['street', 'neighborhood', 'city', 'state'].forEach(function (field) {
                var $input = $form.find('[name="address[' + field + ']"]');
                if ($input.length) $input.val(data[field] || '');
              });
              var $number = $form.find('[name="address[number]"]');
              if ($number.length && !$number.val()) $number.trigger('focus');
            });
        });
      });
    });
  </script>
<% end %>
