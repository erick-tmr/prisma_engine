<%= form_with model: address, url: form_url, method: form_method,
              html: { novalidate: true,
                      data: { user_name: current_user.full_name,
                              user_cpf: format_cpf(current_user.cpf),
                              cep_lookup_url: "#{account_addresses_path}/cep" } } do |f| %>
  <%= render "shared/form_errors", record: address %>

  <div class="alert alert-light address-form__notice small">
    <%= t("account.addresses.receiver_notice_html") %>
  </div>

  <div class="form-check address-form__receiver-self">
    <%= check_box_tag :receiver_self, "1", false,
                      class: "form-check-input", id: "receiver-self",
                      data: { "receiver-self": true } %>
    <%= label_tag :receiver_self, t("account.addresses.fields.receiver_self"),
                  class: "form-check-label" %>
  </div>

  <div class="address-form-grid">
    <div class="field col-receiver-name">
      <%= f.label :receiver_name, t("account.addresses.fields.receiver_name"), class: "field__label" %>
      <%= f.text_field :receiver_name, class: "field__input", required: true %>
    </div>
    <div class="field col-receiver-cpf">
      <%= f.label :receiver_cpf, t("account.addresses.fields.receiver_cpf"), class: "field__label" %>
      <%= f.text_field :receiver_cpf, class: "field__input", required: true, inputmode: "numeric", placeholder: "000.000.000-00" %>
    </div>
    <div class="field col-zip">
      <%= f.label :zip, t("account.addresses.fields.zip"), class: "field__label" %>
      <%= f.text_field :zip, class: "field__input", required: true, data: { "mask-cep": true }, inputmode: "numeric", placeholder: "00000-000" %>
    </div>
    <div class="field col-street">
      <%= f.label :street, t("account.addresses.fields.street"), class: "field__label" %>
      <%= f.text_field :street, class: "field__input", required: true, placeholder: "Rua, avenida…" %>
    </div>
    <div class="field col-number">
      <%= f.label :number, t("account.addresses.fields.number"), class: "field__label" %>
      <%= f.text_field :number, class: "field__input", required: true %>
    </div>
    <div class="field col-complement">
      <%= f.label :complement, class: "field__label" do %>
        <%= t("account.addresses.fields.complement").sub(/ \(opcional\)\z/, "") %>
        <span class="opt">(opcional)</span>
      <% end %>
      <%= f.text_field :complement, class: "field__input" %>
    </div>
    <div class="field col-neighborhood">
      <%= f.label :neighborhood, t("account.addresses.fields.neighborhood"), class: "field__label" %>
      <%= f.text_field :neighborhood, class: "field__input", required: true %>
    </div>
    <div class="field col-city">
      <%= f.label :city, t("account.addresses.fields.city"), class: "field__label" %>
      <%= f.text_field :city, class: "field__input", required: true %>
    </div>
    <div class="field col-state">
      <%= f.label :state, t("account.addresses.fields.state"), class: "field__label" %>
      <%= f.select :state, Address::UF_LIST, { include_blank: true }, class: "field__input", required: true %>
    </div>
  </div>

  <div class="panel__actions">
    <%= f.submit submit_label, class: "button" %>
    <%= link_to t("account.addresses.cancel"), account_addresses_path, class: "account-back" %>
  </div>
<% end %>

<% content_for :scripts do %>
  <%= javascript_include_tag "storefront/address_form", type: "module" %>
<% end %>
