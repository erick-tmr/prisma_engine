<% content_for :title, t("account.profile.page_title") %>

<div class="account-card account-panel">
  <div class="panel-head">
    <h2><span class="rainbow-bar" aria-hidden="true"></span> <%= t("account.profile.heading") %></h2>
    <p><%= t("account.profile.lede") %></p>
  </div>

  <div class="panel-body">
    <%= form_with model: current_user, url: account_profile_path, method: :patch, html: { novalidate: true } do |f| %>
      <%= render "shared/form_errors", record: current_user %>

      <div class="field-grid">
        <div class="field">
          <span class="field-label"><%= t("account.profile.full_name_label") %></span>
          <div class="locked-value">
            <span><%= current_user.full_name %></span>
            <span class="locked-badge"><i class="bi bi-lock-fill"></i> <%= t("account.profile.full_name_locked") %></span>
          </div>
        </div>

        <div class="field">
          <span class="field-label"><%= t("account.profile.cpf_label") %></span>
          <div class="locked-value">
            <span><%= format_cpf(current_user.cpf) %></span>
            <span class="locked-badge"><i class="bi bi-lock-fill"></i> <%= t("account.profile.cpf_locked") %></span>
          </div>
        </div>

        <div class="field">
          <%= f.label :email, t("account.profile.email_label"), class: "field-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "field-input", required: true %>
          <% if current_user.unconfirmed_email.present? %>
            <span class="field-hint">
              <%= t("account.profile.email_pending_html", email: current_user.unconfirmed_email).html_safe %>
            </span>
          <% else %>
            <span class="field-hint"><%= t("account.profile.email_change_hint") %></span>
          <% end %>
        </div>

        <div class="field">
          <%= f.label :phone, class: "field-label" do %>
            <%= t("account.profile.phone_label") %> <span class="opt"><%= t("account.profile.phone_optional") %></span>
          <% end %>
          <%= f.telephone_field :phone, autocomplete: "tel", class: "field-input", data: { "mask-phone": true } %>
        </div>
      </div>

      <div class="panel-actions">
        <%= f.submit t("account.profile.submit"), class: "btn-prisma" %>
        <span class="saved-note"><i class="bi bi-shield-check"></i> <%= t("account.profile.saved_note") %></span>
      </div>
    <% end %>
  </div>
</div>
