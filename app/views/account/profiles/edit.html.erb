<% content_for :title, t("account.profile.page_title") %>

<div class="account__card account__panel">
  <div class="panel__head">
    <h2><span class="rainbow-bar" aria-hidden="true"></span> <%= t("account.profile.heading") %></h2>
    <p><%= t("account.profile.lede") %></p>
  </div>

  <div class="panel__body">
    <%= form_with model: current_user, url: account_profile_path, method: :patch, html: { novalidate: true } do |f| %>
      <%= render "shared/form_errors", record: current_user %>

      <div class="field-grid">
        <div class="field">
          <span class="field__label"><%= t("account.profile.full_name_label") %></span>
          <div class="field-locked">
            <span><%= current_user.full_name %></span>
            <span class="field-locked__badge"><i class="bi bi-lock-fill"></i> <%= t("account.profile.full_name_locked") %></span>
          </div>
        </div>

        <div class="field">
          <span class="field__label"><%= t("account.profile.cpf_label") %></span>
          <div class="field-locked">
            <span><%= format_cpf(current_user.cpf) %></span>
            <span class="field-locked__badge"><i class="bi bi-lock-fill"></i> <%= t("account.profile.cpf_locked") %></span>
          </div>
        </div>

        <div class="field">
          <%= f.label :email, t("account.profile.email_label"), class: "field__label" %>
          <%= f.email_field :email, autocomplete: "email", class: "field__input", required: true %>
          <% if current_user.unconfirmed_email.present? %>
            <span class="field__hint">
              <%= t("account.profile.email_pending_html", email: current_user.unconfirmed_email).html_safe %>
            </span>
          <% else %>
            <span class="field__hint"><%= t("account.profile.email_change_hint") %></span>
          <% end %>
        </div>

        <div class="field">
          <%= f.label :phone, t("account.profile.phone_label"), class: "field__label" %>
          <%= f.telephone_field :phone, autocomplete: "tel", class: "field__input", required: true, data: { "mask-phone": true } %>
        </div>
      </div>

      <div class="panel__actions">
        <%= f.submit t("account.profile.submit"), class: "button" %>
        <span class="panel__saved-note"><i class="bi bi-shield-check"></i> <%= t("account.profile.saved_note") %></span>
      </div>
    <% end %>
  </div>
</div>
