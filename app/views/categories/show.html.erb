<% content_for :title, "#{@label} — Prisma Games" %>

<div class="container">
  <header class="mb-4">
    <%= render "shared/breadcrumb",
          crumbs: [["Início", root_path], ["Catálogo", products_path]],
          current: @label %>
    <h1 class="h3 mb-1"><%= @label %></h1>
    <p class="text-muted small mb-0"><%= pluralize(@products.size, "produto") %> nesta categoria</p>
  </header>

  <% if @products.empty? %>
    <div class="alert alert-light border text-center py-5">
      <p class="mb-2">Sem produtos cadastrados nesta categoria por enquanto.</p>
      <%= link_to "Ver todos os jogos", products_path, class: "btn btn-outline-dark btn-sm" %>
    </div>
  <% else %>
    <div class="row">
      <% @products.each do |product| %>
        <%= render "products/card", product: product %>
      <% end %>
    </div>
  <% end %>
</div>
