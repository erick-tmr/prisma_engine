# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files but keep the documented example.
/.env*
!/.env.example

# Ignore SimpleCov coverage reports.
/coverage

# Ignore JS toolchain deps (Vitest); package-lock.json is committed.
/node_modules

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Seed-only binaries: read once to populate R2, never served from the repo. Kept locally, never committed.
/public/images/stores/uploads/
/public/images/emails/
/db/seeds/hero_banner.jpg
/db/seeds/correios_label_sample.pdf
/db/seeds/gotm/

# Ignore key files for decrypting credentials and more.
/config/*.key
/config/credentials/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Playwright MCP session files and ad-hoc screenshots
/.playwright-mcp/
/*.png

# Ignore key files for decrypting credentials and more.
/config/credentials/*.key

# Kamal: commit .kamal/secrets (env references only); never local/real-value variants.
/.kamal/secrets*.local
